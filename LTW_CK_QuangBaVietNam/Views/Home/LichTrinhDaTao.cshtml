@using System
@using System.Linq
@using System.Collections.Generic
@using LTW_CK_QuangBaVietNam.Models
@model List<LTW_CK_QuangBaVietNam.Models.LichTrinh>

@{
    ViewBag.Title = "Lịch trình đã tạo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var list = Model ?? new List<LichTrinh>();

    var soDiaDiemMap = ViewBag.SoDiaDiemMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var tongChiPhiMap = ViewBag.TongChiPhiMap as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();

    var totalItineraries = list.Count;
    var totalPlaces = list.Sum(x => soDiaDiemMap.ContainsKey(x.MaLichTrinh) ? soDiaDiemMap[x.MaLichTrinh] : 0);
    decimal totalCost = list.Sum(x => tongChiPhiMap.ContainsKey(x.MaLichTrinh) ? tongChiPhiMap[x.MaLichTrinh] : 0m);
}

<div class="container py-4">

    <!-- HERO -->
    <div class="card border-0 text-white shadow-sm rounded-4 mb-4 overflow-hidden"
         style="background-image:url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=1600&q=80');
            background-size:cover; background-position:center; min-height: 200px;">
        <div class="card-body p-4"
             style="background: linear-gradient(to top, rgba(15,23,42,.80), rgba(15,23,42,.25));">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill"
                         style="background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22);">
                        <i class="bi bi-compass"></i>
                        <span class="small fw-semibold">Kế hoạch du lịch của bạn</span>
                    </div>

                    <h3 class="mt-3 mb-1 fw-bold">Lịch trình đã tạo</h3>
                    <div style="color: rgba(255,255,255,.80);">
                        Quản lý các hành trình bạn đã tạo, xem nhanh chi phí và số địa điểm.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a class="btn btn-outline-light" href="@Url.Action("Profile","Home")">
                        <i class="bi bi-arrow-left me-2"></i>Về hồ sơ
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Tổng lịch trình</div>
                            <div class="fs-3 fw-bold">@totalItineraries</div>
                        </div>
                        <div class="rounded-4 d-flex align-items-center justify-content-center"
                             style="width:46px;height:46px;background:#e0f2fe;">
                            <i class="bi bi-calendar2-week text-primary fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Tổng địa điểm</div>
                            <div class="fs-3 fw-bold">@totalPlaces</div>
                        </div>
                        <div class="rounded-4 d-flex align-items-center justify-content-center"
                             style="width:46px;height:46px;background:#e0f2fe;">
                            <i class="bi bi-geo-alt text-primary fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Tổng chi phí dự kiến</div>
                            <div class="fs-3 fw-bold text-success">@String.Format("{0:N0}", totalCost) đ</div>
                        </div>
                        <div class="rounded-4 d-flex align-items-center justify-content-center"
                             style="width:46px;height:46px;background:#dcfce7;">
                            <i class="bi bi-cash-coin text-success fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOOLS -->
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input id="txtSearch" class="form-control"
                               placeholder="Tìm theo tên lịch trình..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <span class="text-muted small">
                        Hiển thị: <b id="countShow">@totalItineraries</b> / @totalItineraries
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- LIST -->
    @if (!list.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5 text-muted">
                <div class="mb-2"><i class="bi bi-calendar2-x fs-1"></i></div>
                <div class="fw-semibold">Chưa có lịch trình nào</div>
                <div class="small">Bạn có thể tạo lịch trình mới ở tính năng lập kế hoạch du lịch.</div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3" id="itGrid">
            @foreach (var lt in list)
            {
                var name = (lt.TenLichTrinh ?? "").ToLowerInvariant();

                var soDD = soDiaDiemMap.ContainsKey(lt.MaLichTrinh) ? soDiaDiemMap[lt.MaLichTrinh] : 0;
                var chiPhi = tongChiPhiMap.ContainsKey(lt.MaLichTrinh) ? tongChiPhiMap[lt.MaLichTrinh] : 0m;

                var ngayTaoText = (lt.NgayTao.HasValue ? lt.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "—");

                <div class="col-12 col-md-6 col-xl-4 it-item" data-name="@name">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div class="me-2">
                                    <div class="fw-bold fs-5">@lt.TenLichTrinh</div>
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-clock me-1"></i>
                                        Tạo lúc: @ngayTaoText
                                    </div>
                                </div>

                                <span class="badge rounded-pill bg-light text-primary border">
                                    <i class="bi bi-geo-alt me-1"></i>@soDD địa điểm
                                </span>
                            </div>

                            <hr class="my-3" />

                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-muted small">Chi phí dự kiến</div>
                                <div class="fw-bold text-success">
                                    @String.Format("{0:N0}", chiPhi) đ
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <a class="btn btn-primary btn-sm"
                                   href="@Url.Action("ChiTietLichTrinh","Home", new { id = lt.MaLichTrinh })">
                                    <i class="bi bi-eye me-2"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    (function () {
        var input = document.getElementById('txtSearch');
        var countShow = document.getElementById('countShow');

        if (!input) return;

        function normalize(s) {
            if (!s) return '';
            return ('' + s).toLowerCase();
        }

        function filter() {
            var q = normalize(input.value);
            var items = document.querySelectorAll('.it-item');
            var show = 0;

            for (var i = 0; i < items.length; i++) {
                var el = items[i];
                var name = el.getAttribute('data-name') || '';
                var ok = (q === '' || name.indexOf(q) >= 0);

                el.style.display = ok ? '' : 'none';
                if (ok) show++;
            }

            if (countShow) countShow.textContent = show;
        }

        input.addEventListener('input', filter);
        filter();
    })();
</script>