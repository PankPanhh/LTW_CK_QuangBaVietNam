@{
    ViewBag.Title = "Ẩm Thực Việt Nam – Hương Vị Ngàn Năm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ===== ẨM THỰC – VIBRANT MODERN ===== */
    :root {
        --at-dark:   #0d0907;
        --at-brown:  #1c1109;
        --at-orange: #ea580c;
        --at-amber:  #f59e0b;
        --at-red:    #dc2626;
        --at-cream:  #fef9f0;
        --at-teal:   #0EA5E9;
        --radius-card: 22px;
        --shadow-card: 0 8px 48px rgba(0,0,0,0.35);
        --transition: all 0.42s cubic-bezier(0.4,0,0.2,1);
    }

    .at-page { background: var(--at-dark); color: #f8fafc; overflow-x: hidden; }

    /* ===== HERO ===== */
    .at-hero {
        position: relative; height: 100vh; min-height: 680px;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
    }
    .at-hero-bg {
        position: absolute; inset: 0;
        background: url('https://images.unsplash.com/photo-1559847844-5315695dadae?w=1920&q=85') center/cover no-repeat;
        animation: heroZoom 18s ease-in-out infinite alternate;
    }
    @@keyframes heroZoom { from{transform:scale(1.05)} to{transform:scale(1.12)} }
    .at-hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(160deg,
            rgba(13,9,7,0.82) 0%,
            rgba(28,17,9,0.65) 50%,
            rgba(234,88,12,0.18) 100%);
    }
    .at-hero-content {
        position: relative; z-index: 2;
        text-align: center; padding: 0 1.5rem; max-width: 860px;
    }
    .at-hero-badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: rgba(234,88,12,0.2);
        border: 1px solid rgba(234,88,12,0.5);
        backdrop-filter: blur(12px);
        border-radius: 999px; padding: 0.45rem 1.25rem;
        font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em;
        text-transform: uppercase; color: #fb923c;
        margin-bottom: 1.5rem;
        animation: fadeUp 0.8s 0.2s both;
    }
    .at-hero-title {
        font-size: clamp(2.6rem, 6.5vw, 5.2rem);
        font-weight: 900; line-height: 1.08;
        color: #fff; margin-bottom: 1.25rem;
        animation: fadeUp 0.8s 0.4s both;
    }
    .at-hero-title em {
        font-style: italic;
        background: linear-gradient(90deg, #fb923c, #f59e0b);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .at-hero-sub {
        font-size: clamp(1rem, 2vw, 1.2rem);
        color: rgba(254,249,240,0.78);
        max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.75;
        animation: fadeUp 0.8s 0.6s both;
    }
    .at-hero-cta {
        display: inline-flex; align-items: center; gap: 0.6rem;
        background: linear-gradient(135deg, #ea580c, #f59e0b);
        color: #fff; font-weight: 800; font-size: 1rem;
        padding: 0.9rem 2.2rem; border-radius: 999px;
        text-decoration: none;
        box-shadow: 0 6px 32px rgba(234,88,12,0.45);
        transition: var(--transition);
        animation: fadeUp 0.8s 0.8s both;
    }
    .at-hero-cta:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 42px rgba(234,88,12,0.6);
        color: #fff;
    }
    .at-hero-scroll {
        position: absolute; bottom: 2.2rem; left: 50%;
        transform: translateX(-50%); z-index: 3;
        display: flex; flex-direction: column; align-items: center;
        gap: 0.5rem; color: rgba(255,255,255,0.5); font-size: 0.75rem;
        animation: bounce 2.4s infinite;
    }
    .at-hero-scroll span { display:block; width:1px; height:48px;
        background: linear-gradient(to bottom, rgba(234,88,12,0.8), transparent); }
    @@keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(8px)} }

    /* ===== SECTION COMMON ===== */
    .at-section { padding: 7rem 0; }
    .at-section-label {
        font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em;
        text-transform: uppercase; color: #fb923c; margin-bottom: 0.6rem;
    }
    .at-section-title {
        font-size: clamp(1.8rem, 4vw, 2.9rem);
        font-weight: 800; line-height: 1.15; color: #fff; margin-bottom: 1rem;
    }
    .at-section-desc {
        color: rgba(203,213,225,0.8);
        font-size: 1.05rem; line-height: 1.75; max-width: 600px;
    }

    /* ===== FOOD MASONRY GRID ===== */
    .at-foods { background: linear-gradient(180deg, #0d0907, #130b05); }
    .at-masonry {
        columns: 3;
        column-gap: 1.25rem;
    }
    @@media(max-width:992px){ .at-masonry { columns: 2; } }
    @@media(max-width:576px){ .at-masonry { columns: 1; } }
    .at-food-card {
        break-inside: avoid;
        margin-bottom: 1.25rem;
        border-radius: var(--radius-card);
        overflow: hidden;
        position: relative;
        cursor: pointer;
        box-shadow: var(--shadow-card);
        transition: var(--transition);
    }
    .at-food-card:hover { transform: translateY(-6px) scale(1.01); box-shadow: 0 20px 60px rgba(0,0,0,0.45); }
    .at-food-card img {
        width: 100%; display: block;
        transition: transform 0.65s ease;
    }
    .at-food-card:hover img { transform: scale(1.08); }
    .at-food-card-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(13,9,7,0.92) 0%, rgba(13,9,7,0.1) 55%, transparent 100%);
    }
    .at-food-info {
        position: absolute; bottom: 0; left: 0; right: 0; padding: 1.4rem;
    }
    .at-food-info h4 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 0.2rem; }
    .at-food-info .origin { font-size: 0.77rem; color: #fb923c; font-weight: 600; }
    .at-food-quick {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%) scale(0.85);
        background: rgba(234,88,12,0.9); backdrop-filter: blur(8px);
        border-radius: 999px; padding: 0.55rem 1.2rem;
        font-size: 0.82rem; font-weight: 700; color: #fff;
        opacity: 0; transition: var(--transition); white-space: nowrap;
    }
    .at-food-card:hover .at-food-quick { opacity: 1; transform: translate(-50%,-50%) scale(1); }

    /* ===== REGIONAL SPECIALTIES ===== */
    .at-regions { background: linear-gradient(180deg, #130b05, #0d0907); }
    .at-region-blocks {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1.5rem;
    }
    @@media(max-width:992px){ .at-region-blocks { grid-template-columns: 1fr; } }
    .at-region-block {
        border-radius: var(--radius-card);
        overflow: hidden;
        position: relative;
        min-height: 380px;
        cursor: pointer;
        transition: var(--transition);
        box-shadow: var(--shadow-card);
    }
    .at-region-block:hover { transform: translateY(-6px); box-shadow: 0 24px 64px rgba(0,0,0,0.45); }
    .at-region-block img {
        width: 100%; height: 100%; object-fit: cover;
        position: absolute; inset: 0;
        transition: transform 0.7s ease;
    }
    .at-region-block:hover img { transform: scale(1.08); }
    .at-region-block-overlay {
        position: absolute; inset: 0;
        transition: var(--transition);
    }
    .at-rb-north .at-region-block-overlay {
        background: linear-gradient(135deg, rgba(13,9,7,0.75), rgba(220,38,38,0.3));
    }
    .at-rb-central .at-region-block-overlay {
        background: linear-gradient(135deg, rgba(13,9,7,0.75), rgba(234,88,12,0.35));
    }
    .at-rb-south .at-region-block-overlay {
        background: linear-gradient(135deg, rgba(13,9,7,0.75), rgba(245,158,11,0.3));
    }
    .at-region-block:hover .at-region-block-overlay { opacity: 0.75; }
    .at-region-block-content {
        position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem;
    }
    .at-rb-label {
        font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.14em; margin-bottom: 0.5rem;
    }
    .at-rb-north .at-rb-label { color: #fca5a5; }
    .at-rb-central .at-rb-label { color: #fdba74; }
    .at-rb-south   .at-rb-label { color: #fcd34d; }
    .at-region-block-content h3 { font-size: 1.5rem; font-weight: 800; color: #fff; margin-bottom: 0.75rem; }
    .at-region-block-content p { font-size: 0.88rem; color: rgba(254,249,240,0.78); line-height: 1.6; margin-bottom: 1rem; }
    .at-rb-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .at-rb-chip {
        background: rgba(255,255,255,0.12); backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 999px; padding: 0.2rem 0.75rem;
        font-size: 0.75rem; font-weight: 600; color: #fff;
    }

    /* ===== HOT DISHES STRIP ===== */
    .at-strip {
        background: linear-gradient(90deg, #130b05, #1c1109, #130b05);
        border-top: 1px solid rgba(234,88,12,0.18);
        border-bottom: 1px solid rgba(234,88,12,0.18);
        padding: 2rem 0; overflow: hidden;
    }
    .at-strip-inner {
        display: flex; gap: 2rem; align-items: center;
        animation: scrollStrip 28s linear infinite;
        white-space: nowrap;
    }
    @@keyframes scrollStrip { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    .at-strip-item {
        display: inline-flex; align-items: center; gap: 0.5rem;
        font-size: 0.9rem; font-weight: 600; color: rgba(203,213,225,0.75);
        flex-shrink: 0;
    }
    .at-strip-item i { color: #fb923c; }
    .at-strip-dot { color: rgba(234,88,12,0.4); font-size: 1.5rem; line-height: 1; flex-shrink: 0; }

    /* ===== CTA BANNER ===== */
    .at-banner {
        position: relative; padding: 8rem 0; overflow: hidden;
        background: url('https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=1920&q=80') center/cover;
    }
    .at-banner::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(13,9,7,0.9), rgba(234,88,12,0.25));
    }
    .at-banner-content { position: relative; z-index: 1; }
    .at-btn-outline {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: transparent;
        border: 1.5px solid rgba(234,88,12,0.55);
        color: #fb923c; font-weight: 700; font-size: 1rem;
        padding: 0.9rem 2.2rem; border-radius: 999px;
        text-decoration: none; transition: var(--transition); cursor: pointer;
    }
    .at-btn-outline:hover {
        background: #ea580c; border-color: #ea580c;
        color: #fff; transform: translateX(4px);
    }

    @@keyframes fadeUp { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
    .fade-up { opacity:0; transform:translateY(35px); transition:opacity 0.7s ease, transform 0.7s ease; }
    .fade-up.visible { opacity:1; transform:translateY(0); }
</style>

<div class="at-page">

    <!-- ===== HERO ===== -->
    <section class="at-hero">
        <div class="at-hero-bg"></div>
        <div class="at-hero-overlay"></div>
        <div class="at-hero-content">
            <div class="at-hero-badge">
                <i class="bi bi-egg-fried"></i> Ẩm Thực Việt Nam
            </div>
            <h1 class="at-hero-title">
                <em>Hương vị</em> Việt Nam<br>trên từng nếp gạo
            </h1>
            <p class="at-hero-sub">
                Từ bát phở bốc khói sáng sớm Hà Nội, tô bún bò Huế cay nồng đến hũ hủ tiếu Nam Vang đậm đà — ẩm thực Việt là bức tranh đa sắc màu của văn hóa và con người.
            </p>
            <a href="#am-thuc-grid" class="at-hero-cta">
                <i class="bi bi-grid-3x3-gap-fill"></i> Khám phá món ngon
            </a>
        </div>
        <div class="at-hero-scroll">
            <span></span>
            Cuộn xuống
        </div>
    </section>

    <!-- ===== SCROLLING STRIP ===== -->
    <div class="at-strip">
        <div class="at-strip-inner">
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Phở Hà Nội</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Bún bò Huế</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Bánh mì Sài Gòn</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Cao lầu Hội An</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Cơm tấm</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Bánh cuốn</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Nem rán</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Gỏi cuốn</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Hủ tiếu Nam Vang</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Chả cá Lã Vọng</span>
            <!-- repeat for seamless -->
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Phở Hà Nội</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Bún bò Huế</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Bánh mì Sài Gòn</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Cao lầu Hội An</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Cơm tấm</span>
            <span class="at-strip-dot">·</span>
            <span class="at-strip-item"><i class="bi bi-bowl-hot-fill"></i>Bánh cuốn</span>
        </div>
    </div>

    <!-- ===== MASONRY GRID ===== -->
    <section class="at-section at-foods" id="am-thuc-grid">
        <div class="container">
            <div class="text-center mb-5 fade-up">
                <div class="at-section-label">Danh sách món ngon</div>
                <h2 class="at-section-title">Tinh hoa ẩm thực Việt</h2>
                <p class="at-section-desc mx-auto">Mỗi món ăn mang theo câu chuyện của vùng đất, con người và ký ức của hàng thế hệ.</p>
            </div>
            <div class="at-masonry fade-up">
                <div class="at-food-card">
                    <img src="https://images.unsplash.com/photo-1555126634-323283e090fa?w=600&q=80" alt="Phở Hà Nội" style="height:260px;object-fit:cover">
                    <div class="at-food-card-overlay"></div>
                    <div class="at-food-info">
                        <h4>Phở Hà Nội</h4>
                        <span class="origin"><i class="bi bi-geo-alt-fill me-1"></i>Miền Bắc</span>
                    </div>
                    <div class="at-food-quick"><i class="bi bi-eye me-1"></i>Xem chi tiết</div>
                </div>
                <div class="at-food-card">
                    <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&q=80" alt="Bún bò Huế" style="height:340px;object-fit:cover">
                    <div class="at-food-card-overlay"></div>
                    <div class="at-food-info">
                        <h4>Bún bò Huế</h4>
                        <span class="origin"><i class="bi bi-geo-alt-fill me-1"></i>Miền Trung</span>
                    </div>
                    <div class="at-food-quick"><i class="bi bi-eye me-1"></i>Xem chi tiết</div>
                </div>
                <div class="at-food-card">
                    <img src="https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=600&q=80" alt="Cơm tấm" style="height:280px;object-fit:cover">
                    <div class="at-food-card-overlay"></div>
                    <div class="at-food-info">
                        <h4>Cơm tấm Sài Gòn</h4>
                        <span class="origin"><i class="bi bi-geo-alt-fill me-1"></i>Miền Nam</span>
                    </div>
                    <div class="at-food-quick"><i class="bi bi-eye me-1"></i>Xem chi tiết</div>
                </div>
                <div class="at-food-card">
                    <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?w=600&q=80" alt="Gỏi cuốn" style="height:300px;object-fit:cover">
                    <div class="at-food-card-overlay"></div>
                    <div class="at-food-info">
                        <h4>Gỏi cuốn</h4>
                        <span class="origin"><i class="bi bi-geo-alt-fill me-1"></i>Toàn quốc</span>
                    </div>
                    <div class="at-food-quick"><i class="bi bi-eye me-1"></i>Xem chi tiết</div>
                </div>
                <div class="at-food-card">
                    <img src="https://images.unsplash.com/photo-1563245372-f21724e3856d?w=600&q=80" alt="Bánh mì" style="height:240px;object-fit:cover">
                    <div class="at-food-card-overlay"></div>
                    <div class="at-food-info">
                        <h4>Bánh mì Việt Nam</h4>
                        <span class="origin"><i class="bi bi-geo-alt-fill me-1"></i>Miền Nam</span>
                    </div>
                    <div class="at-food-quick"><i class="bi bi-eye me-1"></i>Xem chi tiết</div>
                </div>
                <div class="at-food-card">
                    <img src="https://images.unsplash.com/photo-1569050467447-ce54b3bbc37d?w=600&q=80" alt="Chả cá" style="height:320px;object-fit:cover">
                    <div class="at-food-card-overlay"></div>
                    <div class="at-food-info">
                        <h4>Chả cá Lã Vọng</h4>
                        <span class="origin"><i class="bi bi-geo-alt-fill me-1"></i>Hà Nội</span>
                    </div>
                    <div class="at-food-quick"><i class="bi bi-eye me-1"></i>Xem chi tiết</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== ĐẶC SẢN VÙNG MIỀN ===== -->
    <section class="at-section at-regions">
        <div class="container">
            <div class="text-center mb-5 fade-up">
                <div class="at-section-label">Đặc sản vùng miền</div>
                <h2 class="at-section-title">Ba miền – Ba bản sắc ẩm thực</h2>
                <p class="at-section-desc mx-auto">Mỗi vùng miền có một bản sắc ẩm thực riêng, phản ánh khí hậu, thổ nhưỡng và lịch sử của vùng đất đó.</p>
            </div>
            <div class="at-region-blocks">
                <!-- Miền Bắc -->
                <div class="at-region-block at-rb-north fade-up">
                    <img src="https://images.unsplash.com/photo-1555126634-323283e090fa?w=800&q=80" alt="Ẩm thực Miền Bắc">
                    <div class="at-region-block-overlay"></div>
                    <div class="at-region-block-content">
                        <div class="at-rb-label">Miền Bắc</div>
                        <h3>Tinh tế & thanh đạm</h3>
                        <p>Ẩm thực miền Bắc nổi tiếng với sự thanh thoát, ít gia vị, hương vị nhẹ nhàng mà tinh tế. Phở, bún thang, chả cá là biểu tượng.</p>
                        <div class="at-rb-chips">
                            <span class="at-rb-chip">Phở Hà Nội</span>
                            <span class="at-rb-chip">Bún thang</span>
                            <span class="at-rb-chip">Bánh cuốn</span>
                            <span class="at-rb-chip">Chả cá</span>
                        </div>
                    </div>
                </div>
                <!-- Miền Trung -->
                <div class="at-region-block at-rb-central fade-up">
                    <img src="https://images.unsplash.com/photo-1593253416516-3b96f2a94dd1?w=800&q=80" alt="Ẩm thực Miền Trung">
                    <div class="at-region-block-overlay"></div>
                    <div class="at-region-block-content">
                        <div class="at-rb-label">Miền Trung</div>
                        <h3>Cay nồng & đậm đà</h3>
                        <p>Ẩm thực miền Trung nổi tiếng với độ cay, màu sắc bắt mắt và hương vị đậm đà. Bún bò Huế, bánh xèo, mì Quảng là những đặc trưng.</p>
                        <div class="at-rb-chips">
                            <span class="at-rb-chip">Bún bò Huế</span>
                            <span class="at-rb-chip">Cao lầu</span>
                            <span class="at-rb-chip">Mì Quảng</span>
                            <span class="at-rb-chip">Bánh xèo</span>
                        </div>
                    </div>
                </div>
                <!-- Miền Nam -->
                <div class="at-region-block at-rb-south fade-up">
                    <img src="https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=800&q=80" alt="Ẩm thực Miền Nam">
                    <div class="at-region-block-overlay"></div>
                    <div class="at-region-block-content">
