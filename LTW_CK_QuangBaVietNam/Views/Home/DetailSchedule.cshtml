                            <div class="location-card-content">
                                <h3 class="location-card-name">Phố cổ Hội An</h3>
                                <p class="location-card-region"><i class="bi bi-geo-alt"></i> Quảng Nam</p>
                                <p class="location-card-time"><i class="bi bi-clock"></i> 13:00 - 18:00</p>
                                <div class="location-card-actions">
                                    <button class="location-card-btn" onclick="viewLocation(3)">
                                        <i class="bi bi-arrow-up-right"></i> Xem địa điểm
                                    </button>
                                    <button class="location-card-btn primary" onclick="addToMySchedule(3)">
                                        <i class="bi bi-plus"></i> Thêm vào
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Day 2 -->
                <div class="timeline-day">
                    <div class="timeline-day-header">
                        <h2 class="timeline-day-title">Ngày 2 – Vịnh Hạ Long</h2>
                        <p class="timeline-day-meta"><i class="bi bi-calendar3"></i> Thứ Ba, 16/12/2024</p>
                    </div>
                    <div class="timeline-locations">
                        <div class="location-card">
                            <img src="https://images.unsplash.com/photo-1528127269322-539801943592?w=120&h=120&fit=crop" alt="Hạ Long" class="location-card-image">
                            <div class="location-card-content">
                                <h3 class="location-card-name">Vịnh Hạ Long</h3>
                                <p class="location-card-region"><i class="bi bi-geo-alt"></i> Quảng Ninh</p>
                                <p class="location-card-time"><i class="bi bi-clock"></i> 08:00 - 18:00</p>
                                <div class="location-card-actions">
                                    <button class="location-card-btn" onclick="viewLocation(1)">
                                        <i class="bi bi-arrow-up-right"></i> Xem địa điểm
                                    </button>
                                    <button class="location-card-btn primary" onclick="addToMySchedule(1)">
                                        <i class="bi bi-plus"></i> Thêm vào
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Day 3 -->
                <div class="timeline-day">
                    <div class="timeline-day-header">
                        <h2 class="timeline-day-title">Ngày 3 – Về Hà Nội</h2>
                        <p class="timeline-day-meta"><i class="bi bi-calendar3"></i> Thứ Tư, 17/12/2024</p>
                    </div>
                    <div class="timeline-locations">
                        <div class="location-card">
                            <img src="https://images.unsplash.com/photo-1590969033100-9f60a05a9d82?w=120&h=120&fit=crop" alt="Cao Bằng" class="location-card-image">
                            <div class="location-card-content">
                                <h3 class="location-card-name">Đảo Tuần Châu</h3>
                                <p class="location-card-region"><i class="bi bi-geo-alt"></i> Quảng Ninh</p>
                                <p class="location-card-time"><i class="bi bi-clock"></i> 09:00 - 12:00</p>
                                <div class="location-card-actions">
                                    <button class="location-card-btn" onclick="viewLocation(5)">
                                        <i class="bi bi-arrow-up-right"></i> Xem địa điểm
                                    </button>
                                    <button class="location-card-btn primary" onclick="addToMySchedule(5)">
                                        <i class="bi bi-plus"></i> Thêm vào
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Sidebar -->
        <aside class="schedule-sidebar">
            <div class="sidebar-card">
                <h3 class="sidebar-card-title">
                    <i class="bi bi-bar-chart"></i>
                    Thống kê
                </h3>

                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="bi bi-calendar2-week"></i>
                    </div>
                    <div class="stat-content">
                        <h4>3</h4>
                        <p>Số ngày</p>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div class="stat-content">
                        <h4>4</h4>
                        <p>Địa điểm</p>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="bi bi-heart"></i>
                    </div>
                    <div class="stat-content">
                        <h4>234</h4>
                        <p>Yêu thích</p>
                    </div>
                </div>

                <button class="sidebar-btn" onclick="cloneSchedule()">
                    <i class="bi bi-files"></i> Tạo tương tự
                </button>
            </div>

            <div class="sidebar-card">
                <h3 class="sidebar-card-title">
                    <i class="bi bi-info-circle"></i>
                    Thông tin
                </h3>
                <p style="color: #94a3b8; margin: 0; font-size: 0.9375rem; line-height: 1.6;">
                    Hành trình khám phá vẻ đẹp thủ đô Hà Nội và kỳ quan thiên nhiên Hạ Long trong 3 ngày đầy đủ.
                </p>
            </div>
        </aside>
    </div>
</div>

<!-- Share Modal -->
<div class="share-modal" id="shareModal">
    <div class="share-modal-content">
        <div class="modal-close">
            <button onclick="closeShareModal()">×</button>
        </div>
        <div class="share-modal-header">Chia sẻ lịch trình</div>

        <div class="share-options">
            <a href="#" class="share-option" onclick="shareOn('facebook'); return false;">
                <i class="bi bi-facebook"></i>
                <span>Facebook</span>
            </a>
            <a href="#" class="share-option" onclick="shareOn('twitter'); return false;">
                <i class="bi bi-twitter"></i>
                <span>Twitter</span>
            </a>
            <a href="#" class="share-option" onclick="shareOn('email'); return false;">
                <i class="bi bi-envelope"></i>
                <span>Email</span>
            </a>
            <a href="#" class="share-option" onclick="shareOn('whatsapp'); return false;">
                <i class="bi bi-chat-left-text"></i>
                <span>WhatsApp</span>
            </a>
        </div>

        <div class="share-modal-divider">— hoặc —</div>

        <div class="share-link-box">
            <input type="text" id="shareLink" value="https://vietscape.vn/schedule/123" readonly>
            <button onclick="copyShareLink()">
                <i class="bi bi-files"></i> Sao chép
            </button>
        </div>
    </div>
</div>

<script>
    // Save Schedule
    function saveSchedule() {
        showToast('Lưu lịch trình', 'Lịch trình đã được lưu!', 'success');
    }

    // Toggle Favorite
    function toggleFavorite() {
        showToast('Yêu thích', 'Đã thêm vào danh sách yêu thích!', 'success');
    }

    // Back to Edit
    function backToEdit() {
        showToast('Chuyển hướng', 'Đang chuyển đến trang chỉnh sửa...', 'info');
        setTimeout(() => {
            window.location.href = '/Home/Createschedule?id=123&edit=1';
        }, 800);
    }

    // Toggle Preview
    function togglePreview() {
        showToast('Preview', 'Bạn đang ở chế độ xem trước!', 'info');
    }

    // View Location
    function viewLocation(locationId) {
        showToast('Chuyển hướng', 'Đang chuyển đến trang bản đồ...', 'info');
        setTimeout(() => {
            window.location.href = '/Home/Map#location-' + locationId;
        }, 800);
    }

    // Add to My Schedule
    function addToMySchedule(locationId) {
        showToast('Thêm vào', 'Địa điểm đã được thêm vào lịch trình!', 'success');
    }

    // Clone Schedule
    function cloneSchedule() {
        showToast('Tạo tương tự', 'Đang tạo bản sao lịch trình...', 'info');
        setTimeout(() => {
            window.location.href = '/Home/Createschedule?clone=123';
        }, 800);
    }

    // Open Share Modal
    function openShareModal() {
        document.getElementById('shareModal').classList.add('show');
    }

    // Close Share Modal
    function closeShareModal() {
        document.getElementById('shareModal').classList.remove('show');
    }

    // Share On Platform
    function shareOn(platform) {
        const url = document.getElementById('shareLink').value;
        const title = document.querySelector('.schedule-hero-title').innerText;

        let shareUrl = '';
        switch(platform) {
            case 'facebook':
                shareUrl = `https://facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
                break;
            case 'twitter':
                shareUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
                break;
            case 'email':
                shareUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
                break;
            case 'whatsapp':
                shareUrl = `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`;
                break;
        }

        if (shareUrl) {
            window.open(shareUrl, '_blank');
            showToast('Chia sẻ', `Đã chia sẻ trên ${platform}!`, 'success');
            closeShareModal();
        }
    }

    // Copy Share Link
    function copyShareLink() {
        const link = document.getElementById('shareLink');
        link.select();
        document.execCommand('copy');
        showToast('Sao chép', 'Đã sao chép liên kết!', 'success');
    }

    // Close modal on outside click
    document.getElementById('shareModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeShareModal();
        }
    });
</script>
