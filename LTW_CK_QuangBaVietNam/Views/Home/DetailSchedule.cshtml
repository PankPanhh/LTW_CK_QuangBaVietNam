@{
    ViewBag.Title = "Chi tiết lịch trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    :root {
        --deep-slate: #1e293b;
        --slate: #334155;
        --sky: #0EA5E9;
        --sky-l: #38BDF8;
        --slate-200: #e2e8f0;
        --amber: #f59e0b;
        --emerald: #10b981;
        --rose: #f43f5e;
        --white: #fff;
        --sp2: .5rem;
        --sp3: .75rem;
        --sp4: 1rem;
        --sp6: 1.5rem;
        --sp8: 2rem;
        --sp12: 3rem;
    }

    /* ── Hero ─────────────────────────────────────────── */
    .hero {
        position: relative;
        width: 100%;
        height: 480px;
        overflow: hidden;
        background: linear-gradient(135deg,#e0e7ff,#f3e8ff);
    }

    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .4s ease;
        display: block;
    }

    .hero:hover .hero-img {
        transform: scale(1.02);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top,rgba(30,41,59,.85),rgba(30,41,59,.35) 60%,transparent);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: var(--sp12);
    }

    .hero-title {
        font-size: 2.6rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        margin: 0 0 .6rem;
        text-shadow: 0 2px 8px rgba(0,0,0,.3);
    }

    .hero-meta {
        display: flex;
        align-items: center;
        gap: var(--sp6);
        color: rgba(255,255,255,.9);
        font-size: .95rem;
        flex-wrap: wrap;
        margin-bottom: var(--sp6);
    }

    .hero-meta-item {
        display: flex;
        align-items: center;
        gap: .3rem;
    }

        .hero-meta-item i {
            color: var(--sky-l);
        }

    .hero-actions {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .hbtn {
        padding: .55rem 1.1rem;
        border: 2px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.12);
        color: #fff;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: .88rem;
        transition: all .25s;
        display: flex;
        align-items: center;
        gap: .35rem;
        backdrop-filter: blur(10px);
    }

        .hbtn:hover {
            background: #fff;
            color: var(--deep-slate);
            border-color: #fff;
            transform: translateY(-2px);
        }

        .hbtn.active {
            background: var(--rose);
            border-color: var(--rose);
        }

        .hbtn.saved-btn.saved {
            background: var(--emerald);
            border-color: var(--emerald);
        }

        .hbtn#likeBtn.liked {
            background: var(--rose);
            border-color: var(--rose);
        }

    /* ── Sticky toolbar ──────────────────────────────── */
    .sbar {
        position: sticky;
        top: 80px;
        z-index: 100;
        background: #fff;
        border-bottom: 2px solid var(--slate-200);
        padding: .6rem 0;
        box-shadow: 0 2px 12px rgba(30,41,59,.07);
    }

    .sbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp4);
        flex-wrap: wrap;
        padding: 0 var(--sp6);
    }

    .sbar-left, .sbar-right {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .stbtn {
        display: flex;
        align-items: center;
        gap: .3rem;
        padding: .4rem .9rem;
        border: 1.5px solid var(--slate-200);
        background: transparent;
        border-radius: 7px;
        font-weight: 600;
        font-size: .82rem;
        color: var(--slate);
        cursor: pointer;
        transition: all .25s;
    }

        .stbtn:hover {
            border-color: var(--sky);
            color: var(--sky);
            background: rgba(14,165,233,.05);
        }

        .stbtn.prim {
            background: linear-gradient(135deg,var(--sky),var(--sky-l));
            color: #fff;
            border-color: var(--sky);
        }

            .stbtn.prim:hover {
                box-shadow: 0 4px 14px rgba(14,165,233,.3);
                transform: translateY(-1px);
            }

    .owner-only {
        display: none;
    }

    /* ── Layout ──────────────────────────────────────── */
    .page-wrap {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: var(--sp8);
        padding: var(--sp8) var(--sp6);
        max-width: 1400px;
        margin: 0 auto;
    }

    .main-col {
    }

    .side-col {
    }

    /* ── Timeline ────────────────────────────────────── */
    .tl {
        position: relative;
        padding-left: 2.8rem;
    }

        .tl::before {
            content: '';
            position: absolute;
            left: .7rem;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom,var(--sky),var(--sky-l));
            border-radius: 2px;
        }

    .tl-day {
        margin-bottom: var(--sp12);
        position: relative;
    }

        .tl-day::before {
            content: '';
            position: absolute;
            left: -2.2rem;
            top: .25rem;
            width: 22px;
            height: 22px;
            background: #fff;
            border: 3px solid var(--sky);
            border-radius: 50%;
            z-index: 5;
        }

    .tl-day-hd {
        margin-bottom: var(--sp6);
    }

    .tl-day-ttl {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin: 0 0 .2rem;
    }

    .tl-day-sub {
        font-size: .85rem;
        color: #94a3b8;
    }

    .tl-places {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    /* Place card */
    .lcard {
        background: #fff;
        border-radius: 12px;
        padding: var(--sp4);
        box-shadow: 0 2px 12px rgba(30,41,59,.07);
        display: flex;
        gap: var(--sp4);
        border: 2px solid transparent;
        transition: all .25s;
    }

        .lcard:hover {
            box-shadow: 0 4px 20px rgba(30,41,59,.12);
            border-color: rgba(14,165,233,.2);
            transform: translateY(-2px);
        }

    .lcard-img {
        width: 96px;
        height: 96px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        background: var(--slate-200);
    }

    .lcard-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: .25rem;
    }

    .lcard-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin: 0;
    }

    .lcard-addr {
        font-size: .8rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: .25rem;
    }

    .lcard-time {
        font-size: .8rem;
        color: var(--sky);
        font-weight: 600;
    }

    .lcard-note {
        font-size: .78rem;
        color: var(--slate);
        font-style: italic;
    }

    .lcard-acts {
        display: flex;
        gap: .4rem;
        margin-top: auto;
    }

    .lcbtn {
        flex: 1;
        padding: .3rem .5rem;
        border: 1px solid var(--slate-200);
        background: transparent;
        border-radius: 6px;
        cursor: pointer;
        font-size: .76rem;
        font-weight: 600;
        color: var(--slate);
        transition: all .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .25rem;
    }

        .lcbtn:hover {
            border-color: var(--sky);
            color: var(--sky);
            background: rgba(14,165,233,.05);
        }

        .lcbtn.prim {
            background: rgba(14,165,233,.1);
            border-color: var(--sky);
            color: var(--sky);
        }

    /* Transport connector */
    .tr-conn {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .3rem .5rem;
        color: var(--slate);
        font-size: .78rem;
        font-weight: 600;
    }

    .tr-icon {
        font-size: 1.1rem;
    }

    .tr-line {
        flex: 1;
        height: 1px;
        background: repeating-linear-gradient(90deg,var(--slate-200) 0,var(--slate-200) 6px,transparent 6px,transparent 12px);
    }

    .flight-badge {
        background: rgba(245,158,11,.12);
        color: var(--amber);
        font-size: .72rem;
        padding: .15rem .5rem;
        border-radius: 5px;
        font-weight: 700;
    }

    /* ── Sidebar ─────────────────────────────────────── */
    .side-map {
        width: 100%;
        height: 380px;
        border-radius: 14px;
        overflow: hidden;
        background: var(--slate-200);
        position: sticky;
        top: 160px;
    }

    .scard {
        background: #fff;
        border-radius: 14px;
        padding: var(--sp6);
        box-shadow: 0 2px 12px rgba(30,41,59,.08);
        margin-top: var(--sp6);
    }

    .scard-ttl {
        font-size: .9rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin: 0 0 var(--sp4);
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .scard-ttl i {
            color: var(--sky);
            font-size: 1.1rem;
        }

    .stat-row {
        display: flex;
        align-items: center;
        gap: var(--sp4);
        padding: .6rem 0;
        border-bottom: 1px solid var(--slate-200);
    }

        .stat-row:last-of-type {
            border-bottom: none;
        }

    .stat-ico {
        width: 42px;
        height: 42px;
        background: rgba(14,165,233,.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sky);
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .stat-val {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--deep-slate);
        line-height: 1;
    }

    .stat-lbl {
        font-size: .78rem;
        color: #94a3b8;
    }

    .sbtn {
        width: 100%;
        padding: .65rem;
        background: linear-gradient(135deg,var(--sky),var(--sky-l));
        color: #fff;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 700;
        font-size: .88rem;
        transition: all .25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin-top: var(--sp4);
    }

        .sbtn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 18px rgba(14,165,233,.3);
        }

    /* ── Share Modal ─────────────────────────────────── */
    .modal-bg {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(30,41,59,.65);
        backdrop-filter: blur(6px);
        z-index: 9000;
        align-items: center;
        justify-content: center;
    }

        .modal-bg.open {
            display: flex;
        }

    .mbox {
        background: #fff;
        border-radius: 18px;
        padding: var(--sp8);
        max-width: 420px;
        width: 90%;
        box-shadow: 0 24px 80px rgba(0,0,0,.28);
        animation: slideUp .35s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(28px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .mhead {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--sp6);
    }

        .mhead h3 {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--deep-slate);
        }

    .mclose {
        background: transparent;
        border: none;
        font-size: 1.7rem;
        color: var(--slate);
        cursor: pointer;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: .2s;
    }

        .mclose:hover {
            background: var(--slate-200);
        }

    .share-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: var(--sp4);
        margin-bottom: var(--sp6);
    }

    .share-opt {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .35rem;
        padding: var(--sp4);
        background: rgba(14,165,233,.05);
        border-radius: 10px;
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        color: var(--deep-slate);
        border: none;
    }

        .share-opt:hover {
            background: rgba(14,165,233,.14);
            transform: translateY(-2px);
        }

        .share-opt i {
            font-size: 1.6rem;
            color: var(--sky);
        }

        .share-opt span {
            font-weight: 600;
            font-size: .82rem;
        }

    .share-div {
        text-align: center;
        color: #94a3b8;
        font-size: .82rem;
        margin: .5rem 0;
    }

    .share-link-row {
        display: flex;
        gap: .4rem;
    }

        .share-link-row input {
            flex: 1;
            padding: .55rem .75rem;
            border: 1.5px solid var(--slate-200);
            border-radius: 8px;
            font-size: .82rem;
            color: var(--deep-slate);
        }

        .share-link-row button {
            padding: .55rem 1rem;
            background: var(--sky);
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: .82rem;
            transition: .2s;
        }

            .share-link-row button:hover {
                background: var(--sky-l);
            }

    /* Edit time modal */
    .ebox {
        max-width: 380px;
    }

    .einp {
        width: 100%;
        padding: .55rem .75rem;
        border: 1.5px solid var(--slate-200);
        border-radius: 8px;
        font-size: .9rem;
        margin-top: .35rem;
        color: var(--deep-slate);
    }

        .einp:focus {
            outline: none;
            border-color: var(--sky);
        }

    .erow {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .5rem;
        margin-bottom: .75rem;
    }

    .elbl {
        font-size: .82rem;
        font-weight: 600;
        color: var(--deep-slate);
    }

    .mfoot {
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
        margin-top: var(--sp6);
    }

    .mbtn {
        padding: .5rem 1.2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: .88rem;
        cursor: pointer;
        border: none;
        transition: .25s;
    }

        .mbtn.prim {
            background: linear-gradient(135deg,var(--sky),var(--sky-l));
            color: #fff;
        }

            .mbtn.prim:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 14px rgba(14,165,233,.3);
            }

        .mbtn.sec {
            background: var(--slate-200);
            color: var(--slate);
        }

            .mbtn.sec:hover {
                background: var(--slate);
                color: #fff;
            }

    /* Toast */
    .toast-wrap {
        position: fixed;
        top: 76px;
        right: 1.2rem;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .toast {
        background: #fff;
        border-radius: 10px;
        padding: .7rem 1rem;
        box-shadow: 0 6px 28px rgba(30,41,59,.18);
        display: flex;
        align-items: center;
        gap: .55rem;
        min-width: 260px;
        animation: slideInR .3s ease-out;
        border-left: 4px solid var(--sky);
    }

        .toast.ok {
            border-left-color: var(--emerald);
        }

        .toast.err {
            border-left-color: #ef4444;
        }

        .toast.warn {
            border-left-color: var(--amber);
        }

    .toast-ico {
        font-size: 1.2rem;
    }

    .toast.ok .toast-ico {
        color: var(--emerald);
    }

    .toast.err .toast-ico {
        color: #ef4444;
    }

    .toast.warn .toast-ico {
        color: var(--amber);
    }

    .toast-b {
        flex: 1;
    }

    .toast-ttl {
        font-weight: 700;
        font-size: .85rem;
        color: var(--deep-slate);
    }

    .toast-msg {
        font-size: .78rem;
        color: var(--slate);
    }

    .toast-x {
        background: transparent;
        border: none;
        color: var(--slate);
        cursor: pointer;
        font-size: 1rem;
    }

    @@keyframes slideInR {
        from {
            opacity: 0;
            transform: translateX(80%)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes slideOutR {
        from {
            opacity: 1
        }

        to {
            opacity: 0;
            transform: translateX(80%)
        }
    }

    .spin {
        display: inline-block;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg)
        }
    }

    /* Loading skeleton */
    .skel {
        background: linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 50%,#f1f5f9 75%);
        background-size: 200%;
        animation: skel 1.4s infinite;
        border-radius: 8px;
    }

    @@keyframes skel {
        0% {
            background-position: 200%
        }

        100% {
            background-position: -200%
        }
    }

    @@media(max-width:1024px) {
        .page-wrap {
            grid-template-columns: 1fr
        }
    }

    @@media(max-width:768px) {
        .hero {
            height: 320px
        }

        .hero-overlay {
            padding: var(--sp6)
        }

        .hero-title {
            font-size: 1.6rem
        }

        .sbar-left, .sbar-right {
            width: 100%;
            justify-content: center
        }

        .lcard {
            flex-direction: column
        }

        .lcard-img {
            width: 100%;
            height: 160px
        }
    }
</style>

<!-- Toast -->
<div class="toast-wrap" id="toastWrap"></div>

<!-- Hero -->
<section class="hero" id="heroSection">
    <img id="heroImg" src="https://images.unsplash.com/photo-1528127269322-539801943592?w=1400&q=80" class="hero-img" alt="Cover" />
    <div class="hero-overlay">
        <div></div>
        <div>
            <h1 class="hero-title" id="heroTitle"><span class="skel" style="display:inline-block;width:320px;height:40px;">&nbsp;</span></h1>
            <div class="hero-meta">
                <div class="hero-meta-item"><i class="bi bi-calendar-event"></i><span id="heroDays">—</span></div>
                <div class="hero-meta-item"><i class="bi bi-geo-alt"></i><span id="heroRegion">—</span></div>
                <div class="hero-meta-item"><i class="bi bi-person-circle"></i><span id="heroAuthor">—</span></div>
                <div class="hero-meta-item"><i class="bi bi-heart-fill" style="color:var(--rose);"></i><span id="heroLikes">0</span> lượt thích</div>
            </div>
            <div class="hero-actions">
                <button class="hbtn" id="likeBtn" onclick="doLike()"><i class="bi bi-heart" id="likeIco"></i> <span id="likeTxt">Thích</span></button>
                <button class="hbtn" onclick="openShare()"><i class="bi bi-share"></i> Chia sẻ</button>
                <button class="hbtn owner-only" id="editBtn" onclick="goEdit()"><i class="bi bi-pencil-square"></i> Chỉnh sửa</button>
                <button class="hbtn owner-only" id="delBtn" onclick="doDelete()"><i class="bi bi-trash"></i> Xóa</button>
            </div>
        </div>
    </div>
</section>

<!-- Sticky toolbar -->
<div class="sbar">
    <div class="sbar-inner">
        <div class="sbar-left">
            <button class="stbtn" onclick="window.history.back()"><i class="bi bi-arrow-left"></i> Quay lại</button>
            <button class="stbtn owner-only" id="pubToggle" onclick="togglePublic()"><i class="bi bi-globe" id="pubIco"></i> <span id="pubTxt">Công khai</span></button>
        </div>
        <div class="sbar-right">
            <button class="stbtn" onclick="openShare()"><i class="bi bi-share"></i> Chia sẻ</button>
        </div>
    </div>
</div>

<!-- Main -->
<div class="page-wrap">
    <main class="main-col">
        <div class="tl" id="timeline">
            <div style="text-align:center;padding:3rem;">
                <i class="bi bi-hourglass-split spin" style="font-size:2rem;color:var(--sky);"></i>
                <p style="color:var(--slate);margin-top:.75rem;">Đang tải lịch trình...</p>
            </div>
        </div>
    </main>

    <aside class="side-col">
        

        <div class="scard">
            <h3 class="scard-ttl"><i class="bi bi-bar-chart"></i> Thống kê</h3>
            <div class="stat-row"><div class="stat-ico"><i class="bi bi-calendar2-week"></i></div><div><div class="stat-val" id="statDays">—</div><div class="stat-lbl">Số ngày</div></div></div>
            <div class="stat-row"><div class="stat-ico"><i class="bi bi-geo-alt"></i></div><div><div class="stat-val" id="statPlaces">—</div><div class="stat-lbl">Địa điểm</div></div></div>
            <div class="stat-row"><div class="stat-ico"><i class="bi bi-signpost-split"></i></div><div><div class="stat-val" id="statKm">—</div><div class="stat-lbl">Tổng km</div></div></div>
            <div class="stat-row"><div class="stat-ico"><i class="bi bi-heart"></i></div><div><div class="stat-val" id="statLikes">—</div><div class="stat-lbl">Lượt thích</div></div></div>
        </div>

        <div class="scard">
            <h3 class="scard-ttl"><i class="bi bi-info-circle"></i> Mô tả</h3>
            <p id="statDesc" style="color:#94a3b8;margin:0;font-size:.88rem;line-height:1.6;">Đang tải...</p>
        </div>
    </aside>
</div>

<!-- Share Modal -->
<div class="modal-bg" id="shareModal">
    <div class="mbox">
        <div class="mhead"><h3>Chia sẻ lịch trình</h3><button class="mclose" onclick="closeShare()">×</button></div>
        <div class="share-grid">
            <button class="share-opt" onclick="shareOn('facebook')"><i class="bi bi-facebook"></i><span>Facebook</span></button>
            <button class="share-opt" onclick="shareOn('twitter')"><i class="bi bi-twitter-x"></i><span>X / Twitter</span></button>
            <button class="share-opt" onclick="shareOn('whatsapp')"><i class="bi bi-whatsapp"></i><span>WhatsApp</span></button>
        </div>
        <div class="share-div">— hoặc —</div>
        <div class="share-link-row">
            <input type="text" id="shareLinkInp" readonly />
            <button onclick="copyLink()"><i class="bi bi-files"></i> Sao chép</button>
        </div>
    </div>
</div>

<!-- Edit Time Modal -->
<div class="modal-bg" id="editModal">
    <div class="mbox ebox">
        <div class="mhead"><h3>Chỉnh sửa thời gian</h3><button class="mclose" onclick="closeEdit()">×</button></div>
        <input type="hidden" id="editIdChiTiet" />
        <div class="erow">
            <div><div class="elbl">Giờ bắt đầu</div><input class="einp" id="editStart" type="time" /></div>
            <div><div class="elbl">Giờ kết thúc</div><input class="einp" id="editEnd" type="time" /></div>
        </div>
        <div><div class="elbl" style="margin-bottom:.3rem;">Ghi chú</div><textarea class="einp" id="editNote" style="min-height:70px;resize:vertical;"></textarea></div>
        <div class="mfoot">
            <button class="mbtn sec" onclick="closeEdit()">Hủy</button>
            <button class="mbtn prim" onclick="confirmEdit()">Lưu thay đổi</button>
        </div>
    </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════════════════
const SCHEDULE_ID = @ViewBag.ScheduleId;
let scheduleData = null;
let isOwner = false;
let isLiked = false;
let isSaved = false;
let mapObj = null;
let mapMarkers = [];
let mapPolylines = [];
let mapVisible = false;

// ═══════════════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
    const sid = SCHEDULE_ID || new URLSearchParams(location.search).get('id') || 0;
    if (!sid) { showError('Không tìm thấy ID lịch trình'); return; }
    loadDetail(sid);
    loadShareLink(sid);
    checkSavedAndLiked(sid);
});

function loadDetail(sid) {
    fetch(`/Itinerary/GetDetail?idLichTrinh=${sid}`)
        .then(r=>r.json()).then(d => {
            if (!d.success) { showError(d.message); return; }
            scheduleData = d.data;
            renderAll(d.data);
        }).catch(()=>showError('Lỗi kết nối server'));
}

function renderAll(data) {
    // Hero
    document.getElementById('heroTitle').textContent = data.tenLichTrinh;
    if (data.anhBia) document.getElementById('heroImg').src = data.anhBia;
    document.getElementById('heroDays').textContent = `${data.soNgay} ngày`;
    document.getElementById('heroRegion').textContent = data.khuVuc || collectRegions(data.days);
    document.getElementById('heroAuthor').textContent = `Tạo bởi: ${data.nguoiTao||'—'}`;
    document.getElementById('heroLikes').textContent = data.luotLike||0;
    document.getElementById('statDays').textContent = data.soNgay||0;
    document.getElementById('statLikes').textContent = data.luotLike||0;

    // Set initial like state
    isLiked = data.isLiked === true;
    document.getElementById('likeIco').className = isLiked ? 'bi bi-heart-fill' : 'bi bi-heart';
    document.getElementById('likeTxt').textContent = isLiked ? 'Đã thích' : 'Thích';
    document.getElementById('likeBtn').classList.toggle('liked', isLiked);
    document.getElementById('statDesc').textContent = data.moTa||'Chưa có mô tả';
    const totalPlaces = data.days.reduce((s,d)=>s+d.places.length,0);
    document.getElementById('statPlaces').textContent = totalPlaces;
    const totalKm = data.days.reduce((s,day)=>s+day.places.reduce((ss,p)=>ss+(p.distanceToNext||0),0),0);
    document.getElementById('statKm').textContent = Math.round(totalKm) + ' km';

    // Owner buttons
    isOwner = data.isOwner === true;
    if (isOwner) {
        document.querySelectorAll('.owner-only').forEach(el=>el.style.display='flex');
        updatePublicBtn(data.trangThai);
    }

    // Timeline
    renderTimeline(data.days);
    // Map (deferred until visible)
    initMapWhenReady(data.days);
}

function collectRegions(days) {
    // First try tenKhuVuc from day data
    const byDay = new Set();
    days.forEach(d => { if (d.tenKhuVuc) byDay.add(d.tenKhuVuc); });
    if (byDay.size > 0) return [...byDay].slice(0,3).join(', ');
    // Fallback: extract from places tinhThanh
    const rs = new Set();
    days.forEach(d=>d.places.forEach(p=>{ if(p.tinhThanh) rs.add(p.tinhThanh); }));
    return [...rs].slice(0,3).join(', ') || '—';
}

function renderTimeline(days) {
    const tl = document.getElementById('timeline');
    if (!days||!days.length) { tl.innerHTML='<p style="color:var(--slate);text-align:center;">Lịch trình chưa có địa điểm</p>'; return; }
    tl.innerHTML = days.map((day, idx) => {
        // Build "DAY 1 — Phú Quốc" or fallback to tieuDe
        const dayNum = day.thuTu || (idx + 1);
        const region = day.tenKhuVuc || extractRegionFromTitle(day.tieuDe);
        const dayLabel = `DAY ${dayNum}`;
        const regionBadge = region
            ? `<span style="font-size:.85rem;font-weight:500;color:rgba(255,255,255,.85);margin-left:.5rem;">— ${region}</span>`
            : '';
        return `
        <div class="tl-day">
            <div class="tl-day-hd">
                <h2 class="tl-day-ttl">${dayLabel}${regionBadge}</h2>
                <div class="tl-day-sub">${day.places.length} địa điểm${region ? ` · 📍 ${region}` : ''}</div>
            </div>
            <div class="tl-places">
                ${renderPlaces(day.places)}
            </div>
        </div>`;
    }).join('');
}

function extractRegionFromTitle(tieuDe) {
    if (!tieuDe || !tieuDe.includes(' — ')) return '';
    const parts = tieuDe.split(' — ');
    if (parts.length >= 2) {
        // Check if second part looks like a date (dd/MM) — if so skip
        const candidate = parts[1];
        if (/^\d{2}\/\d{2}$/.test(candidate)) return '';
        return candidate;
    }
    return '';
}

function findPlace(idChiTiet) {
    if (!scheduleData || !scheduleData.days) return null;
    for (const d of scheduleData.days) {
        const p = d.places.find(x => x.idChiTiet === idChiTiet);
        if (p) return p;
    }
    return null;
}

function renderPlaces(places) {
    if (!places.length) return '<p style="color:#94a3b8;font-style:italic;font-size:.88rem;">Chưa có địa điểm nào</p>';
    let html = '';
    places.forEach((p, idx) => {
        const fallback = 'https://images.unsplash.com/photo-1528127269322-539801943592?w=96&h=96&fit=crop';
        const editBtns = isOwner
            ? `<button class="lcbtn prim" onclick="openEdit(${p.idChiTiet})"><i class="bi bi-pencil"></i> Sửa giờ</button>
               <button class="lcbtn" style="color:#ef4444;border-color:#ef4444;" onclick="doDeletePlace(${p.idChiTiet})"><i class="bi bi-x"></i> Xóa</button>`
            : '';
        const escapedName = (p.tenDiaDiem || '').replace(/"/g, '&quot;');
        html += `
            <div class="lcard" id="lcard-${p.idChiTiet}">
                <img class="lcard-img" src="${p.anh||fallback}" onerror="this.src='${fallback}'" alt="${escapedName}" />
                <div class="lcard-body">
                    <h3 class="lcard-name">${p.tenDiaDiem || ''}</h3>
                    <div class="lcard-addr"><i class="bi bi-geo-alt-fill" style="font-size:.7rem;color:var(--sky);"></i> ${p.diaChi||p.tinhThanh||'Đang cập nhật'}</div>
                    <div class="lcard-time"><i class="bi bi-clock"></i> ${p.gioBatDau}${p.gioKetThuc ? ' → '+p.gioKetThuc : ''}</div>
                    ${p.ghiChu ? `<div class="lcard-note"><i class="bi bi-sticky"></i> ${p.ghiChu}</div>` : ''}
                    <div class="lcard-acts">
                        <button class="lcbtn" onclick="viewPlaceDetail(${p.maDiaDiem||0})"><i class="bi bi-arrow-up-right"></i> Chi tiết</button>
                        <button class="lcbtn" onclick="focusMap(${p.idChiTiet})"><i class="bi bi-map"></i> Bản đồ</button>
                        ${editBtns}
                    </div>
                </div>
            </div>
        `;
        // Transport connector to next
        if (idx < places.length - 1 && p.distanceToNext > 0) {
            const isFlight = p.transportLabel === 'Máy bay';
            html += `
                <div class="tr-conn">
                    <span class="tr-icon">${p.transportIcon||'🚗'}</span>
                    <span class="tr-line"></span>
                    <span>${p.transportLabel||''} · ${p.distanceToNext} km</span>
                    ${isFlight ? `<span class="flight-badge">✈️ ${p.airportInfo||''}</span>` : ''}
                </div>
            `;
        }
    });
    return html;
}

// ═══════════════════════════════════════════════════════════════
//  LIKE
// ═══════════════════════════════════════════════════════════════
function checkSavedAndLiked(sid) {
    // Try to get from GetDetail response — alternatively we rely on initial state
}

function doLike() {
    fetch('/Itinerary/ToggleLike', {
        method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:`idLichTrinh=${SCHEDULE_ID}`
    }).then(r=>r.json()).then(d => {
        if (!d.success) { toast('warn','',d.message||'Vui lòng đăng nhập'); return; }
        isLiked = d.isLiked;
        document.getElementById('likeIco').className = isLiked ? 'bi bi-heart-fill' : 'bi bi-heart';
        document.getElementById('likeTxt').textContent = isLiked ? 'Đã thích' : 'Thích';
        document.getElementById('likeBtn').classList.toggle('liked', isLiked);
        document.getElementById('heroLikes').textContent = d.likes;
        document.getElementById('statLikes').textContent = d.likes;
        toast('ok', isLiked ? '❤️ Đã thích' : 'Đã bỏ thích', '');
    });
}

// ═══════════════════════════════════════════════════════════════
//  SAVE
// ═══════════════════════════════════════════════════════════════
function doSave() {
    fetch('/Itinerary/ToggleSave', {
        method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:`idLichTrinh=${SCHEDULE_ID}`
    }).then(r=>r.json()).then(d => {
        if (!d.success) { toast('warn','',d.message||'Vui lòng đăng nhập'); return; }
        isSaved = d.isSaved;
        document.getElementById('saveTxt').textContent = isSaved ? 'Đã lưu' : 'Lưu';
        document.getElementById('saveBtn').classList.toggle('saved', isSaved);
        toast('ok', isSaved ? '🔖 Đã lưu vào bộ sưu tập' : 'Đã bỏ lưu', '');
    });
}

// ═══════════════════════════════════════════════════════════════
//  CLONE
// ═══════════════════════════════════════════════════════════════
function doClone() {
    showConfirmModal('Xác nhận nhân bản', 'Tạo bản sao lịch trình này vào tài khoản của bạn?', () => {
        fetch('/Itinerary/Clone', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:`idLichTrinh=${SCHEDULE_ID}`
        }).then(r=>r.json()).then(d => {
            if (!d.success) { toast('err','Lỗi',d.message); return; }
            toast('ok','Đã nhân bản!','Chuyển sang trang chỉnh sửa...');
            setTimeout(()=>window.location.href=`/Home/CreateSchedule?edit=${d.id}`, 1500);
        });
    });
}

// ═══════════════════════════════════════════════════════════════
//  TOGGLE PUBLIC (owner only)
// ═══════════════════════════════════════════════════════════════
function togglePublic() {
    const current = document.getElementById('pubTxt').textContent;
    const newStatus = current === 'Công khai' ? 'private' : 'public';
    fetch('/Itinerary/UpdateStatus', {
        method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:`idLichTrinh=${SCHEDULE_ID}&status=${newStatus}`
    }).then(r=>r.json()).then(d => {
        if (!d.success) { toast('err','Lỗi',d.message); return; }
        updatePublicBtn(newStatus);
        toast('ok',d.message,'');
    });
}
function updatePublicBtn(status) {
    const txt = document.getElementById('pubTxt');
    const ico = document.getElementById('pubIco');
    if (!txt||!ico) return;
    if (status==='public') { txt.textContent='Công khai'; ico.className='bi bi-globe'; }
    else { txt.textContent='Riêng tư'; ico.className='bi bi-lock-fill'; }
}

// ═══════════════════════════════════════════════════════════════
//  DELETE (owner only)
// ═══════════════════════════════════════════════════════════════
function doDelete() {
    showConfirmModal('Xóa lịch trình', 'Xóa lịch trình này? Hành động này không thể hoàn tác.', () => {
        fetch('/Itinerary/DeleteSchedule', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:`idLichTrinh=${SCHEDULE_ID}`
        }).then(r=>r.json()).then(d => {
            if (d.success) { toast('ok','Đã xóa',''); setTimeout(()=>window.location.href='/Home/Schedule',1400); }
            else toast('err','Lỗi',d.message);
        });
    }, true);
}

// ═══════════════════════════════════════════════════════════════
//  EDIT PLACE TIME (owner only)
// ═══════════════════════════════════════════════════════════════
function openEdit(idChiTiet) {
    const p = findPlace(idChiTiet);
    if (!p) return;
    document.getElementById('editIdChiTiet').value = idChiTiet;
    document.getElementById('editStart').value = p.gioBatDau||'';
    document.getElementById('editEnd').value = p.gioKetThuc||'';
    document.getElementById('editNote').value = p.ghiChu||'';
    document.getElementById('editModal').classList.add('open');
}
function closeEdit() { document.getElementById('editModal').classList.remove('open'); }
function confirmEdit() {
    const id = document.getElementById('editIdChiTiet').value;
    const start = document.getElementById('editStart').value;
    const end = document.getElementById('editEnd').value;
    const note = document.getElementById('editNote').value;
    if (!start) { toast('warn','','Vui lòng chọn giờ bắt đầu'); return; }
    fetch('/Itinerary/UpdatePlaceTime', {
        method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:`idChiTiet=${id}&gioBatDau=${start}&gioKetThuc=${end}&ghiChu=${encodeURIComponent(note)}`
    }).then(r=>r.json()).then(d => {
        if (!d.success) { toast('err','Lỗi',d.message); return; }
        closeEdit();
        toast('ok','Đã cập nhật','Tải lại để xem thay đổi');
        setTimeout(()=>loadDetail(SCHEDULE_ID), 1000);
    });
}

// ═══════════════════════════════════════════════════════════════
//  DELETE PLACE (owner only)
// ═══════════════════════════════════════════════════════════════
function doDeletePlace(idChiTiet) {
    showConfirmModal('Xóa địa điểm', 'Bạn có chắc chắn muốn xóa địa điểm này khỏi lịch trình?', () => {
        fetch('/Itinerary/DeletePlace', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:`idChiTiet=${idChiTiet}`
        }).then(r=>r.json()).then(d => {
            if (!d.success) { toast('err','Lỗi',d.message); return; }
            const el = document.getElementById(`lcard-${idChiTiet}`);
            if (el) el.style.animation = 'slideOutR .3s ease-out';
            setTimeout(()=>{ if(el) el.remove(); }, 280);
            toast('ok','Đã xóa địa điểm','');
            setTimeout(()=>loadDetail(SCHEDULE_ID), 500);
        });
    }, true);
}

// ═══════════════════════════════════════════════════════════════
//  OPTIMIZE (owner only)
// ═══════════════════════════════════════════════════════════════
function doOptimize() {
    if (!isOwner) return;
    if (!scheduleData?.days?.length) { toast('warn','','Chưa có dữ liệu'); return; }
    // Call optimize for each day
    let promise = Promise.resolve();
    scheduleData.days.forEach(day => {
        promise = promise.then(()=>
            fetch(`/Itinerary/OptimizeRoute?idNgay=${day.idNgay}`)
                .then(r=>r.json())
        );
    });
    promise.then(()=>{
        toast('ok','Đã tối ưu tuyến','Tải lại trang...');
        setTimeout(()=>loadDetail(SCHEDULE_ID),1200);
    });
}

// ═══════════════════════════════════════════════════════════════
//  GO EDIT
// ═══════════════════════════════════════════════════════════════
function goEdit() { window.location.href = `/Home/CreateSchedule?edit=${SCHEDULE_ID}`; }

// ═══════════════════════════════════════════════════════════════
//  VIEW PLACE DETAIL
// ═══════════════════════════════════════════════════════════════
function viewPlaceDetail(maDiaDiem) {
    if (maDiaDiem) window.location.href = `/Home/DetailPlace?id=${maDiaDiem}`;
}

// ═══════════════════════════════════════════════════════════════
//  SHARE
// ═══════════════════════════════════════════════════════════════
function loadShareLink(sid) {
    fetch(`/Itinerary/GetShareLink?idLichTrinh=${sid}`).then(r=>r.json()).then(d=>{
        if (d.success) document.getElementById('shareLinkInp').value = d.link;
    });
}
function openShare() { document.getElementById('shareModal').classList.add('open'); }
function closeShare() { document.getElementById('shareModal').classList.remove('open'); }
function shareOn(type) {
    const link = document.getElementById('shareLinkInp').value || location.href;
    if (type==='link') { navigator.clipboard.writeText(link).then(()=>toast('ok','Đã sao chép link','')); closeShare(); }
    else if (type==='facebook') window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(link)}`,'_blank','width=600,height=400');
    else if (type==='twitter') window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(link)}`,'_blank','width=600,height=400');
    else if (type==='whatsapp') window.open(`https://wa.me/?text=${encodeURIComponent(link)}`,'_blank');
}
function copyLink() { const inp = document.getElementById('shareLinkInp'); inp.select(); navigator.clipboard.writeText(inp.value).then(()=>toast('ok','Đã sao chép','')); }

// ═══════════════════════════════════════════════════════════════
//  MAP
// ═══════════════════════════════════════════════════════════════
function toggleMapMode() {
    mapVisible = !mapVisible;
    document.getElementById('mapToggleTxt').textContent = mapVisible ? 'Ẩn bản đồ' : 'Xem bản đồ';
    const gmap = document.getElementById('gmap');
    const ph = document.getElementById('gmapPlaceholder');
    if (mapVisible && scheduleData) {
        ph.style.display='none'; gmap.style.display='block';
        initMap();
    } else {
        ph.style.display='flex'; gmap.style.display='none';
    }
}

function focusMap(idChiTiet) {
    const p = findPlace(idChiTiet);
    if (!p || !p.maDiaDiem) return;
    window.location.href = `/Home/Map?placeId=${p.maDiaDiem}`;
}

function initMapWhenReady(days) {
    // Only init if google maps loaded
    if (typeof google !== 'undefined') { /* ready */ } else return;
}

function initMap() {
    if (!scheduleData) return;
    const el = document.getElementById('gmap');
    if (!window.google) { el.innerHTML='<div style="text-align:center;padding:3rem;color:var(--slate);">Cần tích hợp Google Maps API Key</div>'; return; }
    if (!mapObj) {
        mapObj = new google.maps.Map(el, {
            center:{lat:16.047079,lng:108.206230}, zoom:6,
            styles:[{featureType:'poi',stylers:[{visibility:'simplified'}]}]
        });
    }
    // Clear old
    mapMarkers.forEach(m=>m.setMap(null)); mapMarkers=[];
    mapPolylines.forEach(p=>{ if(p.setMap) p.setMap(null); else if(p.setDirections) p.setMap(null); }); mapPolylines=[];

    const allPlaces = [];
    scheduleData.days.forEach(day => day.places.filter(p=>p.viDo&&p.kinhDo).forEach(p=>allPlaces.push(p)));
    if (!allPlaces.length) return;

    const bounds = new google.maps.LatLngBounds();
    allPlaces.forEach((p,idx)=>{
        const pos = {lat:parseFloat(p.viDo),lng:parseFloat(p.kinhDo)};
        const marker = new google.maps.Marker({
            position:pos, map:mapObj,
            title:p.tenDiaDiem,
            label:{text:String(idx+1),color:'#fff',fontWeight:'bold',fontSize:'11px'},
            icon:{path:google.maps.SymbolPath.CIRCLE,scale:16,fillColor:'#0EA5E9',fillOpacity:1,strokeColor:'#fff',strokeWeight:2}
        });
        const iw = new google.maps.InfoWindow({ content:`<div style="max-width:200px;"><b>${p.tenDiaDiem}</b><br><span style="font-size:.8rem;color:#64748b;">${p.gioBatDau||''} ${p.gioKetThuc?'→ '+p.gioKetThuc:''}</span></div>` });
        marker.addListener('click',()=>iw.open(mapObj,marker));
        mapMarkers.push(marker); bounds.extend(pos);
    });

    // Routes
    for (let i=0; i<allPlaces.length-1; i++) {
        const a=allPlaces[i], b=allPlaces[i+1];
        if (!a.viDo||!b.viDo) continue;
        const dist = a.distanceToNext || 0;
        if (dist > 150 || a.transportLabel === 'Máy bay') {
            // Flight arc
            const path = [
                {lat:parseFloat(a.viDo),lng:parseFloat(a.kinhDo)},
                {lat:parseFloat(b.viDo),lng:parseFloat(b.kinhDo)}
            ];
            const arc = new google.maps.Polyline({
                path, geodesic:true,
                strokeColor:'#f59e0b', strokeOpacity:.75, strokeWeight:2,
                icons:[{icon:{path:google.maps.SymbolPath.FORWARD_OPEN_ARROW,scale:3,strokeColor:'#f59e0b'},offset:'50%'}]
            });
            arc.setMap(mapObj); mapPolylines.push(arc);
            const planeMk = new google.maps.Marker({
                position:{lat:(parseFloat(a.viDo)+parseFloat(b.viDo))/2,lng:(parseFloat(a.kinhDo)+parseFloat(b.kinhDo))/2},
                map:mapObj,
                icon:{path:google.maps.SymbolPath.CIRCLE,scale:0},
                label:{text:'✈',fontSize:'18px',color:'#f59e0b'},
                title:`Bay từ ${a.tenDiaDiem} → ${b.tenDiaDiem}`
            });
            mapMarkers.push(planeMk);
        } else {
            new google.maps.DirectionsService().route({
                origin:{lat:parseFloat(a.viDo),lng:parseFloat(a.kinhDo)},
                destination:{lat:parseFloat(b.viDo),lng:parseFloat(b.kinhDo)},
                travelMode:google.maps.TravelMode.DRIVING
            },(res,status)=>{
                if (status==='OK') {
                    const r = new google.maps.DirectionsRenderer({
                        map:mapObj, suppressMarkers:true,
                        polylineOptions:{strokeColor:'#0EA5E9',strokeWeight:3,strokeOpacity:.8}
                    });
                    r.setDirections(res); mapPolylines.push(r);
                }
            });
        }
    }
    mapObj.fitBounds(bounds);
}

// ═══════════════════════════════════════════════════════════════
//  TOAST
// ═══════════════════════════════════════════════════════════════
function toast(type, title, msg) {
    const c = document.getElementById('toastWrap');
    const id = 'toast-'+Date.now();
    const icons = {ok:'bi-check-circle-fill',err:'bi-x-circle-fill',warn:'bi-exclamation-triangle-fill'};
    const el = document.createElement('div');
    el.className=`toast ${type}`; el.id=id;
    el.innerHTML=`<i class="bi ${icons[type]||icons.ok} toast-ico"></i><div class="toast-b"><div class="toast-ttl">${title}</div>${msg?`<div class="toast-msg">${msg}</div>`:''}</div><button class="toast-x" onclick="rmToast('${id}')">×</button>`;
    c.appendChild(el);
    setTimeout(()=>rmToast(id),5000);
}
function rmToast(id) {
    const el=document.getElementById(id); if(!el) return;
    el.style.animation='slideOutR .28s ease-out'; setTimeout(()=>el.remove(),260);
}

// ═══════════════════════════════════════════════════════════════
//  ERROR
// ═══════════════════════════════════════════════════════════════
function showError(msg) {
    document.getElementById('heroTitle').textContent = 'Lỗi tải dữ liệu';
    document.getElementById('timeline').innerHTML = `<div style="text-align:center;padding:3rem;color:#ef4444;"><i class="bi bi-exclamation-circle" style="font-size:2rem;"></i><p style="margin-top:.75rem;">${msg}</p></div>`;
}

// Close modals on backdrop click
document.addEventListener('click', e => {
    if (e.target.classList.contains('modal-bg')) {
        document.querySelectorAll('.modal-bg.open').forEach(m=>m.classList.remove('open'));
    }
});
</script>
