@{
    ViewBag.Title = "Hà Nội - Hạ Long 3 ngày";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --deep-slate: #1e293b;
        --slate: #334155;
        --sky-blue: #0EA5E9;
        --sky-light: #38BDF8;
        --slate-light: #cbd5e1;
        --slate-200: #e2e8f0;
        --white: #ffffff;
        --spacing-2: 0.5rem;
        --spacing-3: 0.75rem;
        --spacing-4: 1rem;
        --spacing-6: 1.5rem;
        --spacing-8: 2rem;
        --spacing-12: 3rem;
        --spacing-16: 4rem;
    }

    .schedule-detail-page {
        background: #f8fafc;
    }

    /* Hero Section */
    .schedule-hero {
        position: relative;
        width: 100%;
        height: 480px;
        background: linear-gradient(135deg, #e0e7ff, #f3e8ff);
        overflow: hidden;
        margin-bottom: var(--spacing-12);
    }

    .schedule-hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .schedule-hero:hover .schedule-hero-image {
        transform: scale(1.02);
    }

    .schedule-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(30, 41, 59, 0.8), rgba(30, 41, 59, 0.4), transparent);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: var(--spacing-12);
        z-index: 2;
    }

    .schedule-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3);
    }

    .schedule-hero-title {
        font-size: 2.75rem;
        font-weight: 800;
        color: white;
        line-height: 1.2;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        margin: 0;
    }

    .schedule-hero-meta {
        display: flex;
        align-items: center;
        gap: var(--spacing-6);
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.0625rem;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
        flex-wrap: wrap;
    }

    .schedule-hero-meta-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-2);
    }

    .schedule-hero-meta-item i {
        font-size: 1.25rem;
        color: var(--sky-light);
    }

    .schedule-hero-actions {
        display: flex;
        gap: var(--spacing-3);
        align-self: flex-end;
    }

    .schedule-action-btn {
        padding: var(--spacing-3) var(--spacing-6);
        border: 2px solid rgba(255, 255, 255, 0.8);
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9375rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: var(--spacing-2);
        white-space: nowrap;
        backdrop-filter: blur(10px);
    }

    .schedule-action-btn:hover {
        background: white;
        color: var(--deep-slate);
        border-color: white;
        transform: translateY(-2px);
    }

    .schedule-action-btn.active {
        background: var(--sky-blue);
        border-color: var(--sky-blue);
    }

    /* Sticky Toolbar */
    .schedule-toolbar {
        position: sticky;
        top: 80px;
        z-index: 100;
        background: white;
        border-bottom: 2px solid var(--slate-200);
        padding: var(--spacing-4) 0;
        margin-bottom: var(--spacing-8);
        box-shadow: 0 2px 12px rgba(30, 41, 59, 0.08);
    }

    .schedule-toolbar-content {
        display: flex;
        gap: var(--spacing-4);
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .toolbar-actions {
        display: flex;
        gap: var(--spacing-3);
    }

    .toolbar-btn {
        display: flex;
        align-items: center;
        gap: var(--spacing-2);
        padding: var(--spacing-2) var(--spacing-4);
        background: transparent;
        border: 2px solid var(--slate-200);
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--slate);
        transition: all 0.3s ease;
    }

    .toolbar-btn:hover {
        border-color: var(--sky-blue);
        color: var(--sky-blue);
        background: rgba(14, 165, 233, 0.05);
    }

    .toolbar-btn.active {
        background: rgba(14, 165, 233, 0.1);
        border-color: var(--sky-blue);
        color: var(--sky-blue);
        font-weight: 700;
    }

    .toolbar-btn i {
        font-size: 1.125rem;
    }

    /* Main Content Layout */
    .schedule-content-wrapper {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: var(--spacing-8);
        padding: 0 var(--spacing-6);
        margin-bottom: var(--spacing-16);
    }

    .schedule-main {
        flex: 1;
    }

    /* Timeline */
    .schedule-timeline {
        position: relative;
        padding-left: 3rem;
    }

    .schedule-timeline::before {
        content: '';
        position: absolute;
        left: 0.75rem;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(to bottom, var(--sky-blue), var(--sky-light));
        border-radius: 2px;
    }

    .timeline-day {
        margin-bottom: var(--spacing-12);
        position: relative;
        padding-left: 1.5rem;
    }

    .timeline-day::before {
        content: '';
        position: absolute;
        left: -2.86rem;
        top: 0.25rem;
        width: 24px;
        height: 24px;
        background: white;
        border: 3px solid var(--sky-blue);
        border-radius: 50%;
        z-index: 10;
    }

    .timeline-day-header {
        margin-bottom: var(--spacing-6);
    }

    .timeline-day-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin: 0 0 var(--spacing-2) 0;
    }

    .timeline-day-meta {
        font-size: 0.9375rem;
        color: #94a3b8;
    }

    .timeline-locations {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-4);
    }

    /* Location Card in Timeline */
    .location-card {
        background: white;
        border-radius: 12px;
        padding: var(--spacing-4);
        box-shadow: 0 2px 12px rgba(30, 41, 59, 0.08);
        transition: all 0.3s ease;
        display: flex;
        gap: var(--spacing-4);
        border: 2px solid transparent;
    }

    .location-card:hover {
        box-shadow: 0 4px 20px rgba(30, 41, 59, 0.12);
        border-color: rgba(14, 165, 233, 0.2);
        transform: translateY(-2px);
    }

    .location-card-image {
        width: 100px;
        height: 100px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        background: linear-gradient(135deg, #e0e7ff, #f3e8ff);
    }

    .location-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-2);
    }

    .location-card-name {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin: 0;
    }

    .location-card-region {
        font-size: 0.875rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: var(--spacing-1);
    }

    .location-card-time {
        font-size: 0.8125rem;
        color: var(--sky-blue);
        font-weight: 600;
    }

    .location-card-actions {
        display: flex;
        gap: var(--spacing-2);
        margin-top: auto;
    }

    .location-card-btn {
        flex: 1;
        padding: var(--spacing-2) var(--spacing-3);
        border: 1px solid var(--slate-200);
        background: transparent;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--slate);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-1);
    }

    .location-card-btn:hover {
        border-color: var(--sky-blue);
        color: var(--sky-blue);
        background: rgba(14, 165, 233, 0.05);
    }

    .location-card-btn.primary {
        background: rgba(14, 165, 233, 0.1);
        border-color: var(--sky-blue);
        color: var(--sky-blue);
    }

    /* Sidebar */
    .schedule-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-8);
    }

    .sidebar-card {
        background: white;
        border-radius: 16px;
        padding: var(--spacing-6);
        box-shadow: 0 2px 12px rgba(30, 41, 59, 0.08);
        position: sticky;
        top: 200px;
    }

    .sidebar-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin: 0 0 var(--spacing-4) 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-2);
    }

    .sidebar-card-title i {
        color: var(--sky-blue);
        font-size: 1.25rem;
    }

    .stat-item {
        padding: var(--spacing-4) 0;
        border-bottom: 1px solid var(--slate-200);
        display: flex;
        align-items: center;
        gap: var(--spacing-4);
    }

    .stat-item:last-child {
        border-bottom: none;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: rgba(14, 165, 233, 0.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sky-blue);
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-content h4 {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--deep-slate);
        margin: 0;
    }

    .stat-content p {
        font-size: 0.875rem;
        color: #94a3b8;
        margin: 0;
    }

    .sidebar-btn {
        width: 100%;
        padding: var(--spacing-4) var(--spacing-6);
        background: linear-gradient(135deg, var(--sky-blue), var(--sky-light));
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.9375rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-2);
        margin-top: var(--spacing-4);
    }

    .sidebar-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(14, 165, 233, 0.3);
        color: white;
    }

    /* Share Modal */
    .share-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        animation: fadeIn 0.3s ease;
    }

    .share-modal.show {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .share-modal-content {
        background: white;
        border-radius: 16px;
        padding: var(--spacing-8);
        max-width: 400px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(30, 41, 59, 0.3);
        animation: slideIn 0.3s ease;
    }

    .share-modal-header {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--deep-slate);
        margin-bottom: var(--spacing-6);
    }

    .share-options {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-4);
        margin-bottom: var(--spacing-6);
    }

    .share-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-2);
        padding: var(--spacing-4);
        background: rgba(14, 165, 233, 0.05);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        color: var(--deep-slate);
    }

    .share-option:hover {
        background: rgba(14, 165, 233, 0.15);
        transform: translateY(-2px);
    }

    .share-option i {
        font-size: 1.75rem;
        color: var(--sky-blue);
    }

    .share-option span {
        font-weight: 600;
        font-size: 0.875rem;
    }

    .share-modal-divider {
        text-align: center;
        color: #94a3b8;
        margin: var(--spacing-4) 0;
        font-size: 0.875rem;
    }

    .share-link-box {
        display: flex;
        gap: var(--spacing-2);
        margin-bottom: var(--spacing-4);
    }

    .share-link-box input {
        flex: 1;
        padding: var(--spacing-3) var(--spacing-4);
        border: 2px solid var(--slate-200);
        border-radius: 8px;
        font-size: 0.875rem;
        color: var(--deep-slate);
    }

    .share-link-box button {
        padding: var(--spacing-3) var(--spacing-4);
        background: var(--sky-blue);
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .share-link-box button:hover {
        background: var(--sky-light);
    }

    .modal-close {
        display: flex;
        justify-content: flex-end;
        margin-bottom: var(--spacing-4);
    }

    .modal-close button {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #94a3b8;
        transition: all 0.3s ease;
    }

    .modal-close button:hover {
        color: var(--deep-slate);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@keyframes slideIn {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .schedule-content-wrapper {
            grid-template-columns: 1fr;
        }

        .schedule-hero-title {
            font-size: 2rem;
        }

        .schedule-hero-actions {
            align-self: auto;
            width: 100%;
        }

        .schedule-action-btn {
            flex: 1;
        }
    }

    @@media (max-width: 768px) {
        .schedule-hero {
            height: 350px;
            margin-bottom: var(--spacing-8);
        }

        .schedule-hero-overlay {
            padding: var(--spacing-6);
        }

        .schedule-hero-title {
            font-size: 1.5rem;
        }

        .schedule-hero-meta {
            font-size: 0.9375rem;
        }

        .schedule-toolbar {
            top: 70px;
        }

        .schedule-toolbar-content {
            flex-direction: column;
            gap: var(--spacing-3);
        }

        .toolbar-actions {
            width: 100%;
            justify-content: space-between;
        }

        .toolbar-btn {
            flex: 1;
            justify-content: center;
        }

        .schedule-timeline {
            padding-left: 2.5rem;
        }

        .timeline-day {
            padding-left: 1rem;
        }

        .timeline-day::before {
            left: -1rem;
            top: 0;
        }

        .schedule-timeline::before {
            left: 0.5rem;
        }

        .location-card {
            flex-direction: column;
        }

        .location-card-image {
            width: 100%;
            height: 150px;
        }

        .location-card-actions {
            gap: var(--spacing-1);
        }
    }
</style>

<!-- Hero Section -->
<section class="schedule-hero">
    <img src="https://images.unsplash.com/photo-1528127269322-539801943592?w=1200&h=600&fit=crop" alt="Hà Nội - Hạ Long" class="schedule-hero-image">
    <div class="schedule-hero-overlay">
        <div></div>
        <div class="schedule-hero-content">
            <h1 class="schedule-hero-title">Hà Nội - Hạ Long 3 ngày</h1>
            <div class="schedule-hero-meta">
                <div class="schedule-hero-meta-item">
                    <i class="bi bi-calendar-event"></i>
                    <span>3 ngày 2 đêm</span>
                </div>
                <div class="schedule-hero-meta-item">
                    <i class="bi bi-geo-alt"></i>
                    <span>Quảng Ninh, Hà Nội</span>
                </div>
                <div class="schedule-hero-meta-item">
                    <i class="bi bi-person-circle"></i>
                    <span>Tạo bởi: Trương Minh</span>
                </div>
            </div>
            <div class="schedule-hero-actions">
                <button class="schedule-action-btn" onclick="saveSchedule()" title="Lưu về của tôi">
                    <i class="bi bi-download"></i> Lưu
                </button>
                <button class="schedule-action-btn" onclick="toggleFavorite()" title="Yêu thích">
                    <i class="bi bi-heart"></i> Yêu thích
                </button>
                <button class="schedule-action-btn" onclick="openShareModal()" title="Chia sẻ">
                    <i class="bi bi-share"></i> Chia sẻ
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Sticky Toolbar -->
<div class="schedule-toolbar">
    <div class="container-fluid">
        <div class="schedule-toolbar-content">
            <div class="toolbar-actions">
                <button class="toolbar-btn" onclick="backToEdit()" title="Quay lại chỉnh sửa">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </button>
                <button class="toolbar-btn active" onclick="togglePreview()" title="Preview">
                    <i class="bi bi-eye"></i> Preview
                </button>
                <button class="toolbar-btn" onclick="saveSchedule()" title="Lưu lịch trình">
                    <i class="bi bi-check-circle"></i> Lưu
                </button>
                <button class="toolbar-btn" onclick="openShareModal()" title="Xuất / Chia sẻ">
                    <i class="bi bi-share"></i> Xuất
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container-fluid">
    <div class="schedule-content-wrapper">
        <!-- Timeline -->
        <main class="schedule-main">
            <div class="schedule-timeline">
                <!-- Day 1 -->
                <div class="timeline-day">
                    <div class="timeline-day-header">
                        <h2 class="timeline-day-title">Ngày 1 – Hà Nội</h2>
                        <p class="timeline-day-meta"><i class="bi bi-calendar3"></i> Thứ Hai, 15/12/2024</p>
                    </div>
                    <div class="timeline-locations">
                        <div class="location-card">
                            <img src="https://images.unsplash.com/photo-1583417319070-4a69db38a482?w=120&h=120&fit=crop" alt="Hà Nội" class="location-card-image">
                            <div class="location-card-content">
                                <h3 class="location-card-name">Thành phố Hà Nội</h3>
                                <p class="location-card-region"><i class="bi bi-geo-alt"></i> Hà Nội</p>
