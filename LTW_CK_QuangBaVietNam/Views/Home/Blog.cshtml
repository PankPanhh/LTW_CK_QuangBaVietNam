@{
    ViewBag.Title = "Blog - Du lịch, Văn hóa và Ẩm thực Việt Nam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Thêm Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --deep-slate: #1e293b;
        --slate: #334155;
        --sky-blue: #0EA5E9;
        --sky-light: #38BDF8;
        --slate-light: #cbd5e1;
        --slate-200: #e2e8f0;
        --white: #ffffff;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --spacing-2: 0.5rem;
        --spacing-3: 0.75rem;
        --spacing-4: 1rem;
        --spacing-6: 1.5rem;
        --spacing-8: 2rem;
    }

    .blog-page {
        background: #f8fafc;
        padding: var(--spacing-8) 0;
        min-height: 80vh;
    }

    /* Container Header */
    .blog-header {
        text-align: center;
        margin-bottom: var(--spacing-8);
        padding: var(--spacing-8);
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.08), rgba(56, 189, 248, 0.08));
        border-radius: 24px;
        border: 1px solid rgba(14, 165, 233, 0.1);
    }

    .blog-header h1 {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--deep-slate);
        margin: 0 0 var(--spacing-4) 0;
    }

    .blog-header p {
        font-size: 1.1rem;
        color: #64748b;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Navigation Tabs */
    .blog-tabs {
        display: flex;
        justify-content: center;
        gap: var(--spacing-4);
        margin-bottom: var(--spacing-8);
        border-bottom: 2px solid var(--slate-200);
        padding-bottom: var(--spacing-4);
    }

    .tab-btn {
        padding: 10px 24px;
        border: none;
        background: transparent;
        font-size: 1.1rem;
        font-weight: 700;
        color: #94a3b8;
        cursor: pointer;
        position: relative;
        transition: all 0.3s ease;
    }

    .tab-btn:hover { color: var(--sky-blue); }

    .tab-btn.active {
        color: var(--sky-blue);
    }

    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -18px;
        left: 0;
        width: 100%;
        height: 4px;
        background: var(--sky-blue);
        border-radius: 4px 4px 0 0;
    }

    .tab-action-btn {
        padding: 10px 24px;
        background: var(--sky-blue);
        color: white;
        border: none;
        border-radius: 999px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        margin-left: auto;
    }

    .tab-action-btn:hover {
        background: var(--sky-light);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
    }

    /* Tab Contents */
    .tab-content { display: none; animation: fadeIn 0.4s ease; }
    .tab-content.active { display: block; }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Blog Grid */
    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: var(--spacing-6);
    }

    /* Blog Card */
    .blog-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(30, 41, 59, 0.08);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(30, 41, 59, 0.15);
    }

    /* Trạng thái duyệt (Dành cho tab Bài của tôi) */
    .status-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
        color: white;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .status-pending { background: var(--warning); }
    .status-approved { background: var(--success); }
    .status-rejected { background: var(--danger); }
    
    .blog-card.is-pending { opacity: 0.9; }
    .blog-card.is-rejected { opacity: 0.6; filter: grayscale(50%); }

    .blog-card-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
        background: #f1f5f9;
    }

    .blog-card-content {
        padding: var(--spacing-6);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3);
        flex: 1;
    }

    .blog-card-meta {
        font-size: 0.8rem;
        color: var(--sky-blue);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .blog-card-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--deep-slate);
        margin: 0;
        line-height: 1.4;
    }

    .blog-card-excerpt {
        font-size: 0.9rem;
        color: #64748b;
        line-height: 1.6;
        margin: 0;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--spacing-4);
        border-top: 1px solid var(--slate-200);
        margin-top: auto;
    }

    .blog-card-date { font-size: 0.8rem; color: #94a3b8; }

    .blog-card-link {
        color: var(--sky-blue);
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .blog-card-link:hover { color: var(--sky-light); }

    .blog-card-link.is-locked {
        color: #94a3b8;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: var(--spacing-12);
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
        grid-column: 1 / -1;
    }

    .my-blog-note {
        background: rgba(14, 165, 233, 0.08);
        border: 1px solid rgba(14, 165, 233, 0.12);
        color: #0f4c75;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: var(--spacing-6);
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    /* Form Đăng bài (Đơn giản hóa) */
    .create-form-container {
        background: white;
        padding: var(--spacing-8);
        border-radius: 20px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        max-width: 800px;
        margin: 0 auto;
    }
    
    .form-group { margin-bottom: var(--spacing-4); }
    .form-label { display: block; font-weight: 700; margin-bottom: 8px; color: var(--deep-slate); }
    .form-control {
        width: 100%; padding: 12px 16px; border: 2px solid var(--slate-200);
        border-radius: 12px; font-size: 1rem; outline: none; transition: 0.3s;
    }
    .form-control:focus { border-color: var(--sky-blue); }
    textarea.form-control { resize: vertical; min-height: 150px; }

    /* Custom Toast */
    .toast-container {
        position: fixed; top: 20px; right: 20px; z-index: 9999;
        display: flex; flex-direction: column; gap: 10px;
    }
    .custom-toast {
        background: white; padding: 16px 24px; border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15); border-left: 5px solid;
        display: flex; align-items: center; gap: 12px; font-weight: 600;
        animation: slideInRight 0.3s ease forwards;
    }
    .toast-success { border-color: var(--success); color: var(--success); }
    .toast-error { border-color: var(--danger); color: var(--danger); }
</style>

<div class="toast-container" id="toastContainer"></div>

<div class="blog-page">
    <div class="container">
        <!-- Header -->
        <div class="blog-header">
            <h1>Cộng đồng Du lịch</h1>
            <p>Chia sẻ hành trình, lưu giữ kỷ niệm và lan tỏa đam mê khám phá vẻ đẹp Việt Nam cùng hàng ngàn tín đồ du lịch khác.</p>
        </div>

        <!-- Tabs Navigation -->
        <div class="blog-tabs">
            <button class="tab-btn active" onclick="switchTab('public-tab', this)">
                <i class="bi bi-globe-americas"></i> Khám phá
            </button>
            <button class="tab-btn" onclick="switchTab('my-tab', this)">
                <i class="bi bi-person-lines-fill"></i> Bài viết của tôi
            </button>
            
            <button class="tab-action-btn" onclick="switchTab('create-tab', this)">
                <i class="bi bi-pencil-square"></i> Viết bài mới
            </button>
        </div>

        <!-- TAB 1: KHÁM PHÁ (PUBLIC) -->
        <div id="public-tab" class="tab-content active">
            <div class="blog-grid" id="publicBlogGrid">
                <!-- Nội dung load qua AJAX -->
                <div class="empty-state">
                    <i class="bi bi-hourglass-split" style="font-size: 3rem; color: #cbd5e1;"></i>
                    <p style="margin-top: 10px; font-weight:bold;">Đang tải dữ liệu...</p>
                </div>
            </div>
        </div>

        <!-- TAB 2: BÀI CỦA TÔI -->
        <div id="my-tab" class="tab-content">
            <div class="my-blog-note">
                <i class="bi bi-info-circle-fill"></i>
                <span>Bài viết của bạn sẽ luôn xuất hiện tại đây kèm trạng thái rõ ràng: Chờ duyệt, Đã duyệt hoặc Bị từ chối.</span>
            </div>
            <div class="blog-grid" id="myBlogGrid">
                 <!-- Nội dung load qua AJAX -->
            </div>
        </div>

        <!-- TAB 3: VIẾT BÀI -->
        <div id="create-tab" class="tab-content">
            <div class="create-form-container">
                <h2 style="margin-top:0; color:var(--deep-slate);"><i class="bi bi-pencil-fill" style="color:var(--sky-blue)"></i> Chia sẻ trải nghiệm của bạn</h2>
                <p style="color: #64748b; margin-bottom: 20px;">Bài viết của bạn sẽ được đội ngũ kiểm duyệt trước khi hiển thị trên cộng đồng.</p>
                
                <form id="createBlogForm" onsubmit="handleCreateBlog(event)">
                    <div class="form-group">
                        <label class="form-label">Tiêu đề bài viết <span style="color:red">*</span></label>
                        <input type="text" id="blogTitle" class="form-control" placeholder="Ví dụ: Chuyến đi đáng nhớ tại Đà Lạt..." required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Gắn thẻ Địa điểm (Tùy chọn)</label>
                        <select id="blogLocation" class="form-control">
                            <option value="">-- Không gắn thẻ --</option>
                            <!-- Tự động đổ dữ liệu bằng JS -->
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Đường dẫn ảnh Cover (Tùy chọn)</label>
                        <input type="url" id="blogImage" class="form-control" placeholder="https://example.com/image.jpg">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Nội dung <span style="color:red">*</span></label>
                        <textarea id="blogContent" class="form-control" placeholder="Bạn đã có trải nghiệm gì thú vị? Hãy kể cho mọi người nghe nhé..." required></textarea>
                    </div>

                    <div style="text-align: right; margin-top: 20px;">
                        <button type="button" class="tab-btn" onclick="document.querySelector('.blog-tabs button:first-child').click()" style="background:#f1f5f9; border-radius:12px; padding:12px 24px; color:#475569;">Hủy</button>
                        <button type="submit" class="tab-action-btn" style="display:inline-flex; padding: 12px 32px; font-size: 1.1rem;">
                            <i class="bi bi-send-fill"></i> Đăng bài
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    const PLACEHOLDER_IMG = 'https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&q=80&w=800';

    document.addEventListener('DOMContentLoaded', () => {
        loadPublicBlogs();
        loadLocationsForDropdown();
    });

    function normalizeStatus(status) {
        const value = status === null || status === undefined ? '' : String(status).trim().toLowerCase();
        if (value === '1' || value === 'approved' || value === 'true') return 'approved';
        if (value === '2' || value === 'rejected') return 'rejected';
        return 'pending';
    }

    function getStatusMeta(status) {
        const normalized = normalizeStatus(status);
        if (normalized === 'approved') {
            return { label: 'Đã duyệt', icon: 'bi-check-circle-fill', css: 'status-approved' };
        }
        if (normalized === 'rejected') {
            return { label: 'Bị từ chối', icon: 'bi-x-circle-fill', css: 'status-rejected' };
        }
        return { label: 'Chờ duyệt', icon: 'bi-clock-history', css: 'status-pending' };
    }

    // Quản lý Tab UI
    function switchTab(tabId, btnElement) {
        // Cập nhật nút
        document.querySelectorAll('.blog-tabs button').forEach(b => b.classList.remove('active'));
        btnElement.classList.add('active');

        // Cập nhật tab
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');

        // Trigger load data dựa theo tab
        if(tabId === 'public-tab') loadPublicBlogs();
        else if(tabId === 'my-tab') loadMyBlogs();
    }

    // ==========================================
    // API CALLS & RENDER CHỐNG LỖI 404
    // ==========================================

    async function loadPublicBlogs() {
        const grid = document.getElementById('publicBlogGrid');
        try {
            const res = await fetch('/Blog/GetPublicBlogs', { cache: 'no-store' });
            if (!res.ok) throw new Error("HTTP Status: " + res.status);
            
            const contentType = res.headers.get("content-type");
            if (!contentType || !contentType.includes("application/json")) {
                throw new Error("Không nhận được dữ liệu JSON hợp lệ.");
            }

            const data = await res.json();
            const posts = Array.isArray(data && data.data) ? data.data : [];

            if (data && data.success) {
                if (posts.length === 0) {
                    grid.innerHTML = renderEmptyState('Chưa có bài viết nào trong cộng đồng.');
                } else {
                    grid.innerHTML = posts.map(post => renderBlogCard(post, false)).join('');
                }
                return;
            }

            throw new Error((data && data.message) ? data.message : 'API bài viết công khai trả về trạng thái không hợp lệ.');
        } catch (e) {
            console.error("Lỗi khi tải bài viết công khai:", e);
            grid.innerHTML = renderApiFailureState('Không thể tải dữ liệu cộng đồng lúc này.', 'Vui lòng thử tải lại trang sau ít phút.');
        }
    }

    async function loadMyBlogs() {
        const grid = document.getElementById('myBlogGrid');
        grid.innerHTML = `<div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Đang tải bài viết của bạn...</p></div>`;
        
        try {
            const res = await fetch('/Blog/GetMyBlogs', { cache: 'no-store' });
            if (res.status === 401) {
                showToast('Vui lòng đăng nhập để sử dụng chức năng này', 'error');
                grid.innerHTML = renderApiFailureState('Bạn chưa đăng nhập.', 'Hãy đăng nhập để xem các bài viết của mình.');
                return;
            }
            if (!res.ok) throw new Error("HTTP Status: " + res.status);
            
            const contentType = res.headers.get("content-type");
            if (!contentType || !contentType.includes("application/json")) {
                throw new Error("Không nhận được dữ liệu JSON hợp lệ.");
            }

            const data = await res.json();
            const posts = Array.isArray(data && data.data) ? data.data : [];
            
            if (data && data.success) {
                if (posts.length === 0) {
                    grid.innerHTML = renderEmptyState('Bạn chưa có bài viết nào. Hãy chia sẻ chuyến đi đầu tiên nhé!');
                } else {
                    grid.innerHTML = posts.map(post => renderBlogCard(post, true)).join('');
                }
                return;
            }

            throw new Error((data && data.message) ? data.message : 'API bài viết cá nhân trả về trạng thái không hợp lệ.');
        } catch (e) {
            console.error("Lỗi khi tải bài viết cá nhân:", e);
            grid.innerHTML = renderApiFailureState('Không thể tải bài viết của bạn lúc này.', 'Kiểm tra lại kết nối hoặc đăng nhập lại rồi thử lại.');
        }
    }

    async function loadLocationsForDropdown() {
        const endpoints = ['/Blog/GetLocationsForDropdown', '/Map/GetLocationsForDropdown'];

        for (const endpoint of endpoints) {
            try {
                const res = await fetch(endpoint);
                if (!res.ok) {
                    continue;
                }

                const contentType = res.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) {
                    continue;
                }

                const data = await res.json();
                if (data.success) {
                    const select = document.getElementById('blogLocation');
                    data.data.forEach(loc => {
                        let option = new Option(loc.name, loc.id);
                        select.add(option);
                    });
                    return;
                }
            } catch (e) {
                console.warn(`Không tải được dropdown từ ${endpoint}:`, e);
            }
        }

        console.warn('Không tải được danh sách địa điểm cho blog.');
    }

    // Xử lý Form Submit (Tạo bài mới)
    async function handleCreateBlog(e) {
        e.preventDefault();
        
        const title = document.getElementById('blogTitle').value;
        const content = document.getElementById('blogContent').value;
        const locationId = document.getElementById('blogLocation').value;
        const imageUrl = document.getElementById('blogImage').value;

        const payload = new URLSearchParams();
        payload.append('title', title);
        payload.append('content', content);
        payload.append('locationId', locationId ? locationId : '');
        if (imageUrl) {
            payload.append('imageUrls', imageUrl);
        }

        try {
            const submitBtn = e.target.querySelector('button[type="submit"]');
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Đang gửi...';
            submitBtn.disabled = true;

            const res = await fetch('/Blog/CreateBlog', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: payload.toString()
            });

            if (res.status === 401) {
                showToast('Vui lòng đăng nhập để sử dụng chức năng này', 'error');
                return;
            }
            
            if (!res.ok) throw new Error("Lỗi kết nối tới máy chủ.");
            const contentType = res.headers.get("content-type");
            if (!contentType || !contentType.includes("application/json")) throw new Error("Máy chủ trả về kết quả không hợp lệ.");

            const data = await res.json();

            if (data.success) {
                showToast('Bài viết của bạn đã được gửi và đang chờ duyệt.', 'success');
                e.target.reset();
                loadMyBlogs();
                setTimeout(() => {
                    document.querySelector('button[onclick="switchTab(\'my-tab\', this)"]').click();
                }, 800);
            } else {
                showToast(data.message, 'error');
            }
        } catch (error) {
            showToast('Lỗi mạng khi đăng bài', 'error');
            console.error(error);
        } finally {
            const submitBtn = e.target.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="bi bi-send-fill"></i> Đăng bài';
                submitBtn.disabled = false;
            }
        }
    }

    function renderBlogCard(post, isMyBlog) {
        const img = post.image || PLACEHOLDER_IMG;
        const status = normalizeStatus(post.status);
        const statusMeta = getStatusMeta(status);
        const canViewDetail = (!isMyBlog) || status === 'approved';
        const locationName = post.locationName || 'Khám phá';
        const dateText = post.date || '';
        const authorName = post.author || 'Người dùng';
        const avatar = post.avatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(authorName) + '&background=0EA5E9&color=fff');
        const likesText = typeof post.likes === 'number' ? post.likes : (typeof post.totalLikes === 'number' ? post.totalLikes : 0);
        const commentsText = typeof post.totalComments === 'number' ? post.totalComments : 0;
        const isLiked = post.isLiked === true;
        const loginHint = '<span style="color:#94a3b8;font-size:0.85rem;">Đăng nhập để tương tác</span>';
        
        let statusHtml = '';
        let cardClass = 'blog-card';
        
        if (isMyBlog) {
            statusHtml = `<span class="status-badge ${statusMeta.css}"><i class="bi ${statusMeta.icon}"></i> ${statusMeta.label}</span>`;
            if (status === 'pending') {
                cardClass += ' is-pending';
            } else if (status === 'rejected') {
                cardClass += ' is-rejected';
            }
        }

        const linkHtml = canViewDetail 
            ? `<a href="/Home/DetailBlog?id=${post.id}" class="blog-card-link">Đọc tiếp <i class="bi bi-arrow-right"></i></a>`
            : `<span class="blog-card-link is-locked"><i class="bi bi-lock-fill"></i> Tạm khóa</span>`;

        return `
            <div class="${cardClass}">
                ${statusHtml}
                <div style="position:relative;">
                    <img src="${img}" alt="${post.title}" class="blog-card-image" onerror="this.src='${PLACEHOLDER_IMG}'">
                </div>
                <div class="blog-card-content">
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                        <img src="${avatar}" alt="${authorName}" style="width:32px; height:32px; border-radius:50%; object-fit:cover;">
                        <div style="display:flex; flex-direction:column;">
                            <span style="font-weight:700; color:var(--deep-slate); font-size:0.92rem;">${authorName}</span>
                            <span style="font-size:0.78rem; color:#94a3b8;">${dateText}</span>
                        </div>
                    </div>
                    <div class="blog-card-meta">
                        <i class="bi bi-geo-alt-fill"></i> ${locationName}
                    </div>
                    <h3 class="blog-card-title">${post.title}</h3>
                    <p class="blog-card-excerpt">${post.excerpt}</p>
                    <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap; color:#64748b; font-size:0.85rem;">
                        <span><i class="bi bi-heart${isLiked ? '-fill' : ''}" style="color:${isLiked ? 'var(--danger)' : '#94a3b8'};"></i> ${likesText}</span>
                        <span><i class="bi bi-chat-dots"></i> ${commentsText}</span>
                    </div>
                    <div class="blog-card-footer">
                        <span class="blog-card-date">${dateText}</span>
                        ${linkHtml}
                    </div>
                    ${isMyBlog ? '' : loginHint}
                </div>
            </div>
        `;
    }

    function renderEmptyState(message) {
        return `
            <div class="empty-state">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #cbd5e1;"></i>
                <h3 style="margin-top: 15px;">Trống</h3>
                <p>${message}</p>
            </div>
        `;
    }

    function renderApiFailureState(title, message) {
        return `
            <div class="empty-state">
                <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: #f59e0b;"></i>
                <h3 style="margin-top: 15px;">${title}</h3>
                <p>${message}</p>
            </div>
        `;
    }

    // Hệ thống Toast đẹp mắt thay cho Alert
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        
        const icon = type === 'success' ? '<i class="bi bi-check-circle-fill"></i>' : '<i class="bi bi-exclamation-triangle-fill"></i>';
        toast.className = `custom-toast toast-${type}`;
        toast.innerHTML = `${icon} <span>${message}</span>`;
        
        container.appendChild(toast);

        // Tự xóa sau 3.5s
        setTimeout(() => {
            toast.style.animation = 'slideInRight 0.3s ease reverse forwards';
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }
</script>