@{
    ViewBag.Title = "Tất cả địa điểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --deep-slate: #1e293b;
        --slate: #334155;
        --sky-blue: #0EA5E9;
        --sky-light: #38BDF8;
        --slate-light: #cbd5e1;
        --white: #ffffff;
        --spacing-2: 0.5rem;
        --spacing-3: 0.75rem;
        --spacing-4: 1rem;
        --spacing-6: 1.5rem;
        --spacing-8: 2rem;
        --spacing-12: 3rem;
        --spacing-16: 4rem;
        --spacing-24: 6rem;
    }

    /* ALL PLACES HEADER BANNER */
    .places-banner {
        position: relative;
        height: 300px;
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.85), rgba(14, 165, 233, 0.75)), url('https://images.unsplash.com/photo-1528127269322-539801943592?w=1920&q=80') center/cover;
        background-attachment: fixed;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
        text-align: center;
        overflow: hidden;
    }

        .places-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.2), transparent 70%);
        }

    .places-content {
        position: relative;
        z-index: 2;
        padding: 0 var(--spacing-6);
    }

        .places-content h1 {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: var(--spacing-4);
            text-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
            line-height: 1.15;
        }

        .places-content p {
            font-size: 1.25rem;
            opacity: 0.95;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
        }

    /* STICKY FILTER BAR */
    .filter-bar {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        padding: var(--spacing-6) 0;
        box-shadow: 0 4px 28px rgba(30, 41, 59, 0.08);
        position: sticky;
        top: 111px;
        z-index: 1020;
        margin-bottom: var(--spacing-12);
        border-bottom: 1px solid rgba(14, 165, 233, 0.15);
    }

        .filter-bar .filter-btn {
            padding: var(--spacing-3) var(--spacing-6);
            border: 2px solid rgba(14, 165, 233, 0.25);
            border-radius: 999px;
            background: white;
            color: var(--slate);
            margin-right: var(--spacing-3);
            margin-bottom: var(--spacing-2);
            transition: all 0.3s ease;
            font-weight: 600;
            font-size: 0.9375rem;
            box-shadow: 0 2px 8px rgba(30, 41, 59, 0.06);
        }

            .filter-bar .filter-btn:hover {
                border-color: var(--sky-blue);
                background: rgba(14, 165, 233, 0.08);
                color: var(--deep-slate);
                transform: translateY(-2px);
                box-shadow: 0 4px 16px rgba(14, 165, 233, 0.2);
            }

            .filter-bar .filter-btn.active {
                border-color: transparent;
                background: linear-gradient(135deg, var(--sky-blue), var(--sky-light));
                color: var(--white);
                box-shadow: 0 4px 20px rgba(14, 165, 233, 0.35);
            }

    /* DESTINATION CARDS */
    .destination-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(30, 41, 59, 0.08);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1.5px solid rgba(255, 255, 255, 0.4);
    }

        .destination-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 24px 56px rgba(14, 165, 233, 0.15);
            border-color: rgba(14, 165, 233, 0.3);
        }

        .destination-card .card-img-wrapper {
            position: relative;
            height: 280px;
            overflow: hidden;
            border-radius: 28px;
            margin: 6px;
            isolation: isolate;
        }

            .destination-card .card-img-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
            }

        .destination-card:hover .card-img-wrapper img {
            transform: scale(1.1);
        }

        .destination-card .card-img-wrapper::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 40%;
            background: linear-gradient(to top, rgba(15, 23, 42, 0.5), transparent);
            z-index: 1;
        }

        .destination-card .favorite-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 1.25rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 10;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        }

            .destination-card .favorite-btn:hover {
                transform: scale(1.1);
                background: rgba(255, 255, 255, 0.95);
                color: #ef4444;
                border-color: #ef4444;
                box-shadow: 0 8px 24px rgba(239, 68, 68, 0.3);
            }

            .destination-card .favorite-btn i {
                transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            }

    .destination-card .card-body {
        padding: var(--spacing-6);
        display: flex;
        flex-direction: column;
        flex: 1;
        position: relative;
        z-index: 2;
    }

    .destination-card .card-title {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: var(--spacing-2);
        color: var(--deep-slate);
        line-height: 1.2;
        letter-spacing: -0.5px;
    }

    .destination-card .card-location {
        font-size: 0.875rem;
        color: #94a3b8;
        font-weight: 500;
        margin-bottom: var(--spacing-4);
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

        .destination-card .card-location i {
            font-size: 1rem;
            color: var(--sky-blue);
        }

    .destination-card .card-description {
        color: #64748b;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: auto;
        font-weight: 400;
        font-style: italic;
        transition: color 0.3s ease;
        quotes: "\201C""\201D";
        max-height: 3.2em; /* 2 lines max */
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .destination-card:hover .card-description {
        color: var(--sky-blue);
    }

    .destination-card .card-description::before {
        content: open-quote;
        margin-right: 0.25rem;
        opacity: 0.5;
    }

    .destination-card .card-description::after {
        content: close-quote;
        margin-left: 0.25rem;
        opacity: 0.5;
    }

    .destination-card .experience-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: var(--spacing-4);
        padding: 0.5rem 1rem;
        background: rgba(14, 165, 233, 0.08);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(14, 165, 233, 0.25);
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--sky-blue);
        letter-spacing: 0.5px;
        text-transform: uppercase;
        transition: all 0.3s ease;
        width: fit-content;
    }

    .destination-card:hover .experience-badge {
        background: rgba(14, 165, 233, 0.15);
        border-color: rgba(14, 165, 233, 0.4);
        box-shadow: 0 4px 12px rgba(14, 165, 233, 0.15);
    }

    .destination-card .experience-badge::before {
        content: "✦";
        font-size: 0.7rem;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: var(--spacing-12);
        color: var(--deep-slate);
        position: relative;
        padding-bottom: var(--spacing-4);
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 4px;
            border-radius: 2px;
            background: var(--sky-blue);
        }

    .text-center .section-title::after {
        left: 50%;
        transform: translateX(-50%);
    }
</style>

<!-- HEADER BANNER -->
<section class="places-banner">
    <div class="places-content container">
        <h1>Tất Cả Địa Điểm</h1>
        <p>Hàng nghìn địa danh tuyệt đẹp trên khắp Việt Nam đang chờ bạn</p>
    </div>
</section>

<!-- FILTER BAR -->
<div class="filter-bar">
    <div class="container">
        <button class="filter-btn active">Tất cả</button>
        <button class="filter-btn">Miền Bắc</button>
        <button class="filter-btn">Miền Trung</button>
        <button class="filter-btn">Miền Nam</button>
        <button class="filter-btn">Đảo & Biển</button>
        <button class="filter-btn">Núi rừng</button>
    </div>
</div>

<!-- ALL PLACES LIST -->
<section class="container mb-5">
    <div class="row g-4" id="placesContainer">
        <!-- Placeholder loading -->
        <div class="col-12">
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Đang tải dữ liệu...</p>
            </div>
        </div>
    </div>
</section>

<script>
    let allPlaces = [];
    let currentPage = 1;
    let selectedRegion = '';

    // Load tất cả địa điểm khi trang mở
    document.addEventListener('DOMContentLoaded', function() {
        loadPlaces(1, '');
    });

    // Load địa điểm từ API
    function loadPlaces(page = 1, vungMien = '') {
        const container = document.getElementById('placesContainer');
        container.innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3">Đang tải dữ liệu...</p></div>';

        fetch(`/DiaDiem/GetAllPlaces?page=${page}&pageSize=9&vungMien=${vungMien}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    renderPlaces(data.data);
                    allPlaces = data.data;
                } else {
                    container.innerHTML = '<div class="col-12"><div class="alert alert-danger">Không thể tải dữ liệu. ' + data.message + '</div></div>';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                container.innerHTML = '<div class="col-12"><div class="alert alert-danger">Lỗi khi tải dữ liệu: ' + error.message + '</div></div>';
            });
    }

    // Render các card địa điểm
    // Render các card địa điểm
    function renderPlaces(places) {
        const container = document.getElementById('placesContainer');

        if (places.length === 0) {
            container.innerHTML = '<div class="col-12"><div class="alert alert-info">Không tìm thấy địa điểm nào.</div></div>';
            return;
        }

        let html = '';
        places.forEach(place => {
            // Mapping dữ liệu từ API
            const tenDiaDiem = place.TenDiaDiem || 'Địa điểm';
            const slug = place.Slug || '';
            const moTaNgan = place.MoTaNgan || 'Khám phá địa điểm du lịch tuyệt vời';
            const anhChinh = place.AnhChinh || '/Content/images/Places/vinhhalong.jpg';
            const tenDanhMuc = place.DanhMuc || 'KHÁM PHÁ'; // Lấy tên danh mục

            // Xử lý vị trí
            const locationBase = place.DiaChiChiTiet || place.VungMien || 'Việt Nam';
            const locationText = locationBase.toLowerCase().includes('việt nam')
                ? locationBase
                : `${locationBase} - Việt Nam`;

            // Cắt ngắn mô tả (120 ký tự)
            const maxLength = 120;
            const truncatedDescription = moTaNgan.length > maxLength
                ? moTaNgan.substring(0, maxLength).trim() + '...'
                : moTaNgan;

            html += `
            <div class="col-md-4 mb-4">
                <div class="destination-card" onclick="goToDetailPlace('${slug}')" style="cursor: pointer;">
                    <div class="card-img-wrapper">
                        <img src="${anhChinh}" alt="${tenDiaDiem}" class="img-fluid">
                        <button class="favorite-btn" aria-label="Thêm vào danh sách yêu thích" onclick="event.stopPropagation(); toggleFavorite(event)">
                            <i class="bi bi-heart"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-truncate">${tenDiaDiem}</h5>
                        <div class="card-location">
                            <i class="bi bi-geo-alt"></i>
                            <span>${locationText}</span>
                        </div>
                        <p class="card-description">${truncatedDescription}</p>
                        
                        <!-- CHỈNH SỬA TẠI ĐÂY: Hiển thị Tên Danh Mục (không có dấu +) -->
                        <div class="experience-badge">
                             ${tenDanhMuc.toUpperCase()}
                        </div>
                    </div>
                </div>
            </div>
            `;
        });

        container.innerHTML = html;
        // ... (Giữ nguyên phần attach event phía sau)
    }
    // Filter buttons interaction
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            // Lấy region từ button text
            let region = this.textContent.trim();
            
            if (region === 'Tất cả') {
                selectedRegion = '';
            } else if (region === 'Miền Bắc') {
                selectedRegion = 'Bắc';
            } else if (region === 'Miền Trung') {
                selectedRegion = 'Trung';
            } else if (region === 'Miền Nam') {
                selectedRegion = 'Nam';
            } else if (region === 'Đảo & Biển') {
                selectedRegion = 'Biển';
            } else if (region === 'Núi rừng') {
                selectedRegion = 'Núi';
            }

            loadPlaces(1, selectedRegion);
        });
    });

    // Navigate to detail place page
    function goToDetailPlace(placeSlug) {
        window.location.href = '/Home/DetailPlace?slug=' + placeSlug;
    }

    // Toggle favorite function
    function toggleFavorite(event) {
        const btn = event.target.closest('.favorite-btn');
        if (!btn) return;

        const icon = btn.querySelector('i');
        if (!icon) return;

        const isAdding = icon.classList.contains('bi-heart');
        if (isAdding) {
            icon.classList.remove('bi-heart');
            icon.classList.add('bi-heart-fill');
            btn.style.color = '#ef4444';
            btn.style.borderColor = '#ef4444';
        } else {
            icon.classList.remove('bi-heart-fill');
            icon.classList.add('bi-heart');
            btn.style.color = 'var(--white)';
            btn.style.borderColor = 'rgba(255, 255, 255, 0.4)';
        }
    }
</script>