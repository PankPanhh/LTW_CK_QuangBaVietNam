<script>
    // ═══════════════════════════════════════════════════════════════
    //  STATE
    // ═══════════════════════════════════════════════════════════════
    let G = {
        id: null,           // MaLichTrinh
        name: '',
        startDate: '',
        endDate: '',
        privacy: 'private',
        days: 0,
        dayData: {},        // { 1: {dayId, places:[{id,name,anh,gioBatDau,gioKetThuc,ghiChu,idChiTiet,viDo,kinhDo,distanceToNext,transportIcon,transportLabel}], notes:[]}, ... }
        unsaved: false
    };

    let pendingPlace = null;   // place obj from discovery
    let pendingDayNum = null;
    let noteForDay = null;
    let mapObj = null;
    let mapMarkers = [];
    let mapPolylines = [];
    let searchTimer = null;

    // ═══════════════════════════════════════════════════════════════
    //  INIT FORM
    // ═══════════════════════════════════════════════════════════════
    let coverBase64 = '';
    function previewCover(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(evt) {
                coverBase64 = evt.target.result;
                document.getElementById('coverPreview').src = evt.target.result;
                document.getElementById('uploadZone').style.display = 'none';
                document.getElementById('coverPreviewWrap').style.display = 'block';
            };
            reader.readAsDataURL(file);
        }
    }
    function removeCover(e) {
        e.stopPropagation();
        coverBase64 = '';
        document.getElementById('inp_cover').value = '';
        document.getElementById('coverPreview').src = '';
        document.getElementById('coverPreviewWrap').style.display = 'none';
        document.getElementById('uploadZone').style.display = 'block';
    }

    function onDragOver(e) {
        e.preventDefault();
        document.getElementById('uploadZone').classList.add('dragover');
    }
    function onDragLeave(e) {
        e.preventDefault();
        document.getElementById('uploadZone').classList.remove('dragover');
    }
    function onDrop(e) {
        e.preventDefault();
        document.getElementById('uploadZone').classList.remove('dragover');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            previewCover({ target: { files: files } });
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const editId = urlParams.get('edit');
        if (editId) {
            loadScheduleForEdit(editId);
        }
    });

    function loadScheduleForEdit(id) {
        document.getElementById('initScreen').style.display = 'none';
        document.getElementById('editorScreen').style.display = 'block';
        fetch(`/Itinerary/GetDetail?idLichTrinh=${id}`)
            .then(r => r.json())
            .then(d => {
                if (!d.success) { toast('err', 'Lỗi', d.message); return; }
                const sd = d.data;
                G.id = id;
                G.name = sd.tenLichTrinh;
                G.startDate = sd.ngayBatDau?.split('T')[0] || '';
                G.endDate = sd.ngayKetThuc?.split('T')[0] || '';
                G.privacy = sd.trangThai || 'private';
                G.days = sd.soNgay || sd.days.length;
                G.dayData = {};
                sd.days.forEach((day, index) => {
                    const dayNum = index + 1;
                    G.dayData[dayNum] = {
                        dayId: day.idNgay,
                        tenKhuVuc: day.tenKhuVuc || '',
                        places: day.places.map(p => ({
                            idChiTiet: p.idChiTiet,
                            maDiaDiem: p.maDiaDiem,
                            id: p.maDiaDiem,
                            name: p.tenDiaDiem,
                            tenDiaDiem: p.tenDiaDiem,
                            tinhThanh: p.tinhThanh,
                            anh: p.anh,
                            viDo: p.viDo, kinhDo: p.kinhDo,
                            gioBatDau: p.gioBatDau, gioKetThuc: p.gioKetThuc, ghiChu: p.ghiChu,
                            distanceToNext: p.distanceToNext || 0,
                            transportIcon: p.transportIcon || '🚗',
                            transportLabel: p.transportLabel || 'Ô tô',
                            airportInfo: p.airportInfo || ''
                        })),
                        notes: day.notes || []
                    };
                });
                document.getElementById('edTitle').textContent = G.name;
                document.getElementById('edInfo').textContent = `${fmtDate(G.startDate)} — ${fmtDate(G.endDate)} · ${G.days} ngày · ${G.privacy === 'private' ? 'Riêng tư' : 'Công khai'}`;
                updatePrivLabel();
                renderAllDays();
                loadRegions();
                toast('ok', 'Đã tải', 'Sẵn sàng chỉnh sửa');
            });
    }

    function submitInit(e) {
        e.preventDefault();
        const name = document.getElementById('inp_name').value.trim();
        const start = document.getElementById('inp_start').value;
        const end = document.getElementById('inp_end').value;
        const cover = coverBase64;
        const prv = document.querySelector('input[name=prv]:checked').value;
        if (!name || !start || !end) { toast('warn', 'Thiếu thông tin', 'Vui lòng điền đầy đủ'); return; }
        if (end < start) { toast('err', 'Ngày không hợp lệ', 'Ngày kết thúc phải sau ngày bắt đầu'); return; }

        const btn = e.target.querySelector('button[type=submit]');
        btn.disabled = true; btn.textContent = 'Đang tạo...';

        fetch('/Itinerary/Create', {
            method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `tenLichTrinh=${encodeURIComponent(name)}&moTa=&ngayBatDau=${start}&ngayKetThuc=${end}&trangThai=${prv}&anhBia=${encodeURIComponent(cover)}`
        }).then(r => r.json()).then(d => {
            if (!d.success) { toast('err', 'Lỗi', d.message); btn.disabled = false; btn.innerHTML = '<i class="bi bi-play-fill"></i> Bắt đầu lập kế hoạch'; return; }
            G.id = d.id; G.name = name; G.startDate = start; G.endDate = end; G.privacy = prv; G.days = d.soNgay;
            G.dayData = {};
            (d.dayIds || []).forEach(di => {
                G.dayData[di.dayNum] = { dayId: di.dayId, tenKhuVuc: '', places: [], notes: [] };
            });
            document.getElementById('edTitle').textContent = name;
            document.getElementById('edInfo').textContent = `${fmtDate(start)} — ${fmtDate(end)} · ${d.soNgay} ngày · ${prv === 'private' ? 'Riêng tư' : 'Công khai'}`;
            updatePrivLabel();
            document.getElementById('initScreen').style.display = 'none';
            document.getElementById('editorScreen').style.display = 'block';
            renderAllDays();
            loadRegions();
            toast('ok', 'Tạo thành công!', d.message);
        }).catch(() => { toast('err', 'Lỗi kết nối', 'Không thể tạo lịch trình'); btn.disabled = false; });
    }

    // ═══════════════════════════════════════════════════════════════
    //  DAY RENDERING
    // ═══════════════════════════════════════════════════════════════
    function renderAllDays() {
        const c = document.getElementById('daysContainer');
        c.innerHTML = '';
        for (let i = 1; i <= G.days; i++) renderDayCard(i);
    }

    function renderDayCard(n) {
        const c = document.getElementById('daysContainer');
        const div = document.createElement('div');
        div.className = 'day-card'; div.id = `day-${n}`;
        const startDt = new Date(G.startDate + 'T00:00:00');
        startDt.setDate(startDt.getDate() + n - 1);
        const dateLabel = startDt.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' });
        const savedRegion = G.dayData[n]?.tenKhuVuc || '';
        const addBtnLabel = savedRegion
            ? `<i class="bi bi-compass"></i> Chọn điểm tham quan tại ${savedRegion}`
            : `<i class="bi bi-plus-lg"></i> Thêm địa điểm vào Ngày ${n}`;
        div.innerHTML = `
        <div class="day-head">
            <div>
                <div class="day-title" id="day-title-${n}">Ngày ${n} <span style="font-size:.8rem;font-weight:400;color:var(--slate);">— ${dateLabel}</span>${savedRegion ? ` <span class="day-active-badge">📍 ${savedRegion}</span>` : ''}</div>
            </div>
            <div class="day-acts">
                <button title="Ngày này đang chỉnh sửa" onclick="setActiveDay(${n})" style="color:var(--sky-blue);"><i class="bi bi-crosshair"></i></button>
                <button title="Thêm ghi chú" onclick="openNoteModal(${n})"><i class="bi bi-sticky"></i></button>
                <button class="danger" title="Xóa ngày" onclick="removeDay(${n})"><i class="bi bi-trash"></i></button>
            </div>
        </div>
        <div class="day-region-row">
            <span class="day-region-lbl">📍 Khu vực:</span>
            <select class="day-region-sel" id="region-sel-${n}" onchange="onDayRegionChange(${n}, this.value)">
                <option value="">-- Chọn khu vực chính --</option>
            </select>
        </div>
        <div class="day-body" id="day-body-${n}">
            <div class="empty-day"><i class="bi bi-compass"></i>Chọn khu vực, rồi bấm nút bên dưới để thêm điểm tham quan!</div>
        </div>
        <button class="add-place-btn" id="add-btn-${n}" onclick="openPlacesForDay(${n})">${addBtnLabel}</button>
    `;
        c.appendChild(div);
        // Populate region dropdown
        populateDayRegionSelect(n, savedRegion);
        refreshDayBody(n);
    }

    let allRegions = [];
    function populateDayRegionSelect(n, currentRegion) {
        const sel = document.getElementById(`region-sel-${n}`);
        if (!sel) return;
        sel.innerHTML = '<option value="">-- Chọn khu vực chính --</option>';
        allRegions.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.name;
            opt.textContent = r.name + ` (${r.count})`;
            if (r.name === currentRegion) opt.selected = true;
            sel.appendChild(opt);
        });
    }

    function onDayRegionChange(n, region) {
        const dd = G.dayData[n];
        if (!dd) return;
        dd.tenKhuVuc = region;
        // Update title badge
        const titleEl = document.getElementById(`day-title-${n}`);
        if (titleEl) {
            const startDt = new Date(G.startDate + 'T00:00:00');
            startDt.setDate(startDt.getDate() + n - 1);
            const dateLabel = startDt.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' });
            titleEl.innerHTML = `Ngày ${n} <span style="font-size:.8rem;font-weight:400;color:var(--slate);">— ${dateLabel}</span>${region ? ` <span class="day-active-badge">📍 ${region}</span>` : ''}`;
        }
        // Update add button
        const addBtn = document.getElementById(`add-btn-${n}`);
        if (addBtn) {
            addBtn.innerHTML = region
                ? `<i class="bi bi-compass"></i> Chọn điểm tham quan tại ${region}`
                : `<i class="bi bi-plus-lg"></i> Thêm địa điểm vào Ngày ${n}`;
        }
        // Save to server
        if (dd.dayId) {
            fetch('/Itinerary/UpdateDayRegion', {
                method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `idNgay=${dd.dayId}&tenKhuVuc=${encodeURIComponent(region)}`
            }).then(r => r.json()).then(d => {
                if (d.success) toast('ok', 'Đã cập nhật khu vực', region ? `Ngày ${n} — ${region}` : '');
            });
        }
        // If there's a region, load places for discovery
        if (region) {
            setActiveDay(n);
            loadPlacesByRegion(region);
            // Also scroll to discovery panel
            document.getElementById('discPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        markUnsaved();
    }

    let activeDayNum = null;
    function setActiveDay(n) {
        activeDayNum = n;
        // Highlight active day card
        document.querySelectorAll('.day-card').forEach(c => c.style.boxShadow = '');
        const card = document.getElementById(`day-${n}`);
        if (card) card.style.boxShadow = '0 0 0 2px var(--sky-blue)';
        // Update discovery panel header
        const region = G.dayData[n]?.tenKhuVuc || '';
        const discHeader = document.getElementById('discPanelHeader');
        if (discHeader) {
            discHeader.textContent = region ? `📍 Địa điểm tại ${region}` : '🧭 Khám phá địa điểm';
        }
        // Load places for active day's region
        if (region) loadPlacesByRegion(region);
        toast('info', `Đang thêm cho Ngày ${n}`, region ? `Khu vực: ${region}` : 'Chọn khu vực cho ngày này');
    }

    function openPlacesForDay(n) {
        setActiveDay(n);
        const region = G.dayData[n]?.tenKhuVuc || '';
        if (!region) {
            toast('warn', 'Chưa chọn khu vực', 'Hãy chọn khu vực chính cho ngày này trước');
            // Focus the dropdown
            const sel = document.getElementById(`region-sel-${n}`);
            if (sel) { sel.focus(); sel.classList.add('focused'); }
            return;
        }
        // Scroll to discovery panel
        switchTab('disc');
        loadPlacesByRegion(region);
        document.getElementById('searchInp').placeholder = `Tìm địa điểm tại ${region}...`;
    }

    function refreshDayBody(n) {
        const body = document.getElementById(`day-body-${n}`);
        if (!body) return;
        const dd = G.dayData[n];
        if (!dd) return;
        const places = dd.places || [];
        const notes = dd.notes || [];
        if (places.length === 0 && notes.length === 0) {
            body.innerHTML = '<div class="empty-day"><i class="bi bi-calendar-plus"></i>Chưa có địa điểm. Chọn từ cột Khám phá!</div>';
            return;
        }
        body.innerHTML = '';
        // Sort by time
        const sorted = [...places].sort((a, b) => (a.gioBatDau || '').localeCompare(b.gioBatDau || ''));
        sorted.forEach((p, idx) => {
            const anh = p.anh || 'https://images.unsplash.com/photo-1528127269322-539801943592?w=80&h=80&fit=crop';
            const nearbyId = `nearby-${n}-${idx}`;
            body.insertAdjacentHTML('beforeend', `
            <div class="place-item" id="pitem-${p.idChiTiet}" data-time="${p.gioBatDau}">
                <div class="place-time">${p.gioBatDau || ''}</div>
                <img class="place-thumb" src="${p.anh || anh}" onerror="this.src='${anh}'" />
                <div class="place-info">
                    <div class="place-name">${p.name || p.tenDiaDiem || ''}</div>
                    <div class="place-addr"><i class="bi bi-geo-alt-fill" style="font-size:.7rem;color:var(--sky-blue);"></i> ${p.tinhThanh || ''}</div>
                    ${p.ghiChu ? `<div class="place-note-text"><i class="bi bi-sticky"></i> ${p.ghiChu}</div>` : ''}
                    <div class="place-btns">
                        <button class="pbtn" onclick="loadNearby(${p.maDiaDiem || p.id}, '${nearbyId}', ${n})"><i class="bi bi-magic"></i> Gần đây</button>
                        <button class="pbtn" onclick="viewOnMap(${p.viDo || 0},${p.kinhDo || 0})"><i class="bi bi-map"></i> Map</button>
                        <button class="pbtn red" onclick="doDeletePlace(${p.idChiTiet},'pitem-${p.idChiTiet}',${n})"><i class="bi bi-x"></i> Xóa</button>
                    </div>
                    <div class="place-nearby" id="${nearbyId}"></div>
                </div>
            </div>
            `);
            // transport connector
            if (idx < sorted.length - 1 && p.distanceToNext > 0) {
                body.insertAdjacentHTML('beforeend', `
                <div class="transport-row">
                    <span class="tr-icon">${p.transportIcon || '🚗'}</span>
                    <span class="tr-line"></span>
                    <span>${p.transportLabel || ''} · ${p.distanceToNext} km</span>
                    ${p.airportInfo ? `<span style="font-size:.73rem;color:var(--amber);">ⓘ ${p.airportInfo}</span>` : ''}
                </div>
                `);
            }
        });
        notes.forEach((nt, ni) => {
            body.insertAdjacentHTML('beforeend', `
            <div class="note-item" id="note-${n}-${ni}">
                <button class="note-del" onclick="removeNote('note-${n}-${ni}',${n},${ni})">×</button>
                ${nt}
            </div>
            `);
        });
        markUnsaved();
    }

    // ═══════════════════════════════════════════════════════════════
    //  ADD NEW DAY
    // ═══════════════════════════════════════════════════════════════
    function addNewDay() {
        if (!G.id) return;
        fetch('/Itinerary/AddDay', {
            method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `idLichTrinh=${G.id}`
        }).then(r => r.json()).then(d => {
            if (!d.success) { toast('err', 'Lỗi', d.message); return; }
            const n = G.days + 1; G.days = n;
            G.dayData[n] = { dayId: d.dayId, tenKhuVuc: '', places: [], notes: [] };
            renderDayCard(n);
            setTimeout(() => document.getElementById(`day-${n}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
            toast('ok', `Đã thêm Ngày ${n}`, 'Hãy chọn khu vực chính cho ngày này');
        });
    }

    // ═══════════════════════════════════════════════════════════════
    //  REMOVE DAY
    // ═══════════════════════════════════════════════════════════════
    function removeDay(n) {
        if (!confirm(`Xóa Ngày ${n} khỏi lịch trình ? `)) return;
        const el = document.getElementById(`day - ${n} `);
        if (el) { el.style.animation = 'fadeOutSc .3s ease-out'; setTimeout(() => el.remove(), 280); }
        // Remove from G.dayData and reorder
        delete G.dayData[n];
        // Re-render remaining days
        const c = document.getElementById('daysContainer'); c.innerHTML = '';
        let newIdx = 1; const newData = {};
        for (let i = 1; i <= G.days; i++) {
            if (!G.dayData[i]) continue;
            newData[newIdx] = G.dayData[i]; newIdx++;
        }
        G.days = newIdx - 1; G.dayData = newData;
        renderAllDays();
        markUnsaved();
    }

    // ═══════════════════════════════════════════════════════════════
    //  DISCOVERY — LOAD REGIONS
    // ═══════════════════════════════════════════════════════════════
    function loadRegions() {
        fetch('/Itinerary/GetRegions').then(r => r.json()).then(d => {
            if (!d.success) return;
            allRegions = d.data;
            const grid = document.getElementById('regionGrid');
            grid.innerHTML = '<span class="region-chip active" onclick="selectRegion(null,this)">🌏 Tất cả</span>';
            d.data.slice(0, 18).forEach(r => {
                grid.insertAdjacentHTML('beforeend',
                    `<span class="region-chip" onclick="selectRegion('${r.name}',this)">${r.name} <small style="opacity:.6">(${r.count})</small></span>`);
            });
            // Populate all existing day selects
            for (let i = 1; i <= G.days; i++) {
                populateDayRegionSelect(i, G.dayData[i]?.tenKhuVuc || '');
            }
            // load all initially
            loadPlacesByRegion(null);
        });
    }

    function selectRegion(region, el) {
        document.querySelectorAll('.region-chip').forEach(c => c.classList.remove('active'));
        el?.classList.add('active');
        searchCurrent = region;
        // Update discovery header
        const discHeader = document.getElementById('discPanelHeader');
        if (discHeader) discHeader.textContent = region ? `📍 Địa điểm tại ${region}` : '🧭 Tất cả địa điểm';
        // Update search placeholder
        const searchInp = document.getElementById('searchInp');
        if (searchInp) searchInp.placeholder = region ? `Tìm địa điểm tại ${region}...` : 'Tìm địa điểm...';
        loadPlacesByRegion(region);
    }

    function loadPlacesByRegion(region) {
        const c = document.getElementById('placeCards');
        c.innerHTML = '<div class="disc-loading"><i class="bi bi-hourglass-split"></i> Đang tải địa điểm...</div>';
        const url = region
            ? `/Itinerary/GetPlacesByRegion?region=${encodeURIComponent(region)}&limit=30`
            : `/Itinerary/SearchPlaces?q=`;
        fetch(url).then(r => r.json()).then(d => {
            if (!d.success || !d.data.length) {
                c.innerHTML = '<div class="disc-loading">Không có địa điểm nào</div>'; return;
            }
            renderPlaceCards(d.data);
        });
    }

    function renderPlaceCards(list) {
        const c = document.getElementById('placeCards');
        if (!list.length) {
            c.innerHTML = '<div class="disc-loading">Không có địa điểm nào</div>';
            return;
        }
        // Update header with count
        const region = document.querySelector('.region-chip.active')?.textContent?.trim()?.replace(/\s*\(\d+\)$/, '') || '';
        const discHeader = document.getElementById('discPanelHeader');
        if (discHeader && region && region !== '🌏 Tất cả') {
            discHeader.textContent = `📍 ${list.length} địa điểm tại ${region}`;
        }
        c.innerHTML = list.map(p => {
            const safeP = JSON.stringify(p).replace(/"/g, '&quot;');
            return `<div class="pcard" data-id="${p.id || p.maDiaDiem}" onclick="pickPlace(${safeP})">
                <img class="pcard-img" src="${p.anh || 'https://images.unsplash.com/photo-1528127269322-539801943592?w=80&h=80&fit=crop'}" onerror="this.src='https://images.unsplash.com/photo-1528127269322-539801943592?w=80&h=80&fit=crop'" />
                <div class="pcard-info">
                    <div class="pcard-name">${p.ten || p.tenDiaDiem || ''}</div>
                    <div class="pcard-loc"><i class="bi bi-geo-alt" style="font-size:.7rem;"></i> ${p.tinhThanh || ''}</div>
                    ${p.danhMuc ? `<span class="pcard-cat">${p.danhMuc}</span>` : ''}
                </div>
                <button class="pcard-add" onclick="event.stopPropagation();pickPlace(${safeP})">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>`;
        }).join('');
    }

    let searchCurrent = null;
    function onSearch() {
        clearTimeout(searchTimer);
        const q = document.getElementById('searchInp').value.trim();
        if (!q) { if (searchCurrent) loadPlacesByRegion(searchCurrent); return; }
        searchTimer = setTimeout(() => {
            document.getElementById('placeCards').innerHTML = '<div class="disc-loading">Đang tìm...</div>';
            fetch(`/Itinerary/SearchPlaces?q=${encodeURIComponent(q)}`).then(r => r.json()).then(d => {
                if (!d.success || !d.data.length) { document.getElementById('placeCards').innerHTML = '<div class="disc-loading">Không tìm thấy kết quả</div>'; return; }
                renderPlaceCards(d.data);
            });
        }, 350);
    }

    // ═══════════════════════════════════════════════════════════════
    //  ADD MODAL
    // ═══════════════════════════════════════════════════════════════
    function pickPlace(p) {
        pendingPlace = p;
        document.getElementById('addModal_placeName').textContent = p.ten || p.tenDiaDiem || '';
        // Build day grid
        const grid = document.getElementById('addModal_dayGrid');
        grid.innerHTML = '';
        for (let i = 1; i <= G.days; i++) {
            const cnt = G.dayData[i]?.places?.length || 0;
            const region = G.dayData[i]?.tenKhuVuc || '';
            const isActive = activeDayNum === i;
            grid.insertAdjacentHTML('beforeend', `
            <div class="day-opt ${isActive ? 'selected' : ''}" onclick="selectDayOpt(this,${i})">
                Ngày ${i}${region ? '<br><small style="opacity:.8">📍 ' + region + '</small>' : ''}<br><small style="opacity:.7">${cnt}/10</small>
            </div>`);
        }
        pendingDayNum = activeDayNum || null;
        // Auto-set time from last place in active day
        let autoStart = '08:00';
        if (activeDayNum && G.dayData[activeDayNum]?.places?.length > 0) {
            const places = G.dayData[activeDayNum].places;
            const last = places[places.length - 1];
            if (last.gioKetThuc) {
                // add 30 min
                const [h, m] = last.gioKetThuc.split(':').map(Number);
                const tot = h * 60 + m + 30;
                autoStart = `${String(Math.floor(tot / 60)).padStart(2, '0')}:${String(tot % 60).padStart(2, '0')}`;
            }
        }
        document.getElementById('addModal_start').value = autoStart;
        document.getElementById('addModal_end').value = '';
        document.getElementById('addModal_note').value = '';
        document.getElementById('addModal').classList.add('open');
    }

    function openAddModalFor(n) {
        openPlacesForDay(n);
    }

    function selectDayOpt(el, n) {
        document.querySelectorAll('#addModal_dayGrid .day-opt').forEach(d => d.classList.remove('selected'));
        el.classList.add('selected'); pendingDayNum = n;
    }

    function closeAddModal() {
        document.getElementById('addModal').classList.remove('open');
        pendingPlace = null; pendingDayNum = null;
    }

    function confirmAdd() {
        if (!pendingPlace) { toast('warn', '', 'Chưa có địa điểm'); return; }
        if (!pendingDayNum) { toast('warn', '', 'Vui lòng chọn ngày'); return; }
        const start = document.getElementById('addModal_start').value;
        if (!start) { toast('warn', '', 'Vui lòng chọn giờ bắt đầu'); return; }
        const end = document.getElementById('addModal_end').value;
        const note = document.getElementById('addModal_note').value;
        const dd = G.dayData[pendingDayNum];
        if (!dd || !dd.dayId) { toast('err', 'Lỗi', 'Không tìm thấy ID ngày'); return; }
        if ((dd.places || []).length >= 10) { toast('warn', 'Đầy rồi!', 'Mỗi ngày tối đa 10 địa điểm'); return; }

        const placeId = pendingPlace.id || pendingPlace.maDiaDiem;
        fetch('/Itinerary/AddPlace', {
            method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `idNgay=${dd.dayId}&idDiaDiem=${placeId}&gioBatDau=${start}&gioKetThuc=${end}&ghiChu=${encodeURIComponent(note)}`
        }).then(r => r.json()).then(data => {
            if (!data.success) {
                if (data.warning) toast('warn', 'Trùng giờ', data.warning);
                else toast('err', 'Lỗi', data.message);
                return;
            }
            if (data.warningDist) toast('warn', 'Khoảng cách xa', data.warningDist);
            // Push to state
            dd.places.push({
                idChiTiet: data.id,
                maDiaDiem: placeId,
                id: placeId,
                name: pendingPlace.ten || pendingPlace.tenDiaDiem || '',
                tenDiaDiem: pendingPlace.ten || pendingPlace.tenDiaDiem || '',
                tinhThanh: pendingPlace.tinhThanh || '',
                anh: pendingPlace.anh || '',
                viDo: pendingPlace.viDo, kinhDo: pendingPlace.kinhDo,
                gioBatDau: start, gioKetThuc: end, ghiChu: note,
                distanceToNext: data.distance || 0,
                transportIcon: data.transportIcon || '🚗',
                transportLabel: data.transportLabel || 'Ô tô',
                airportInfo: data.airportInfo || ''
            });
            refreshDayBody(pendingDayNum);
            refreshMapMarkers();
            closeAddModal();
            toast('ok', 'Đã thêm!', `${pendingPlace.ten || pendingPlace.tenDiaDiem} → Ngày ${pendingDayNum} `);
        });
    }

    // ═══════════════════════════════════════════════════════════════
    //  DELETE PLACE
    // ═══════════════════════════════════════════════════════════════
    function doDeletePlace(idChiTiet, elId, dayNum) {
        if (!confirm('Xóa địa điểm này?')) return;
        fetch('/Itinerary/DeletePlace', {
            method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `idChiTiet=${idChiTiet}`
        }).then(r => r.json()).then(d => {
            if (!d.success) { toast('err', 'Lỗi', d.message); return; }
            const el = document.getElementById(elId);
            if (el) { el.style.animation = 'fadeOutSc .25s ease-out'; setTimeout(() => el.remove(), 240); }
            const dd = G.dayData[dayNum];
            if (dd) dd.places = dd.places.filter(p => p.idChiTiet !== idChiTiet);
            setTimeout(() => refreshDayBody(dayNum), 300);
            refreshMapMarkers();
            toast('ok', 'Đã xóa', '');
        });
    }

    // ═══════════════════════════════════════════════════════════════
    //  NEARBY
    // ═══════════════════════════════════════════════════════════════
    function loadNearby(maDiaDiem, containerId, dayNum) {
        const el = document.getElementById(containerId);
        if (!el) return;
        if (el.classList.contains('open')) { el.classList.remove('open'); return; }
        el.innerHTML = '<div style="font-size:.76rem;color:var(--slate);">Đang tải gợi ý...</div>';
        el.classList.add('open');
        fetch(`/Itinerary/GetNearbyForSchedule?maDiaDiem=${maDiaDiem}&limit=6`).then(r => r.json()).then(d => {
            if (!d.success || !d.data.length) { el.innerHTML = '<div style="font-size:.76rem;color:var(--slate);">Không có gợi ý gần đây</div>'; return; }
            el.innerHTML = `<div class="nearby-lbl">📍 Gợi ý gần đây</div>
            <div class="nearby-chips">${d.data.map(p => {
                const sp = JSON.stringify(p).replace(/"/g, '&quot;');
                return '<span class="nearby-chip" onclick="pickPlace(' + sp + ')">' +
                    '<img src="' + (p.anh || 'https://images.unsplash.com/photo-1528127269322-539801943592?w=20&h=20&fit=crop') + '" onerror="this.style.display=\'none\'" />' +
                        p.ten + ' <span style="opacity:.7">' + p.khoangCach + 'km</span></span>';
            }).join('')}</div>`;
        });
    }

    // ═══════════════════════════════════════════════════════════════
    //  NOTE MODAL
    // ═══════════════════════════════════════════════════════════════
    function openNoteModal(n) { noteForDay = n; document.getElementById('noteTa').value = ''; document.getElementById('noteModal').classList.add('open'); }
    function closeNoteModal() { document.getElementById('noteModal').classList.remove('open'); noteForDay = null; }
    function confirmNote() {
        const txt = document.getElementById('noteTa').value.trim();
        if (!txt) { toast('warn', '', 'Vui lòng nhập ghi chú'); return; }
        G.dayData[noteForDay].notes.push(txt);
        refreshDayBody(noteForDay);
        closeNoteModal();
        toast('ok', 'Đã thêm ghi chú', '');
    }
    function removeNote(elId, n, ni) {
        if (!confirm('Xóa ghi chú?')) return;
        G.dayData[n].notes.splice(ni, 1);
        refreshDayBody(n);
    }

    // ═══════════════════════════════════════════════════════════════
    //  SAVE (visual only — data is already saved incrementally)
    // ═══════════════════════════════════════════════════════════════
    function saveJourney() {
        const btn = document.getElementById('btnSave');
        btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Đang lưu...';
        setTimeout(() => {
            btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-circle"></i> Lưu';
            markSaved();
            toast('ok', 'Đã lưu', 'Lịch trình được lưu thành công');
        }, 800);
    }
    function markUnsaved() {
        G.unsaved = true;
        const el = document.getElementById('saveState');
        if (el) { el.className = 'save-state'; el.innerHTML = '<i class="bi bi-clock-history"></i> Chưa lưu'; }
    }
    function markSaved() {
        G.unsaved = false;
        const el = document.getElementById('saveState');
        if (el) { el.className = 'save-state saved'; el.innerHTML = '<i class="bi bi-check-circle-fill"></i> Đã lưu'; }
    }

    // Auto save every 30s
    setInterval(() => { if (G.unsaved && G.id) saveJourney(); }, 30000);

    // ═══════════════════════════════════════════════════════════════
    //  PUBLIC / PRIVATE TOGGLE
    // ═══════════════════════════════════════════════════════════════
    function togglePublic() {
        if (!G.id) return;
        const newStatus = G.privacy === 'public' ? 'private' : 'public';
        fetch('/Itinerary/UpdateStatus', {
            method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `idLichTrinh=${G.id}&status=${newStatus}`
        }).then(r => r.json()).then(d => {
            if (!d.success) { toast('err', 'Lỗi', d.message); return; }
            G.privacy = newStatus; updatePrivLabel();
            toast('ok', d.message, '');
        });
    }
    function updatePrivLabel() {
        const lbl = document.getElementById('privLabel');
        const ico = document.getElementById('privIcon');
        if (!lbl || !ico) return;
        if (G.privacy === 'public') { lbl.textContent = 'Công khai'; ico.className = 'bi bi-globe'; }
        else { lbl.textContent = 'Riêng tư'; ico.className = 'bi bi-lock-fill'; }
    }

    // ═══════════════════════════════════════════════════════════════
    //  DELETE SCHEDULE
    // ═══════════════════════════════════════════════════════════════
    function deleteSchedule() {
        if (!G.id) return;
        if (!confirm('Xóa toàn bộ lịch trình này? Hành động không thể hoàn tác.')) return;
        fetch('/Itinerary/DeleteSchedule', {
            method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `idLichTrinh=${G.id}`
        }).then(r => r.json()).then(d => {
            if (d.success) { toast('ok', 'Đã xóa', 'Chuyển hướng...'); setTimeout(() => window.location.href = '/Home/Schedule', 1500); }
            else toast('err', 'Lỗi', d.message);
        });
    }

    // ═══════════════════════════════════════════════════════════════
    //  SHARE
    // ═══════════════════════════════════════════════════════════════
    function toggleDD(btn) {
        const dd = document.getElementById('shareDD');
        dd.classList.toggle('open');
    }
    function shareDo(type) {
        document.getElementById('shareDD').classList.remove('open');
        if (!G.id) return;
        if (type === 'link') {
            fetch(`/Itinerary/GetShareLink?idLichTrinh=${G.id}`).then(r => r.json()).then(d => {
                if (!d.success) return;
                navigator.clipboard.writeText(d.link).then(() => toast('ok', 'Đã sao chép link', ''));
            });
        } else if (type === 'facebook') {
            const url = `${location.origin} /Home/DetailSchedule ? id = ${G.id} `;
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank', 'width=600,height=400');
        }
    }

    // ═══════════════════════════════════════════════════════════════
    //  PREVIEW MODAL
    // ═══════════════════════════════════════════════════════════════
    function goToDetailSchedule() {
        if (G.id) window.location.href = `/Home/DetailSchedule?id=${G.id}`;
    }

    function openPreview() {
        document.getElementById('prevTitle').textContent = G.name;
        let html = `<div style="display:flex;gap:1.5rem;margin-bottom:1rem;flex-wrap:wrap;">
        <span style="font-size:.88rem;color:var(--slate);"><i class="bi bi-calendar-event" style="color:var(--sky-blue);"></i> ${fmtDate(G.startDate)} — ${fmtDate(G.endDate)}</span>
        <span style="font-size:.88rem;color:var(--slate);"><i class="bi bi-${G.privacy === 'public' ? 'globe' : 'lock-fill'}" style="color:var(--sky-blue);"></i> ${G.privacy === 'public' ? 'Công khai' : 'Riêng tư'}</span>
    </div>`;
        for (let i = 1; i <= G.days; i++) {
            const dd = G.dayData[i]; if (!dd) continue;
            html += `<div class="preview-day-sec"><div class="preview-day-ttl">Ngày ${i}</div>`;
            if (dd.places.length === 0) html += '<p style="color:var(--slate);font-style:italic;font-size:.85rem;">Chưa có địa điểm</p>';
            else dd.places.sort((a, b) => (a.gioBatDau || '').localeCompare(b.gioBatDau || '')).forEach(p => {
                const anh = p.anh || 'https://images.unsplash.com/photo-1528127269322-539801943592?w=44&h=44&fit=crop';
                html += `<div class="preview-place-row">
                <img class="preview-thumb" src="${p.anh || anh}" onerror="this.src='${anh}'" />
                <div><div class="preview-pname">${p.name || p.tenDiaDiem}</div><div class="preview-ptime">${p.gioBatDau} ${p.gioKetThuc ? '→ ' + p.gioKetThuc : ''}</div></div>
            </div>`;
            });
            dd.notes.forEach(n => html += `<div class="note-item" style="margin-top:.35rem;">${n}</div>`);
            html += '</div>';
        }
        document.getElementById('prevBody').innerHTML = html;
        document.getElementById('previewModal').classList.add('open');
    }
    function closePreview() { document.getElementById('previewModal').classList.remove('open'); }
    function goToDetail() { if (G.id) window.location.href = `/Home/DetailSchedule?id=${G.id}`; }

    // ═══════════════════════════════════════════════════════════════
    //  MAP (Google Maps)
    // ═══════════════════════════════════════════════════════════════
    function switchTab(t) {
        if (t === 'disc') {
            document.getElementById('discPanel').style.display = 'block';
            document.getElementById('mapPanel').style.display = 'none';
            document.getElementById('tabDisc').classList.add('active');
            document.getElementById('tabMap').classList.remove('active');
        } else {
            document.getElementById('discPanel').style.display = 'none';
            document.getElementById('mapPanel').style.display = 'block';
            document.getElementById('tabDisc').classList.remove('active');
            document.getElementById('tabMap').classList.add('active');
            initMap();
        }
    }

    function initMap() {
        if (mapObj) { refreshMapMarkers(); return; }
        if (!window.google) {
            document.getElementById('gmap').innerHTML = '<div style="text-align:center;padding:3rem;color:var(--slate);"><i class="bi bi-map" style="font-size:2rem;"></i><br>Cần tích hợp Google Maps API Key</div>';
            return;
        }
        mapObj = new google.maps.Map(document.getElementById('gmap'), {
            center: { lat: 16.047079, lng: 108.206230 }, zoom: 6,
            styles: [{ featureType: 'poi', stylers: [{ visibility: 'simplified' }] }]
        });
        refreshMapMarkers();
    }

    function viewOnMap(lat, lng) {
        switchTab('map');
        if (!window.google || !lat || !lng) return;
        setTimeout(() => {
            if (!mapObj) initMap();
            mapObj.setCenter({ lat: parseFloat(lat), lng: parseFloat(lng) });
            mapObj.setZoom(14);
        }, 300);
    }

    function refreshMapMarkers() {
        if (!mapObj || !window.google) return;
        mapMarkers.forEach(m => m.setMap(null)); mapMarkers = [];
        mapPolylines.forEach(p => p.setMap(null)); mapPolylines = [];
        const allPlaces = [];
        for (let i = 1; i <= G.days; i++) {
            const dd = G.dayData[i]; if (!dd) continue;
            dd.places.filter(p => p.viDo && p.kinhDo).forEach(p => allPlaces.push({ ...p, day: i }));
        }
        if (!allPlaces.length) return;
        const bounds = new google.maps.LatLngBounds();
        allPlaces.forEach((p, idx) => {
            const pos = { lat: parseFloat(p.viDo), lng: parseFloat(p.kinhDo) };
            const marker = new google.maps.Marker({
                position: pos, map: mapObj,
                label: { text: String(idx + 1), color: 'white', fontWeight: 'bold', fontSize: '12px' },
                title: p.name || p.tenDiaDiem,
                icon: { path: google.maps.SymbolPath.CIRCLE, scale: 18, fillColor: '#0EA5E9', fillOpacity: 1, strokeColor: 'white', strokeWeight: 2 }
            });
            marker.addListener('click', () => {
                new google.maps.InfoWindow({ content: `<b>${p.name || p.tenDiaDiem}</b><br>${p.gioBatDau || ''}` }).open(mapObj, marker);
            });
            mapMarkers.push(marker); bounds.extend(pos);
        });
        // Draw routes
        for (let i = 0; i < allPlaces.length - 1; i++) {
            const a = allPlaces[i], b = allPlaces[i + 1];
            if (!a.viDo || !b.viDo) continue;
            const dist = a.distanceToNext || 0;
            if (dist > 150) {
                // Flight arc — geodesic polyline
                const line = new google.maps.Polyline({
                    path: [{ lat: parseFloat(a.viDo), lng: parseFloat(a.kinhDo) }, { lat: parseFloat(b.viDo), lng: parseFloat(b.kinhDo) }],
                    geodesic: true, strokeColor: '#f59e0b', strokeOpacity: .7, strokeWeight: 2,
                    icons: [{ icon: { path: google.maps.SymbolPath.FORWARD_OPEN_ARROW, scale: 3 }, offset: '50%' }]
                });
                line.setMap(mapObj); mapPolylines.push(line);
                // Plane marker
                const midLat = (parseFloat(a.viDo) + parseFloat(b.viDo)) / 2;
                const midLng = (parseFloat(a.kinhDo) + parseFloat(b.kinhDo)) / 2;
                const pm = new google.maps.Marker({ position: { lat: midLat, lng: midLng }, map: mapObj, label: { text: '✈', fontSize: '18px', color: '#f59e0b' }, icon: { path: google.maps.SymbolPath.CIRCLE, scale: 0 } });
                mapMarkers.push(pm);
            } else {
                new google.maps.DirectionsService().route({
                    origin: { lat: parseFloat(a.viDo), lng: parseFloat(a.kinhDo) },
                    destination: { lat: parseFloat(b.viDo), lng: parseFloat(b.kinhDo) },
                    travelMode: google.maps.TravelMode.DRIVING
                }, (res, status) => {
                    if (status === 'OK') {
                        const renderer = new google.maps.DirectionsRenderer({ map: mapObj, suppressMarkers: true, polylineOptions: { strokeColor: '#0EA5E9', strokeWeight: 3 } });
                        renderer.setDirections(res); mapPolylines.push(renderer);
                    }
                });
            }
        }
        mapObj.fitBounds(bounds);
    }

    // ═══════════════════════════════════════════════════════════════
    //  TOAST
    // ═══════════════════════════════════════════════════════════════
    function toast(type, title, msg) {
        const c = document.getElementById('toastWrap');
        const id = 'toast-' + Date.now();
        const icons = { ok: 'bi-check-circle-fill', err: 'bi-x-circle-fill', warn: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
        const cls = { ok: 'ok', err: 'err', warn: 'warn', info: '' };
        const el = document.createElement('div');
        el.className = `toast ${cls[type] || ''}`; el.id = id;
        el.innerHTML = `<i class="bi ${icons[type] || icons.info} toast-ico"></i><div class="toast-body"><div class="toast-ttl">${title}</div>${msg ? `<div class="toast-msg">${msg}</div>` : ''}</div><button class="toast-x" onclick="rmToast('${id}')">×</button>`;
        c.appendChild(el);
        setTimeout(() => rmToast(id), 5000);
    }
    function rmToast(id) {
        const el = document.getElementById(id); if (!el) return;
        el.style.animation = 'slideOutR .3s ease-out'; setTimeout(() => el.remove(), 280);
    }

    // ═══════════════════════════════════════════════════════════════
    //  HELPERS
    // ═══════════════════════════════════════════════════════════════
    function fmtDate(s) {
        if (!s) return '';
        const d = new Date(s + 'T00:00:00');
        return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    // Close dropdowns on outside click
    document.addEventListener('click', e => {
        if (!e.target.closest('.dd-wrap')) document.getElementById('shareDD')?.classList.remove('open');
        if (e.target.classList.contains('modal-bg')) {
            document.querySelectorAll('.modal-bg.open').forEach(m => m.classList.remove('open'));
        }
    });
</script>
