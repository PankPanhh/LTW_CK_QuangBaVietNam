<!-- ═══════════════ INIT SCREEN ═══════════════════════════ -->
<div class="init-screen" id="initScreen">
    <div class="init-card">
        <h1 class="init-title">Bắt đầu hành trình</h1>
        <p class="init-sub">Tạo lịch trình du lịch của riêng bạn — viết lên kỷ niệm của chính mình</p>

        <form id="initForm" onsubmit="submitInit(event)" novalidate>
            <div class="form-group">
                <label class="form-lbl" for="inp_name">Tên hành trình *</label>
                <input class="form-inp" id="inp_name" type="text" placeholder="VD: Đà Lạt 3 ngày chữa lành" required />
            </div>
            <div class="form-group">
                <label class="form-lbl">Ngày đi</label>
                <div class="date-row">
                    <div>
                        <label class="form-lbl" style="font-size:.8rem;" for="inp_start">Từ ngày</label>
                        <input class="form-inp" id="inp_start" type="date" required />
                    </div>
                    <div>
                        <label class="form-lbl" style="font-size:.8rem;" for="inp_end">Đến ngày</label>
                        <input class="form-inp" id="inp_end" type="date" required />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="form-lbl">Ảnh bìa (tuỳ chọn)</label>
                <div class="upload-zone" id="uploadZone"
                     onclick="document.getElementById('inp_cover').click()"
                     ondragover="onDragOver(event)"
                     ondragleave="onDragLeave(event)"
                     ondrop="onDrop(event)">
                    <div class="upload-icon-wrap">
                        <i class="bi bi-image upload-icon-img"></i>
                        <i class="bi bi-cloud-arrow-up-fill upload-icon-cloud"></i>
                    </div>
                    <p class="upload-text">Kéo thả ảnh vào đây hoặc nhấp để chọn</p>
                    <span class="upload-subtext">Hỗ trợ JPG, PNG, WEBP (tối đa 5MB)</span>
                </div>
                <input id="inp_cover" type="file" accept="image/*" style="display: none;" onchange="previewCover(event)" />
                
                <div id="coverPreviewWrap" style="display:none; margin-top: 15px; position: relative; width: 100%; height: 180px; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 24px rgba(30,41,59,.12); border: 1px solid rgba(255, 255, 255, 0.4); backdrop-filter: blur(10px); cursor: pointer;">
                    <img id="coverPreview" style="width:100%; height:100%; object-fit:cover; border-radius: 20px;" onclick="document.getElementById('inp_cover').click()" />
                    <div class="preview-overlay" onclick="document.getElementById('inp_cover').click()">
                        <i class="bi bi-camera-fill" style="font-size: 1.8rem; color: white;"></i>
                        <span style="font-size: 0.85rem; color: white; font-weight: 600; margin-top: 6px;">Thay đổi ảnh bìa</span>
                    </div>
                    <button type="button" onclick="removeCover(event)" style="position: absolute; top: 12px; right: 12px; background: rgba(30,41,59,0.7); color: white; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; backdrop-filter: blur(4px); z-index: 10;"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-lbl">Chế độ</label>
                <div class="privacy-row">
                    <div class="prv-opt">
                        <input type="radio" id="prv_pri" name="prv" value="private" checked>
                        <label for="prv_pri"><i class="bi bi-lock-fill"></i> Riêng tư</label>
                    </div>
                    <div class="prv-opt">
                        <input type="radio" id="prv_pub" name="prv" value="public">
                        <label for="prv_pub"><i class="bi bi-globe"></i> Công khai</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn-primary-full"><i class="bi bi-play-fill"></i> Bắt đầu lập kế hoạch</button>
            <button type="button" class="btn-ghost" onclick="window.history.back()"><i class="bi bi-arrow-left"></i> Quay lại</button>
        </form>
    </div>
</div>

