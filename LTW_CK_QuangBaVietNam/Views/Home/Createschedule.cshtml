@{
    ViewBag.Title = "Tạo lịch trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    :root {
        --deep-slate: #1e293b;
        --slate: #334155;
        --sky-blue: #0EA5E9;
        --sky-light: #38BDF8;
        --slate-light: #cbd5e1;
        --slate-200: #e2e8f0;
        --amber: #f59e0b;
        --rose: #f43f5e;
        --emerald: #10b981;
        --white: #ffffff;
        --sp2: 0.5rem;
        --sp3: 0.75rem;
        --sp4: 1rem;
        --sp6: 1.5rem;
        --sp8: 2rem;
        --sp12: 3rem;
    }

    /* ── Init Screen ───────────────────────────────── */
    .init-screen {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,rgba(248,250,252,.97),rgba(226,232,240,.7)), url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=1920&q=80') center/cover fixed;
        padding: var(--sp8);
    }

    .init-card {
        background: var(--white);
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(30,41,59,.13);
        padding: var(--sp12);
        max-width: 580px;
        width: 100%;
        border: 1px solid rgba(14,165,233,.1);
        animation: slideUp .5s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(36px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .init-title {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--deep-slate);
        margin-bottom: .5rem;
    }

    .init-sub {
        color: var(--slate);
        font-size: .95rem;
        margin-bottom: var(--sp12);
    }

    .form-lbl {
        display: block;
        font-weight: 600;
        font-size: .9rem;
        color: var(--deep-slate);
        margin-bottom: .4rem;
    }

    .form-inp {
        width: 100%;
        padding: .75rem 1rem;
        font-size: .95rem;
        border: 2px solid var(--slate-200);
        border-radius: 10px;
        background: #f8fafc;
        color: var(--deep-slate);
        transition: all .25s;
        font-family: inherit;
    }

        .form-inp:focus {
            outline: none;
            border-color: var(--sky-blue);
            background: var(--white);
            box-shadow: 0 0 0 4px rgba(14,165,233,.1);
        }

    .form-group {
        margin-bottom: var(--sp6);
    }

    .date-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--sp4);
    }

    .privacy-row {
        display: flex;
        gap: var(--sp3);
    }

    .prv-opt {
        flex: 1;
        position: relative;
    }

        .prv-opt input[type=radio] {
            display: none;
        }

        .prv-opt label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: var(--sp4);
            border: 2px solid var(--slate-200);
            border-radius: 10px;
            background: #f8fafc;
            cursor: pointer;
            transition: all .25s;
            font-weight: 600;
            font-size: .9rem;
        }

        .prv-opt input:checked + label {
            background: var(--sky-blue);
            border-color: var(--sky-blue);
            color: var(--white);
        }

    .btn-primary-full {
        width: 100%;
        padding: .9rem;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient(135deg,var(--sky-blue),var(--sky-light));
        color: var(--white);
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all .3s;
        margin-bottom: var(--sp3);
    }

        .btn-primary-full:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(14,165,233,.35);
        }

    .btn-ghost {
        width: 100%;
        padding: .8rem;
        font-size: .95rem;
        font-weight: 600;
        background: transparent;
        color: var(--slate);
        border: 2px solid var(--slate-200);
        border-radius: 12px;
        cursor: pointer;
        transition: all .25s;
    }

        .btn-ghost:hover {
            border-color: var(--sky-blue);
            color: var(--sky-blue);
        }

    .sugg-box {
        background: rgba(14,165,233,.05);
        border: 1px solid rgba(14,165,233,.15);
        border-radius: 10px;
        padding: var(--sp4) var(--sp6);
        margin-bottom: var(--sp6);
        display: none;
    }

    .sugg-lbl {
        font-size: .78rem;
        font-weight: 700;
        color: var(--sky-blue);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: .5rem;
    }

    .sugg-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }

    .sugg-chip {
        background: var(--white);
        border: 1px solid var(--sky-light);
        border-radius: 20px;
        padding: .3rem 1rem;
        font-size: .85rem;
        color: var(--sky-blue);
        cursor: pointer;
        font-weight: 500;
        transition: all .2s;
    }

        .sugg-chip:hover {
            background: var(--sky-light);
            color: var(--white);
        }

    /* ── Editor Screen ─────────────────────────────── */
    .editor-screen {
        display: none;
        min-height: 100vh;
        background: #f1f5f9;
    }

    .editor-topbar {
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(14,165,233,.12);
        box-shadow: 0 2px 16px rgba(30,41,59,.07);
        padding: .75rem 1.5rem;
        position: sticky;
        top: 0;
        z-index: 200;
    }

    .editor-topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp4);
        flex-wrap: wrap;
    }

    .editor-title-wrap h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--deep-slate);
    }

    .editor-title-wrap p {
        margin: 0;
        font-size: .82rem;
        color: var(--slate);
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .tbtn {
        display: flex;
        align-items: center;
        gap: .35rem;
        padding: .5rem 1rem;
        background: var(--white);
        border: 1.5px solid var(--slate-200);
        border-radius: 8px;
        font-weight: 600;
        font-size: .85rem;
        color: var(--deep-slate);
        cursor: pointer;
        transition: all .25s;
        white-space: nowrap;
    }

        .tbtn:hover {
            border-color: var(--sky-blue);
            color: var(--sky-blue);
            background: rgba(14,165,233,.04);
            transform: translateY(-1px);
        }

        .tbtn.primary {
            background: linear-gradient(135deg,var(--sky-blue),var(--sky-light));
            color: var(--white);
            border-color: var(--sky-blue);
        }

            .tbtn.primary:hover {
                box-shadow: 0 6px 18px rgba(14,165,233,.3);
                transform: translateY(-1px);
            }

        .tbtn.success {
            background: linear-gradient(135deg,var(--emerald),#34d399);
            color: var(--white);
            border-color: var(--emerald);
        }

            .tbtn.success:hover {
                box-shadow: 0 6px 18px rgba(16,185,129,.3);
            }

        .tbtn.danger {
            background: linear-gradient(135deg,#ef4444,#f87171);
            color: var(--white);
            border-color: #ef4444;
        }

        .tbtn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none !important;
        }

    .save-state {
        font-size: .78rem;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: .3rem;
    }

        .save-state.saved {
            color: var(--emerald);
        }

    .dd-wrap {
        position: relative;
    }

    .dd-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        background: rgba(30,41,59,.97);
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,.25);
        min-width: 190px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: all .25s;
        z-index: 9999;
    }

        .dd-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    .dd-item {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .6rem 1rem;
        color: #cbd5e1;
        font-size: .88rem;
        cursor: pointer;
        transition: .2s;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
    }

        .dd-item:first-child {
            border-radius: 12px 12px 0 0;
        }

        .dd-item:last-child {
            border-radius: 0 0 12px 12px;
        }

        .dd-item:hover {
            background: rgba(14,165,233,.1);
            color: var(--sky-blue);
        }

    /* ── Editor Layout ─────────────────────────────── */
    .editor-body {
        display: grid;
        grid-template-columns: 1fr 420px;
        min-height: calc(100vh - 60px);
    }

    .timeline-col {
        padding: var(--sp6);
        overflow-y: auto;
        background: #f8fafc;
        border-right: 1px solid var(--slate-200);
    }

    .discovery-col {
        display: flex;
        flex-direction: column;
        padding: var(--sp4);
        overflow-y: auto;
        background: var(--white);
    }

    /* Day cards */
    .day-card {
        background: var(--white);
        border-radius: 14px;
        padding: var(--sp6);
        box-shadow: 0 2px 12px rgba(30,41,59,.07);
        border-left: 4px solid var(--sky-blue);
        margin-bottom: var(--sp6);
        animation: fadeUp .35s ease-out;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .day-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--sp4);
        padding-bottom: var(--sp4);
        border-bottom: 1px solid var(--slate-200);
    }

    .day-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--deep-slate);
    }

    .day-acts {
        display: flex;
        gap: .5rem;
    }

        .day-acts button {
            background: transparent;
            border: none;
            color: var(--slate);
            cursor: pointer;
            font-size: 1.1rem;
            padding: .25rem;
            border-radius: 6px;
            transition: all .2s;
        }

            .day-acts button:hover {
                color: var(--sky-blue);
                background: rgba(14,165,233,.08);
            }

            .day-acts button.danger:hover {
                color: #ef4444;
                background: rgba(239,68,68,.08);
            }

    .day-body {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    /* Place items in timeline */
    .place-item {
        display: flex;
        gap: .75rem;
        align-items: flex-start;
        background: linear-gradient(135deg,rgba(248,250,252,.8),var(--white));
        border: 1.5px solid rgba(14,165,233,.1);
        border-radius: 10px;
        padding: .7rem;
        transition: all .25s;
        position: relative;
    }

        .place-item:hover {
            box-shadow: 0 4px 14px rgba(14,165,233,.12);
            transform: translateX(3px);
        }

    .place-time {
        font-weight: 700;
        color: var(--sky-blue);
        font-size: .85rem;
        min-width: 52px;
        flex-shrink: 0;
        padding-top: 2px;
    }

    .place-thumb {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        background: #e2e8f0;
    }

    .place-info {
        flex: 1;
        min-width: 0;
    }

    .place-name {
        font-weight: 700;
        font-size: .9rem;
        color: var(--deep-slate);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .place-addr {
        font-size: .78rem;
        color: var(--slate);
        margin: .15rem 0;
    }

    .place-note-text {
        font-size: .78rem;
        color: var(--slate);
        font-style: italic;
    }

    .place-btns {
        display: flex;
        gap: .35rem;
        margin-top: .4rem;
    }

    .pbtn {
        padding: .2rem .6rem;
        border: 1px solid var(--slate-200);
        background: transparent;
        border-radius: 5px;
        font-size: .75rem;
        font-weight: 600;
        color: var(--slate);
        cursor: pointer;
        transition: all .2s;
    }

        .pbtn:hover {
            border-color: var(--sky-blue);
            color: var(--sky-blue);
        }

        .pbtn.red:hover {
            border-color: #ef4444;
            color: #ef4444;
        }

    .place-nearby {
        margin-top: .5rem;
        display: none;
    }

        .place-nearby.open {
            display: block;
        }

    .nearby-lbl {
        font-size: .75rem;
        font-weight: 700;
        color: var(--sky-blue);
        margin-bottom: .35rem;
    }

    .nearby-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
    }

    .nearby-chip {
        display: flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .65rem;
        background: rgba(14,165,233,.07);
        border: 1px solid rgba(14,165,233,.2);
        border-radius: 20px;
        font-size: .76rem;
        font-weight: 600;
        color: var(--sky-blue);
        cursor: pointer;
        transition: all .2s;
    }

        .nearby-chip img {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            object-fit: cover;
        }

        .nearby-chip:hover {
            background: var(--sky-blue);
            color: var(--white);
        }

            .nearby-chip:hover img {
                filter: brightness(2);
            }

    /* Transport connector */
    .transport-row {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .25rem .75rem;
        color: var(--slate);
        font-size: .78rem;
        font-weight: 600;
    }

        .transport-row .tr-icon {
            font-size: 1.1rem;
        }

        .transport-row .tr-line {
            flex: 1;
            height: 1px;
            background: repeating-linear-gradient(90deg,var(--slate-200) 0,var(--slate-200) 6px,transparent 6px,transparent 12px);
        }

    /* Empty state */
    .empty-day {
        text-align: center;
        padding: var(--sp8) var(--sp4);
        color: var(--slate);
        font-size: .9rem;
    }

        .empty-day i {
            font-size: 2.5rem;
            color: var(--slate-200);
            display: block;
            margin-bottom: .75rem;
        }

    .add-place-btn {
        width: 100%;
        margin-top: .5rem;
        padding: .65rem;
        background: rgba(14,165,233,.08);
        border: 2px dashed var(--sky-light);
        border-radius: 10px;
        color: var(--sky-blue);
        font-weight: 600;
        cursor: pointer;
        transition: all .25s;
        font-size: .88rem;
    }

        .add-place-btn:hover {
            background: rgba(14,165,233,.14);
            border-color: var(--sky-blue);
        }

    /* Note item */
    .note-item {
        background: linear-gradient(135deg,#fef9c3,#fefce8);
        border-left: 3px solid var(--amber);
        border-radius: 8px;
        padding: .6rem .8rem;
        font-size: .88rem;
        color: var(--deep-slate);
        font-style: italic;
        position: relative;
    }

    .note-del {
        position: absolute;
        top: .3rem;
        right: .4rem;
        background: transparent;
        border: none;
        color: var(--amber);
        cursor: pointer;
        font-size: 1rem;
    }

    /* ── Day Region Selector ──────────────────────── */
    .day-region-row {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: var(--sp4);
        padding: .4rem .6rem;
        background: rgba(14,165,233,.05);
        border-radius: 8px;
        border: 1px solid rgba(14,165,233,.12);
    }

    .day-region-lbl {
        font-size: .78rem;
        font-weight: 700;
        color: var(--sky-blue);
        white-space: nowrap;
    }

    .day-region-sel {
        flex: 1;
        padding: .3rem .6rem;
        border: 1.5px solid var(--slate-200);
        border-radius: 7px;
        font-size: .83rem;
        color: var(--deep-slate);
        background: white;
        cursor: pointer;
        transition: border-color .2s;
    }

        .day-region-sel:focus {
            outline: none;
            border-color: var(--sky-blue);
        }

    .day-active-badge {
        font-size: .73rem;
        background: rgba(14,165,233,.12);
        color: var(--sky-blue);
        border-radius: 4px;
        padding: .15rem .5rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* ── Discovery Column ──────────────────────────── */
    .disc-tabs {
        display: flex;
        gap: .4rem;
        margin-bottom: var(--sp4);
    }

    .disc-tab {
        flex: 1;
        padding: .55rem;
        border-radius: 8px;
        border: 1.5px solid var(--slate-200);
        background: var(--white);
        color: var(--slate);
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: all .2s;
    }

        .disc-tab.active {
            background: var(--sky-blue);
            border-color: var(--sky-blue);
            color: var(--white);
        }

    /* Region chips */
    .region-grid {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        margin-bottom: var(--sp4);
    }

    .region-chip {
        padding: .35rem .9rem;
        border-radius: 20px;
        border: 1.5px solid var(--slate-200);
        background: #f8fafc;
        color: var(--slate);
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
    }

        .region-chip:hover, .region-chip.active {
            background: var(--sky-blue);
            border-color: var(--sky-blue);
            color: var(--white);
        }

    /* Search */
    .search-wrap {
        position: relative;
        margin-bottom: var(--sp4);
    }

        .search-wrap input {
            width: 100%;
            padding: .6rem 1rem .6rem 2.4rem;
            border: 1.5px solid var(--slate-200);
            border-radius: 10px;
            font-size: .88rem;
            background: #f8fafc;
            color: var(--deep-slate);
            transition: all .25s;
        }

            .search-wrap input:focus {
                outline: none;
                border-color: var(--sky-blue);
                background: var(--white);
            }

        .search-wrap i {
            position: absolute;
            left: .7rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

    /* Place cards in discovery */
    .place-cards {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .pcard {
        display: flex;
        gap: .7rem;
        background: #f8fafc;
        border: 1.5px solid var(--slate-200);
        border-radius: 12px;
        padding: .6rem;
        cursor: pointer;
        transition: all .25s;
    }

        .pcard:hover {
            border-color: var(--sky-blue);
            box-shadow: 0 4px 14px rgba(14,165,233,.12);
            transform: translateY(-2px);
        }

    .pcard-img {
        width: 72px;
        height: 72px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        background: #e2e8f0;
    }

    .pcard-info {
        flex: 1;
        min-width: 0;
    }

    .pcard-name {
        font-weight: 700;
        font-size: .88rem;
        color: var(--deep-slate);
        margin-bottom: .15rem;
    }

    .pcard-loc {
        font-size: .76rem;
        color: var(--slate);
        margin-bottom: .25rem;
    }

    .pcard-cat {
        font-size: .72rem;
        background: rgba(14,165,233,.1);
        color: var(--sky-blue);
        padding: .15rem .5rem;
        border-radius: 4px;
        font-weight: 600;
        display: inline-block;
    }

    .pcard-add {
        align-self: center;
        flex-shrink: 0;
        padding: .45rem .8rem;
        background: linear-gradient(135deg,var(--sky-blue),var(--sky-light));
        color: var(--white);
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: .8rem;
        cursor: pointer;
        transition: all .2s;
    }

        .pcard-add:hover {
            transform: scale(1.06);
            box-shadow: 0 4px 12px rgba(14,165,233,.3);
        }

    .disc-loading {
        text-align: center;
        padding: var(--sp8);
        color: var(--slate);
        font-size: .9rem;
    }

    /* Map panel */
    #mapPanel {
        width: 100%;
        height: 460px;
        border-radius: 12px;
        overflow: hidden;
        background: #e2e8f0;
    }

    /* ── Modals ────────────────────────────────────── */
    .modal-bg {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(30,41,59,.65);
        backdrop-filter: blur(6px);
        z-index: 9000;
        align-items: center;
        justify-content: center;
    }

        .modal-bg.open {
            display: flex;
        }

    .modal-box {
        background: var(--white);
        border-radius: 18px;
        padding: var(--sp8);
        width: 90%;
        box-shadow: 0 24px 80px rgba(0,0,0,.28);
        animation: slideUp .35s ease-out;
        position: relative;
    }

        .modal-box.wide {
            max-width: 660px;
        }

        .modal-box.narrow {
            max-width: 440px;
        }

    .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--sp6);
    }

        .modal-head h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--deep-slate);
            margin: 0;
        }

    .mclose {
        background: transparent;
        border: none;
        font-size: 1.8rem;
        color: var(--slate);
        cursor: pointer;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: .2s;
    }

        .mclose:hover {
            background: var(--slate-200);
        }

    .modal-foot {
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
        margin-top: var(--sp6);
    }

    .mbtn {
        padding: .55rem 1.4rem;
        border-radius: 9px;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        border: none;
        transition: all .25s;
    }

        .mbtn.prim {
            background: linear-gradient(135deg,var(--sky-blue),var(--sky-light));
            color: var(--white);
        }

            .mbtn.prim:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(14,165,233,.3);
            }

        .mbtn.sec {
            background: var(--slate-200);
            color: var(--slate);
        }

            .mbtn.sec:hover {
                background: var(--slate);
                color: var(--white);
            }

    /* Day select grid */
    .day-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: .5rem;
        margin: .75rem 0;
    }

    .day-opt {
        padding: .9rem .5rem;
        border: 2px solid var(--slate-200);
        border-radius: 10px;
        background: #f8fafc;
        text-align: center;
        font-weight: 600;
        font-size: .85rem;
        color: var(--slate);
        cursor: pointer;
        transition: all .2s;
    }

        .day-opt:hover {
            border-color: var(--sky-blue);
            background: rgba(14,165,233,.05);
        }

        .day-opt.selected {
            border-color: var(--sky-blue);
            background: var(--sky-blue);
            color: var(--white);
        }

    .time-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .5rem;
        margin-top: .75rem;
    }

    .time-lbl {
        font-size: .82rem;
        font-weight: 600;
        color: var(--deep-slate);
        margin-bottom: .3rem;
    }

    .time-inp {
        width: 100%;
        padding: .55rem .75rem;
        border: 1.5px solid var(--slate-200);
        border-radius: 8px;
        font-size: .9rem;
        color: var(--deep-slate);
    }

        .time-inp:focus {
            outline: none;
            border-color: var(--sky-blue);
        }

    .note-inp {
        width: 100%;
        min-height: 72px;
        padding: .6rem .75rem;
        border: 1.5px solid var(--slate-200);
        border-radius: 8px;
        resize: vertical;
        font-size: .88rem;
        font-family: inherit;
    }

        .note-inp:focus {
            outline: none;
            border-color: var(--sky-blue);
        }

    /* Preview modal */
    .preview-day-sec {
        margin-bottom: var(--sp6);
        border-bottom: 1px solid var(--slate-200);
        padding-bottom: var(--sp6);
    }

    .preview-day-ttl {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--deep-slate);
        border-left: 4px solid var(--sky-blue);
        padding-left: .6rem;
        margin-bottom: .75rem;
    }

    .preview-place-row {
        display: flex;
        gap: .6rem;
        align-items: center;
        margin-bottom: .4rem;
    }

    .preview-thumb {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .preview-pname {
        font-size: .88rem;
        font-weight: 600;
        color: var(--deep-slate);
    }

    .preview-ptime {
        font-size: .76rem;
        color: var(--sky-blue);
    }

    /* Toast */
    .toast-wrap {
        position: fixed;
        top: 74px;
        right: 1.2rem;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .toast {
        background: var(--white);
        border-radius: 10px;
        padding: .75rem 1rem;
        box-shadow: 0 6px 28px rgba(30,41,59,.18);
        display: flex;
        align-items: center;
        gap: .6rem;
        min-width: 270px;
        animation: slideInR .3s ease-out;
        border-left: 4px solid var(--sky-blue);
    }

        .toast.ok {
            border-left-color: var(--emerald);
        }

        .toast.err {
            border-left-color: #ef4444;
        }

        .toast.warn {
            border-left-color: var(--amber);
        }

    .toast-ico {
        font-size: 1.3rem;
    }

    .toast.ok .toast-ico {
        color: var(--emerald);
    }

    .toast.err .toast-ico {
        color: #ef4444;
    }

    .toast.warn .toast-ico {
        color: var(--amber);
    }

    .toast-body {
        flex: 1;
    }

    .toast-ttl {
        font-weight: 700;
        font-size: .88rem;
        color: var(--deep-slate);
    }

    .toast-msg {
        font-size: .8rem;
        color: var(--slate);
    }

    .toast-x {
        background: transparent;
        border: none;
        color: var(--slate);
        cursor: pointer;
        font-size: 1.1rem;
    }

    @@keyframes slideInR {
        from {
            opacity: 0;
            transform: translateX(90%)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes slideOutR {
        from {
            opacity: 1;
            transform: translateX(0)
        }

        to {
            opacity: 0;
            transform: translateX(90%)
        }
    }

    @@keyframes fadeOutSc {
        from {
            opacity: 1;
            transform: scale(1)
        }

        to {
            opacity: 0;
            transform: scale(.85)
        }
    }

    @@media(max-width:1100px) {
        .editor-body {
            grid-template-columns: 1fr
        }

        .discovery-col {
            display: none
        }
    }

    @@media(max-width:768px) {
        .init-card {
            padding: var(--sp8)
        }

        .init-title {
            font-size: 1.8rem
        }

        .date-row {
