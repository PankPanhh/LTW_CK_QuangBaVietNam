@using System
@using System.Linq
@using System.Collections.Generic
@using LTW_CK_QuangBaVietNam.Models

@model LichTrinh

@{
    ViewBag.Title = "Chi tiết lịch trình";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var days = ViewBag.Days as List<NgayLichTrinh>;
    var itemsByDay = ViewBag.ItemsByDay as Dictionary<int, List<ChiTietLichTrinh>>;
    var diaDiemMap = ViewBag.DiaDiemMap as Dictionary<int, DiaDiem>;
    var anhChinhMap = ViewBag.AnhChinhMap as Dictionary<int, string>;

    days = days ?? new List<NgayLichTrinh>();
    itemsByDay = itemsByDay ?? new Dictionary<int, List<ChiTietLichTrinh>>();
    diaDiemMap = diaDiemMap ?? new Dictionary<int, DiaDiem>();
    anhChinhMap = anhChinhMap ?? new Dictionary<int, string>();

    int totalItems = itemsByDay.Values.Sum(list => list != null ? list.Count : 0);

    var tenLichTrinh = Model.TenLichTrinh;

    DateTime? ngayTao = Model.NgayTao;
    DateTime? ngayBatDau = Model.NgayBatDau;


    decimal tongChiPhiDuKien = 0m;
    if (ViewBag.TongChiPhi != null)
    {
        tongChiPhiDuKien = (decimal)ViewBag.TongChiPhi;
    }
}

<style>
    .it-wrap {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(15,23,42,.06);
    }

    .day-badge {
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 6px 12px;
        background: #f8fafc;
        color: #0f172a;
        font-weight: 600;
    }

    .timeline {
        border-left: 3px solid #e2e8f0;
        margin-left: 10px;
        padding-left: 18px;
    }

    .timeline-item {
        position: relative;
        padding: 10px 0;
    }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: -27px;
            top: 18px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #0ea5e9;
            border: 3px solid #e0f2fe;
        }

    .region-badge {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #334155;
    }
</style>

<div class="container py-4">
    <div class="it-wrap">
       
        <div class="p-4 border-bottom bg-white" style="border-top-left-radius:16px;border-top-right-radius:16px;">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
    
                <div>
                    <div class="text-muted small">CHI TIẾT LỊCH TRÌNH</div>
                    <h4 class="mb-1 text-primary fw-bold">
                        @tenLichTrinh
                    </h4>
                    <div class="text-muted small">
                        <i class="bi bi-clock me-1"></i>
                        @if (ngayTao.HasValue)
                        {
                            @:Tạo lúc: @ngayTao.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            @:Tạo lúc: (không xác định)
                        }
                    </div>
                </div>

                <div class="text-md-end">
                    <div class="text-muted small">TỔNG CHI PHÍ DỰ KIẾN</div>
                    <div class="fs-4 fw-bold text-success">
                        @String.Format("{0:N0}", tongChiPhiDuKien) đ
                    </div>

                    <div class="mt-2">
                        <a class="btn btn-outline-secondary btn-sm"
                           href="@Url.Action("LichTrinhDaTao","Home")">
                            <i class="bi bi-arrow-left me-2"></i>
                            Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4">
            @if (days == null || !days.Any() || totalItems == 0)
            {
                <div class="text-center text-muted py-5">
                    <div class="mb-2">
                        <i class="bi bi-list-check fs-1"></i>
                    </div>
                    <div>Lịch trình này chưa có địa điểm nào.</div>
                </div>
            }
            else
            {
                foreach (var day in days.OrderBy(d => d.ThuTuNgay))
                {
                   
                    List<ChiTietLichTrinh> dayDetails;
                    if (!itemsByDay.TryGetValue(day.MaNgay, out dayDetails) || dayDetails == null)
                    {
                        dayDetails = new List<ChiTietLichTrinh>();
                    }

                    var orderedDetails = dayDetails
                        .OrderBy(x => x.ThuTu)
                        .ToList();

                    string textNgay;
                    if (ngayBatDau.HasValue)
                    {
                        var ngayThucTe = ngayBatDau.Value.AddDays(day.ThuTuNgay - 1);
                        textNgay = ngayThucTe.ToString("dd/MM/yyyy");
                    }
                    else
                    {
                        textNgay = day.ThuTuNgay.ToString();
                    }

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="day-badge">
                            <i class="bi bi-calendar-event me-2"></i>
                            Ngày @textNgay
                        </div>
                        <div class="text-muted small">
                            @orderedDetails.Count địa điểm
                        </div>
                    </div>

                    <div class="timeline mb-4">
                        @foreach (var it in orderedDetails)
                        {
                            DiaDiem dd = null;
                            diaDiemMap.TryGetValue(it.MaDiaDiem, out dd);

                            var tenDiaDiem2 = dd != null ? dd.TenDiaDiem : "Địa điểm không tồn tại";
                            var vungMien = dd != null ? (dd.VungMien ?? "N/A") : "N/A";

                            <div class="timeline-item">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div>
                                        <div class="fw-semibold">
                                            <span class="text-muted me-2">
                                                #@it.ThuTu
                                            </span>
                                            @tenDiaDiem2
                                        </div>

                                        <div class="mt-1">
                                            <span class="badge region-badge">
                                                <i class="bi bi-geo me-1"></i>
                                                @vungMien
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>