<script>
    // 1. Hàm gắn sự kiện Favorite (Để đảm bảo nút tim hoạt động sau khi load API)
    function attachFavoriteEvents() {
        document.querySelectorAll('.favorite-btn').forEach(btn => {
            if (btn.getAttribute('data-event-bound')) return;
            btn.setAttribute('data-event-bound', 'true');

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const icon = this.querySelector('i');
                const title = this.getAttribute('data-title');
                const isAdding = icon.classList.contains('bi-heart');

                if (isAdding) {
                    icon.classList.replace('bi-heart', 'bi-heart-fill');
                    icon.classList.add('pop-animate');
                    createParticleBurst(this, 8);
                    showFavoriteToast(`Đã thêm "${title}" vào hành trình`, true);
                    localStorage.setItem(`favorite_${title}`, 'true');
                } else {
                    icon.classList.replace('bi-heart-fill', 'bi-heart');
                    showFavoriteToast(`Đã xóa "${title}" khỏi hành trình`, false);
                    localStorage.removeItem(`favorite_${title}`);
                }
            });
        });
    }

    // 2. Hàm gọi API từ DiaDiemController
    async function loadFeaturedPlaces(vungMien = "") {
        const container = document.getElementById('featured-destinations-container');

        // CHỈNH SỬA QUAN TRỌNG: Gọi đúng DiaDiem controller
        const apiUrl = '@Url.Action("GetAllPlaces", "DiaDiem")' + `?vungMien=${encodeURIComponent(vungMien)}&page=1&pageSize=4`;

        try {
            const response = await fetch(apiUrl);
            if (!response.ok) throw new Error('Network response was not ok');

            const result = await response.json();

            if (result.success) {
                renderPlaces(result.data);
            } else {
                container.innerHTML = `<div class="col-12 text-center text-danger">Lỗi dữ liệu: ${result.message}</div>`;
            }
        } catch (error) {
            console.error("API Error:", error);
            container.innerHTML = `<div class="col-12 text-center text-muted">Không thể kết nối đến máy chủ DiaDiem. Kiểm tra lại cổng chạy (Port).</div>`;
        }
    }

    // 3. Hàm Render HTML (Mapping đúng các thuộc tính Viết Hoa từ C#)
   // 3. Hàm Render HTML (Cập nhật để hiển thị Tên Danh Mục)
    function renderPlaces(places) {
        const container = document.getElementById('featured-destinations-container');

        if (!places || places.length === 0) {
            container.innerHTML = `<div class="col-12 text-center py-5"><p>Không tìm thấy địa điểm nào.</p></div>`;
            return;
        }

        container.innerHTML = places.map(place => {
            const ten = place.TenDiaDiem;
            const anh = place.AnhChinh || '/Content/images/Places/vinhhalong.jpg';
            const danhMuc = place.DanhMuc || "KHÁM PHÁ"; // Lấy tên danh mục từ API

            // Giới hạn chữ mô tả
            const moTaGoc = place.MoTaNgan || "";
            const maxLength = 100; 
            const motaRutGon = moTaGoc.length > maxLength
                ? moTaGoc.substring(0, maxLength).trim() + "..."
                : moTaGoc;

            // Xử lý địa chỉ
            const locationText = place.VungMien ? `${place.VungMien} - Việt Nam` : 'Việt Nam';
            const isFav = localStorage.getItem(`favorite_${ten}`);

            return `
            <div class="col-md-6 col-lg-3">
                <div class="destination-card h-100" onclick="location.href='/Home/DetailPlace?slug=${place.Slug}'" style="cursor:pointer">
                    <div class="card-img-wrapper">
                        <img src="${anh}" alt="${ten}">
                        <button class="favorite-btn" data-title="${ten}">
                            <i class="bi ${isFav ? 'bi-heart-fill' : 'bi-heart'}"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-truncate">${ten}</h5>
                        <div class="card-location">
                            <i class="bi bi-geo-alt"></i>
                            <span>${locationText}</span>
                        </div>
                        <p class="card-description">${motaRutGon}</p>
                        
                        <!-- THAY ĐỔI TẠI ĐÂY: Hiển thị Tên Danh Mục thay vì Sao -->
                        <div class="experience-badge">
                            <i class="bi"></i> ${danhMuc.toUpperCase()}
                        </div>
                    </div>
                </div>
            </div>
        `;
        }).join('');

        attachFavoriteEvents();
    }
    // 4. Các hàm bổ trợ UI (Giữ nguyên logic của bạn)
    function showFavoriteToast(message, isAdding) {
        const oldToast = document.querySelector('.favorite-toast');
        if (oldToast) oldToast.remove();
        const toast = document.createElement('div');
        toast.className = `favorite-toast ${!isAdding ? 'remove' : ''}`;
        toast.innerHTML = `<i class="bi ${isAdding ? 'bi-heart-fill' : 'bi-heart'}"></i><span>${message}</span>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    function createParticleBurst(button, count) {
        const rect = button.getBoundingClientRect();
        for (let i = 0; i < count; i++) {
            const particle = document.createElement('div');
            particle.className = 'favorite-particle';
            particle.innerHTML = '♥';
            particle.style.left = (rect.left + rect.width / 2) + 'px';
            particle.style.top = (rect.top + rect.height / 2) + 'px';
            particle.style.setProperty('--tx', `${(Math.random() - 0.5) * 120}px`);
            particle.style.setProperty('--ty', `${(Math.random() - 0.5) * 120}px`);
            document.body.appendChild(particle);
            setTimeout(() => particle.remove(), 800);
        }
    }

    // 5. Khởi động
    document.addEventListener('DOMContentLoaded', () => {
        loadFeaturedPlaces(); // Load mặc định 4 cái

        // Xử lý bộ lọc
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const txt = this.innerText;
                let vung = "";
                if (txt.includes("Bắc")) vung = "Bắc";
                else if (txt.includes("Trung")) vung = "Trung";
                else if (txt.includes("Nam")) vung = "Nam";

                loadFeaturedPlaces(vung);
            });
        });
    });
</script>