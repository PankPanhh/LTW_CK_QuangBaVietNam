@using System.Linq
@using LTW_CK_QuangBaVietNam.Models
@model List<LTW_CK_QuangBaVietNam.Models.FavoritePlaceVM>

@{
    ViewBag.Title = "Địa điểm yêu thích";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var collections = ViewBag.Collections as List<BoSuuTap>;
    if (collections == null) { collections = new List<BoSuuTap>(); }
}

<form id="favTokenForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-primary">Địa điểm yêu thích</h4>
        </div>
        <a class="btn btn-outline-secondary" href="@Url.Action("Profile","Home")">
            <i class="bi bi-arrow-left me-2"></i>Về hồ sơ
        </a>
    </div>

    <!-- Bộ sưu tập -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#e0f2fe;">
                        <i class="bi bi-collection text-primary fs-4"></i>
                    </div>

                    <div>
                        <div class="fw-bold">Bộ sưu tập cá nhân</div>
                        <div class="text-muted small">
                            Tạo bộ sưu tập và thêm địa điểm yêu thích vào để quản lý theo chủ đề.
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a class="btn btn-outline-primary" href="@Url.Action("BoSuuTap","YeuThich")">
                        <i class="bi bi-eye me-2"></i>Xem bộ sưu tập
                    </a>

                    <button type="button" class="btn btn-primary"
                            data-bs-toggle="modal" data-bs-target="#modalCreateCollection">
                        <i class="bi bi-plus-circle me-2"></i>Tạo bộ sưu tập
                    </button>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                @if (!collections.Any())
                {
                    <span class="text-muted small">Chưa có bộ sưu tập nào.</span>
                }
                else
                {
                    foreach (var c in collections)
                    {
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-collection me-1"></i>@c.TenBoSuuTap
                        </span>
                    }
                }
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-heart fs-1 d-block mb-2"></i>
                Chưa có địa điểm yêu thích nào.
            </div>
        </div>
    }
    else
    {
        <div class="row g-3" id="favGrid">
            @foreach (var p in Model)
            {
                var img = string.IsNullOrWhiteSpace(p.AnhChinh)
                    ? "https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=1200&q=80"
                    : p.AnhChinh;

                <div class="col-12 col-md-6 col-lg-4" id="fav-card-@p.MaDiaDiem">
                    <div class="card border-0 shadow-sm h-100">
                        <img src="@img" class="card-img-top" style="height:200px;object-fit:cover;" alt="@p.TenDiaDiem" />
                        <div class="card-body">
                            <div class="fw-bold">@p.TenDiaDiem</div>

                            <div class="text-muted small mt-1">
                                <i class="bi bi-geo-alt me-1"></i>@(p.VungMien ?? "Việt Nam")
                            </div>

                            <div class="text-muted small mt-2">
                                Lưu lúc: @p.NgayLuu.ToString("dd/MM/yyyy HH:mm")
                            </div>

                            <hr />

                            <div class="d-flex gap-2 align-items-center">
                                <select class="form-select form-select-sm" id="sel-bst-@p.MaDiaDiem">
                                    <option value="">-- Chọn bộ sưu tập --</option>
                                    @foreach (var c in collections)
                                    {
                                        <option value="@c.MaBoSuuTap">@c.TenBoSuuTap</option>
                                    }
                                </select>

                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        onclick="addToCollection(@p.MaDiaDiem)">
                                    <i class="bi bi-bookmark-plus me-1"></i>Thêm
                                </button>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button class="btn btn-outline-danger btn-sm"
                                        type="button"
                                        onclick="toggleFav(@p.MaDiaDiem, this)">
                                    <i class="bi bi-heartbreak me-1"></i>Bỏ lưu
                                </button>
                            </div>

                            <div class="text-muted small mt-2" id="msg-@p.MaDiaDiem"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal tạo bộ sưu tập -->
<div class="modal fade" id="modalCreateCollection" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo bộ sưu tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Tên bộ sưu tập</label>
                <input class="form-control" id="bstName" placeholder="VD: Đi biển, Đi núi..." />

                <div class="mt-2">
                    <label class="form-label">Mô tả (tuỳ chọn)</label>
                    <textarea class="form-control" id="bstDesc" rows="3"></textarea>
                </div>

                <div class="text-danger small mt-2" id="bstErr" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-primary" type="button" onclick="createCollection()">Tạo</button>
            </div>
        </div>
    </div>
</div>

<script>
    function getToken() {
        var el = document.querySelector('#favTokenForm input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    async function postForm(url, dataObj) {
        var body = new URLSearchParams();
        body.append('__RequestVerificationToken', getToken());

        for (var k in dataObj) body.append(k, dataObj[k]);

        var res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body.toString()
        });

        var json = await res.json();
        return { ok: res.ok, json: json };
    }

    async function toggleFav(maDiaDiem, btn) {
        btn.disabled = true;
        try {
            var r = await postForm('@Url.Action("Toggle","YeuThich")', { maDiaDiem: maDiaDiem });

            if (!r.ok || !r.json || !r.json.success) {
                alert((r.json && r.json.message) ? r.json.message : 'Không thể cập nhật yêu thích.');
                return;
            }

            if (r.json.isFavorite === false) {
                var card = document.getElementById('fav-card-' + maDiaDiem);
                if (card) card.remove();

                if (document.querySelectorAll('[id^="fav-card-"]').length === 0) location.reload();
            }
        } catch (e) {
            alert('Lỗi kết nối. Vui lòng thử lại.');
        } finally {
            btn.disabled = false;
        }
    }

    async function createCollection() {
        var name = (document.getElementById('bstName').value || '').trim();
        var desc = (document.getElementById('bstDesc').value || '').trim();

        var err = document.getElementById('bstErr');
        err.style.display = 'none';
        err.textContent = '';

        if (!name) {
            err.textContent = 'Vui lòng nhập tên bộ sưu tập.';
            err.style.display = 'block';
            return;
        }

        var r = await postForm('@Url.Action("TaoBoSuuTap","YeuThich")', { tenBoSuuTap: name, moTa: desc });

        if (!r.ok || !r.json || !r.json.success) {
            err.textContent = (r.json && r.json.message) ? r.json.message : 'Không tạo được bộ sưu tập.';
            err.style.display = 'block';
            return;
        }

        // tạo xong reload để dropdown có BST mới (nhanh, đơn giản)
        location.reload();
    }

    async function addToCollection(maDiaDiem) {
        var sel = document.getElementById('sel-bst-' + maDiaDiem);
        var msg = document.getElementById('msg-' + maDiaDiem);

        msg.textContent = '';
        msg.className = 'text-muted small mt-2';

        var maBoSuuTap = sel.value;
        if (!maBoSuuTap) {
            msg.textContent = 'Vui lòng chọn bộ sưu tập.';
            msg.className = 'text-danger small mt-2';
            return;
        }

        var r = await postForm('@Url.Action("ThemVaoBoSuuTap","YeuThich")', { maBoSuuTap: maBoSuuTap, maDiaDiem: maDiaDiem });

        if (!r.ok || !r.json || !r.json.success) {
            msg.textContent = (r.json && r.json.message) ? r.json.message : 'Không thêm được.';
            msg.className = 'text-danger small mt-2';
            return;
        }

        msg.textContent = r.json.message || 'Đã thêm vào bộ sưu tập.';
        msg.className = 'text-success small mt-2';
    }
</script>