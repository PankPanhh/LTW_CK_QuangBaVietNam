@{
    ViewBag.Title = "Khám phá lịch trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #0EA5E9;
        --bg: #f8fafc;
        --border: #e2e8f0;
        --text-dark: #1e293b;
        --text-muted: #64748b;
    }

    body {
        background: var(--bg);
    }

    .feed-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .feed-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .feed-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .feed-subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    .feed-filters {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .filter-btn {
        padding: 0.5rem 1.5rem;
        border: 2px solid var(--border);
        border-radius: 30px;
        background: white;
        color: var(--text-dark);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .filter-btn.active, .filter-btn:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    /* Masonry Grid */
    .masonry-grid {
        column-count: 4;
        column-gap: 1.5rem;
    }

    @@media (max-width: 1200px) { .masonry-grid { column-count: 3; } }
    @@media (max-width: 900px) { .masonry-grid { column-count: 2; } }
    @@media (max-width: 600px) { .masonry-grid { column-count: 1; } }

    .schedule-card {
        break-inside: avoid;
        margin-bottom: 1.5rem;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        cursor: pointer;
        position: relative;
    }

    .schedule-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .schedule-img {
        width: 100%;
        height: auto;
        display: block;
        min-height: 200px;
        object-fit: cover;
    }

    .schedule-info {
        padding: 1.25rem;
    }

    .schedule-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .schedule-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
    }

    .schedule-author {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .author-avt {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .card-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border);
        padding-top: 0.75rem;
        margin-top: 0.5rem;
    }

    .action-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.1rem;
        cursor: pointer;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .action-btn:hover {
        color: var(--primary);
    }

    .action-btn.liked {
        color: #f43f5e;
    }

    /* Tabs */
    .feed-tabs {
        display: flex;
        justify-content: center;
        gap: .75rem;
        margin-bottom: 2rem;
    }

    .feed-tab {
        padding: .55rem 1.5rem;
        border: 2px solid var(--border);
        border-radius: 30px;
        background: white;
        font-weight: 700;
        font-size: .95rem;
        cursor: pointer;
        transition: all .25s;
        color: var(--text-dark);
    }

    .feed-tab.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    /* Search bar */
    .feed-search {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .feed-search-wrap {
        position: relative;
        width: 100%;
        max-width: 480px;
    }

    .feed-search-wrap input {
        width: 100%;
        padding: .6rem 1rem .6rem 2.5rem;
        border: 2px solid var(--border);
        border-radius: 30px;
        font-size: .9rem;
        background: white;
        color: var(--text-dark);
        transition: border-color .2s;
    }

    .feed-search-wrap input:focus {
        outline: none;
        border-color: var(--primary);
    }

    .feed-search-wrap i {
        position: absolute;
        left: .85rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }

    /* My schedule cards */
    .my-sched-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .my-sched-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
        transition: transform .3s, box-shadow .3s;
        position: relative;
    }

    .my-sched-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,.1);
    }

    .my-sched-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
    }

    .my-sched-body {
        padding: 1rem 1.25rem;
    }

    .my-sched-title {
        font-weight: 700;
        font-size: 1rem;
        color: var(--text-dark);
        margin-bottom: .35rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .my-sched-meta {
        font-size: .82rem;
        color: var(--text-muted);
        margin-bottom: .75rem;
    }

    .my-sched-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .75rem;
        font-weight: 600;
        padding: .2rem .6rem;
        border-radius: 6px;
        margin-bottom: .75rem;
    }

    .my-sched-badge.public {
        background: rgba(16,185,129,.1);
        color: #10b981;
    }

    .my-sched-badge.private {
        background: rgba(100,116,139,.1);
        color: #64748b;
    }

    .my-sched-actions {
        display: flex;
        gap: .5rem;
    }

    .my-sched-btn {
        flex: 1;
        padding: .45rem;
        border-radius: 8px;
        border: 1.5px solid var(--border);
        background: transparent;
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        color: var(--text-dark);
    }

    .my-sched-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    .my-sched-btn.danger:hover {
        border-color: #ef4444;
        color: #ef4444;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 3rem;
        display: block;
        margin-bottom: 1rem;
        color: #cbd5e1;
    }

    .empty-state a {
        display: inline-block;
        margin-top: 1rem;
        padding: .6rem 1.5rem;
        background: var(--primary);
        color: white;
        border-radius: 20px;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<div class="feed-container">
    <div class="feed-header">
        <h1 class="feed-title">Khám phá Lịch trình</h1>
        <p class="feed-subtitle">Tìm nguồn cảm hứng cho chuyến đi tiếp theo của bạn từ cộng đồng VIETSCAPE</p>
    </div>

    <!-- Tabs: Cộng đồng / Của tôi -->
    <div class="feed-tabs">
        <button class="feed-tab active" id="tabCommunity" onclick="switchTab('community')">
            <i class="bi bi-globe"></i> Cộng đồng
        </button>
        <button class="feed-tab" id="tabMine" onclick="switchTab('mine')">
            <i class="bi bi-person-circle"></i> Lịch trình của tôi
        </button>
    </div>

    <!-- Search -->
    <div class="feed-search">
        <div class="feed-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInp" placeholder="Tìm lịch trình..." oninput="onSearchInput()" />
        </div>
    </div>

    <!-- Community filters -->
    <div class="feed-filters" id="communityFilters">
        <button class="filter-btn active" onclick="loadCommunity('all', this)">Tất cả</button>
        <button class="filter-btn" onclick="loadCommunity('3days', this)">3 Ngày</button>
        <button class="filter-btn" onclick="loadCommunity('5days', this)">5 Ngày</button>
        <button class="filter-btn" onclick="loadCommunity('7days', this)">7+ Ngày</button>
        <button class="filter-btn" onclick="loadCommunity('all', this, 'popular')">Phổ biến nhất</button>
    </div>

    <!-- My schedules filters -->
    <div class="feed-filters" id="myFilters" style="display:none;">
        <button class="filter-btn active" onclick="filterMine('all', this)">Tất cả</button>
        <button class="filter-btn" onclick="filterMine('public', this)">Công khai</button>
        <button class="filter-btn" onclick="filterMine('private', this)">Riêng tư</button>
        <a href="/Home/CreateSchedule" class="filter-btn" style="background:var(--primary);color:white;border-color:var(--primary);text-decoration:none;">
            <i class="bi bi-plus-lg"></i> Tạo lịch trình mới
        </a>
    </div>

    <div class="text-center my-4" id="loadingSpinner">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Community grid -->
    <div class="masonry-grid" id="feedGrid"></div>

    <!-- My schedules grid -->
    <div class="my-sched-grid" id="myGrid" style="display:none;"></div>
</div>

<script>
    let currentTab = 'community';
    let allCommunityData = [];
    let allMyData = [];
    let searchTimer = null;

    document.addEventListener('DOMContentLoaded', () => {
        loadCommunity('all');
    });

    // ── Tab switching ──────────────────────────────────────────
    function switchTab(tab) {
        currentTab = tab;
        document.getElementById('tabCommunity').classList.toggle('active', tab === 'community');
        document.getElementById('tabMine').classList.toggle('active', tab === 'mine');
        document.getElementById('communityFilters').style.display = tab === 'community' ? 'flex' : 'none';
        document.getElementById('myFilters').style.display = tab === 'mine' ? 'flex' : 'none';
        document.getElementById('feedGrid').style.display = tab === 'community' ? '' : 'none';
        document.getElementById('myGrid').style.display = tab === 'mine' ? 'grid' : 'none';
        document.getElementById('searchInp').value = '';

        if (tab === 'mine') {
            loadMySchedules();
        } else {
            loadCommunity('all');
        }
    }

    // ── Community ──────────────────────────────────────────────
    function loadCommunity(filter, btn, sort) {
        document.querySelectorAll('#communityFilters .filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        document.getElementById('loadingSpinner').style.display = 'block';
        document.getElementById('feedGrid').innerHTML = '';

        fetch(`/Itinerary/GetPublicSchedules?filter=${filter}&sort=${sort || 'latest'}`)
            .then(r => r.json())
            .then(data => {
                document.getElementById('loadingSpinner').style.display = 'none';
                if (data.success) {
                    allCommunityData = data.data;
                    renderCommunityGrid(data.data);
                }
            });
    }

    function renderCommunityGrid(items) {
        const grid = document.getElementById('feedGrid');
        if (!items.length) {
            grid.innerHTML = '<div class="empty-state"><i class="bi bi-calendar-x"></i><p>Chưa có lịch trình nào</p></div>';
            return;
        }
        const heights = [200, 220, 240, 260, 280];
        grid.innerHTML = items.map(item => {
            const h = heights[Math.floor(Math.random() * heights.length)];
            return `
            <div class="schedule-card" onclick="window.location.href='/Home/DetailSchedule?id=${item.id}'">
                <img src="${item.image}" class="schedule-img" alt="${item.title}" style="height:${h}px" onerror="this.src='https://images.unsplash.com/photo-1528127269322-539801943592?w=600'">
                <div class="schedule-info">
                    <div class="schedule-title">${item.title}</div>
                    <div class="schedule-meta">
                        <span><i class="bi bi-calendar3"></i> ${item.days} ngày</span>
                        <div class="schedule-author">
                            <div class="author-avt">${item.authorInitial || item.author?.charAt(0)?.toUpperCase() || 'N'}</div>
                            <span>${item.author}</span>
                        </div>
                    </div>
                    <div class="card-actions" onclick="event.stopPropagation()">
                        <button class="action-btn ${item.isLiked ? 'liked' : ''}" onclick="toggleLike(${item.id}, this)">
                            <i class="bi ${item.isLiked ? 'bi-heart-fill' : 'bi-heart'}"></i>
                            <span style="font-size:.85rem">${item.likes}</span>
                        </button>
                        <button class="action-btn" onclick="shareSchedule(${item.id})">
                            <i class="bi bi-share"></i>
                        </button>
                    </div>
                </div>
            </div>`;
        }).join('');
    }

    // ── My Schedules ───────────────────────────────────────────
    function loadMySchedules() {
        document.getElementById('loadingSpinner').style.display = 'block';
        document.getElementById('myGrid').innerHTML = '';

        fetch('/Itinerary/GetMySchedules')
            .then(r => r.json())
            .then(data => {
                document.getElementById('loadingSpinner').style.display = 'none';
                if (!data.success) {
                    document.getElementById('myGrid').innerHTML = '<div class="empty-state"><i class="bi bi-lock"></i><p>Vui lòng đăng nhập để xem lịch trình của bạn</p><a href="/Home/Login">Đăng nhập</a></div>';
                    return;
                }
                allMyData = data.data;
                renderMyGrid(data.data);
            });
    }

    function renderMyGrid(items) {
        const grid = document.getElementById('myGrid');
        if (!items.length) {
            grid.innerHTML = '<div class="empty-state" style="grid-column:1/-1"><i class="bi bi-map"></i><p>Bạn chưa có lịch trình nào</p><a href="/Home/CreateSchedule">✈️ Tạo lịch trình đầu tiên</a></div>';
            return;
        }
        grid.innerHTML = items.map(item => `
            <div class="my-sched-card">
                <img src="${item.image}" class="my-sched-img" alt="${item.title}" onerror="this.src='https://images.unsplash.com/photo-1528127269322-539801943592?w=600'" onclick="window.location.href='/Home/DetailSchedule?id=${item.id}'">
                <div class="my-sched-body">
                    <div class="my-sched-title" onclick="window.location.href='/Home/DetailSchedule?id=${item.id}'" style="cursor:pointer;">${item.title}</div>
                    <div class="my-sched-meta"><i class="bi bi-calendar3"></i> ${item.days} ngày</div>
                    <div class="my-sched-badge ${item.status === 'public' ? 'public' : 'private'}">
                        <i class="bi ${item.status === 'public' ? 'bi-globe' : 'bi-lock-fill'}"></i>
                        ${item.status === 'public' ? 'Công khai' : 'Riêng tư'}
                    </div>
                    <div class="my-sched-actions">
                        <button class="my-sched-btn" onclick="window.location.href='/Home/DetailSchedule?id=${item.id}'"><i class="bi bi-eye"></i> Xem</button>
                        <button class="my-sched-btn" onclick="window.location.href='/Home/CreateSchedule?edit=${item.id}'"><i class="bi bi-pencil"></i> Sửa</button>
                        <button class="my-sched-btn" onclick="toggleMyStatus(${item.id}, '${item.status}', this)">
                            <i class="bi ${item.status === 'public' ? 'bi-lock' : 'bi-globe'}"></i>
                            ${item.status === 'public' ? 'Riêng tư' : 'Công khai'}
                        </button>
                        <button class="my-sched-btn danger" onclick="deleteMySched(${item.id}, this)"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    function filterMine(status, btn) {
        document.querySelectorAll('#myFilters .filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        const filtered = status === 'all' ? allMyData : allMyData.filter(x => x.status === status);
        renderMyGrid(filtered);
    }

    function toggleMyStatus(id, currentStatus, btn) {
        const newStatus = currentStatus === 'public' ? 'private' : 'public';
        fetch('/Itinerary/UpdateStatus', {
            method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `idLichTrinh=${id}&status=${newStatus}`
        }).then(r => r.json()).then(d => {
            if (d.success) {
                const item = allMyData.find(x => x.id === id);
                if (item) item.status = newStatus;
                renderMyGrid(allMyData);
            } else {
                showToast('Lỗi', d.message, 'error');
            }
        });
    }

    function deleteMySched(id, btn) {
        showConfirmModal('Xóa lịch trình', 'Bạn có chắc chắn muốn xóa lịch trình này? Hành động không thể hoàn tác.', () => {
            fetch('/Itinerary/DeleteSchedule', {
                method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body: `idLichTrinh=${id}`
            }).then(r => r.json()).then(d => {
                if (d.success) {
                    allMyData = allMyData.filter(x => x.id !== id);
                    renderMyGrid(allMyData);
                    showToast('Thành công', 'Đã xóa lịch trình thành công', 'success');
                } else {
                    showToast('Lỗi', d.message, 'error');
                }
            });
        }, true);
    }

    // ── Search ────────────────────────────────────────────────
    function onSearchInput() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            const q = document.getElementById('searchInp').value.trim().toLowerCase();
            if (currentTab === 'community') {
                const filtered = q ? allCommunityData.filter(x => x.title?.toLowerCase().includes(q) || x.author?.toLowerCase().includes(q)) : allCommunityData;
                renderCommunityGrid(filtered);
            } else {
                const filtered = q ? allMyData.filter(x => x.title?.toLowerCase().includes(q)) : allMyData;
                renderMyGrid(filtered);
            }
        }, 280);
    }

    // ── Like/Share ────────────────────────────────────────────
    function toggleLike(id, btn) {
        fetch(`/Itinerary/ToggleLike?idLichTrinh=${id}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    const icon = btn.querySelector('i');
                    const countSpan = btn.querySelector('span');
                    if (data.isLiked) {
                        btn.classList.add('liked');
                        icon.className = 'bi bi-heart-fill';
                        countSpan.textContent = data.likes;
                    } else {
                        btn.classList.remove('liked');
                        icon.className = 'bi bi-heart';
                        countSpan.textContent = data.likes;
                    }
                } else {
                    showToast('Thông báo', data.message, 'warning');
                }
            });
    }

    function shareSchedule(id) {
        const url = window.location.origin + '/Home/DetailSchedule?id=' + id;
        navigator.clipboard.writeText(url).then(() => showToast('Thành công', 'Đã copy link chia sẻ!', 'success'));
    }
</script>
