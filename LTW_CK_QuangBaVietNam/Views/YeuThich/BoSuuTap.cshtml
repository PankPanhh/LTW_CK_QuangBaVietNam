@using System.Linq
@using LTW_CK_QuangBaVietNam.Models
@model List<LTW_CK_QuangBaVietNam.Models.BoSuuTap>

@{
    ViewBag.Title = "Bộ sưu tập của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var anhMap = ViewBag.AnhMap as Dictionary<int, string>
              ?? new Dictionary<int, string>();

    var counts = ViewBag.Counts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container py-4">

    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white"
         style="background:#334155;">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#38BDF8;color:#0f172a;">
                        <i class="bi bi-collection fs-4"></i>
                    </div>

                    <div>
                        <div class="fw-bold fs-5">Bộ sưu tập của tôi</div>
                        <div class="small" style="color:rgba(255,255,255,.75);">
                            Xem các bộ sưu tập bạn đã tạo và quản lý địa điểm theo chủ đề
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm rounded-pill px-3"
                       style="background:#38BDF8;border:none;color:#0f172a;font-weight:700;"
                       href="@Url.Action("YeuThich","YeuThich")">
                        <i class="bi bi-arrow-left me-2"></i>Về Yêu thích
                    </a>
                </div>

            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center text-muted py-5">
                <div class="mb-2"><i class="bi bi-collection fs-1"></i></div>
                <div class="fw-semibold">Chưa có bộ sưu tập nào.</div>
                <div class="small">Hãy quay lại trang Yêu thích để tạo bộ sưu tập mới.</div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var c in Model)
            {
                var soDiaDiem = counts.ContainsKey(c.MaBoSuuTap) ? counts[c.MaBoSuuTap] : 0;
                string rawImg = null;
                anhMap.TryGetValue(c.MaBoSuuTap, out rawImg);

                var bgImg = !string.IsNullOrWhiteSpace(rawImg)
                    ? Url.Content("~" + rawImg)
                    : Url.Content("~/Content/images/Places/default.jpg");

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">

                      <div style="
                            height:110px;
                            background:
                            linear-gradient(135deg, rgba(56,189,248,.35), rgba(51,65,85,.25)),
                            url('@bgImg') center/cover;">
                                              </div>

                        <div class="card-body p-4 text-center">
                            <span class="badge rounded-pill bg-light text-dark border mb-3 px-3 py-2">
                                <i class="bi bi-geo-alt me-1"></i>@soDiaDiem địa điểm
                            </span>

                            <h5 class="fw-bold mb-1">@c.TenBoSuuTap</h5>

                            <div class="text-muted small mb-3" style="min-height:44px;">
                                @(string.IsNullOrWhiteSpace(c.MoTa) ? "—" : c.MoTa)
                            </div>

                            <div class="text-muted small d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-calendar2"></i>
                                <span>@c.NgayTao.ToString("dd/MM/yyyy")</span>
                            </div>

                            <div class="d-flex justify-content-center gap-2 mt-4">
                                <a class="btn btn-sm rounded-pill px-3"
                                   style="background:#38BDF8;border:none;color:#0f172a;font-weight:700;"
                                   href="@Url.Action("ChiTietBoSuuTap","YeuThich", new { id = c.MaBoSuuTap })">
                                    <i class="bi bi-eye me-1"></i>Xem
                                </a>

                                @using (Html.BeginForm("XoaBoSuuTap", "YeuThich", FormMethod.Post,
                                    new { onsubmit = "return confirm('Xoá bộ sưu tập này?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.MaBoSuuTap" />
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3" type="submit">
                                        <i class="bi bi-trash me-1"></i>Xoá
                                    </button>
                                }
                            </div>

                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>