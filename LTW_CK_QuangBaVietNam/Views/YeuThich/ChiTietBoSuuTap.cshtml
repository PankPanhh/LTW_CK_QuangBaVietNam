@using System.Linq
@using LTW_CK_QuangBaVietNam.Models
@model LTW_CK_QuangBaVietNam.Models.BoSuuTap

@{
    ViewBag.Title = "Chi tiết bộ sưu tập";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rows = ViewBag.Rows as List<BoSuuTapDiaDiem> ?? new List<BoSuuTapDiaDiem>();
    var ddMap = ViewBag.DiaDiemMap as Dictionary<int, DiaDiem> ?? new Dictionary<int, DiaDiem>();
    var anhMap = ViewBag.AnhChinhMap as Dictionary<int, string> ?? new Dictionary<int, string>();

    var bst = Model; 
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="flex-grow-1 me-3">
            <h2 class="mb-0 fw-bold text-primary text-center">
                @((bst != null) ? bst.TenBoSuuTap : "Bộ sưu tập")
            </h2>
            <div class="text-muted small text-center">
                @((bst != null) ? bst.MoTa : "")
            </div>
        </div>

        <a class="btn btn-outline-secondary flex-shrink-0" href="@Url.Action("BoSuuTap","YeuThich")">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>


    @if (!rows.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">
                Bộ sưu tập chưa có địa điểm nào.
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in rows)
            {
                DiaDiem dd = null;
                ddMap.TryGetValue(r.MaDiaDiem, out dd);

                string anhChinh = null;
                anhMap.TryGetValue(r.MaDiaDiem, out anhChinh);

                var img = !string.IsNullOrWhiteSpace(anhChinh)
                  ? Url.Content("~" + anhChinh)
                  : Url.Content("~/Content/images/Places/default.jpg");
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <img src="@img" class="card-img-top" style="height:200px;object-fit:cover;" />
                        <div class="card-body">
                            <div class="fw-bold">@((dd != null) ? dd.TenDiaDiem : ("Địa điểm #" + r.MaDiaDiem))</div>

                            <div class="text-muted small">
                                <i class="bi bi-geo-alt me-1"></i>@((dd != null && dd.VungMien != null) ? dd.VungMien : "Việt Nam")
                            </div>

                            <div class="text-muted small mt-2">
                                Thêm lúc: @r.NgayThem.ToString("dd/MM/yyyy HH:mm")
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                @using (Html.BeginForm("XoaKhoiBoSuuTap", "YeuThich", FormMethod.Post,
                                    new { onsubmit = "return confirm('Xoá địa điểm khỏi bộ sưu tập?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maBoSuuTap" value="@bst.MaBoSuuTap" />
                                    <input type="hidden" name="maDiaDiem" value="@r.MaDiaDiem" />
                                    <button class="btn btn-outline-danger btn-sm" type="submit">
                                        Xoá khỏi BST
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>