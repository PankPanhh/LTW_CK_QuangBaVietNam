@using System.Linq
@using System.Collections.Generic
@using LTW_CK_QuangBaVietNam.Models
@model List<LTW_CK_QuangBaVietNam.Models.YeuThich>

@{
    ViewBag.Title = "Địa điểm yêu thích";
    Layout = "~/Views/Shared/_Layout.cshtml";

    
    var anhMap = ViewBag.AnhChinhMap as Dictionary<int, string> ?? new Dictionary<int, string>();

    var collections = ViewBag.Collections as List<BoSuuTap> ?? new List<BoSuuTap>();
    var returnUrl = Request.RawUrl;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-primary">Địa điểm yêu thích</h4>

            @if (TempData["Message"] != null)
            {
                <div class="text-success small mt-1">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="text-danger small mt-1">@TempData["Error"]</div>
            }
        </div>

        <a class="btn btn-outline-secondary" href="@Url.Action("Profile","Home")">
            <i class="bi bi-arrow-left me-2"></i>Về hồ sơ
        </a>
    </div>

    <!-- Bộ sưu tập -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-4 d-flex align-items-center justify-content-center"
                         style="width:46px;height:46px;background:#e0f2fe;">
                        <i class="bi bi-collection text-primary fs-4"></i>
                    </div>

                    <div>
                        <div class="fw-bold">Bộ sưu tập cá nhân</div>
                        <div class="text-muted small">
                            Tạo bộ sưu tập và thêm địa điểm yêu thích vào để quản lý theo chủ đề.
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a class="btn btn-outline-primary" href="@Url.Action("BoSuuTap","YeuThich")">
                        <i class="bi bi-eye me-2"></i>Xem bộ sưu tập
                    </a>

                    <button type="button" class="btn btn-primary"
                            data-bs-toggle="modal" data-bs-target="#modalCreateCollection">
                        <i class="bi bi-plus-circle me-2"></i>Tạo bộ sưu tập
                    </button>
                </div>
            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                @if (!collections.Any())
                {
                    <span class="text-muted small">Chưa có bộ sưu tập nào.</span>
                }
                else
                {
                    foreach (var c in collections)
                    {
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-collection me-1"></i>@c.TenBoSuuTap
                        </span>
                    }
                }
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-heart fs-1 d-block mb-2"></i>
                Chưa có địa điểm yêu thích nào.
            </div>
        </div>
    }
    else
    {
<div class="row g-3">
    @foreach (var yt in Model)
    {
        var dd = yt.DiaDiem;

        string rawImg = null;
        anhMap.TryGetValue(yt.MaDiaDiem, out rawImg);

        string src = "";
        if (!string.IsNullOrWhiteSpace(rawImg))
        {
            src = Url.Content("~" + rawImg);
        }
        else
        {
            
            src = Url.Content("~/Content/images/no-image.jpg");
        }
        <div class="col-12 col-md-6 col-lg-4" id="fav-card-@yt.MaDiaDiem">
            <div class="card border-0 shadow-sm h-100">
                <img src="@src" class="card-img-top" style="height:200px;object-fit:cover;" alt="@(dd != null ? dd.TenDiaDiem : "")" />
                <div class="card-body">
                    <div class="fw-bold">@(dd != null ? dd.TenDiaDiem : "")</div>

                    <div class="text-muted small mt-1">
                        <i class="bi bi-geo-alt me-1"></i>@((dd != null && dd.VungMien != null) ? dd.VungMien : "Việt Nam")
                    </div>

                    <div class="text-muted small mt-2">
                        Lưu lúc: @yt.NgayLuu.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <hr />

                    @using (Html.BeginForm("ThemVaoBoSuuTap", "YeuThich", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDiaDiem" value="@yt.MaDiaDiem" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <select class="form-select form-select-sm" name="maBoSuuTap">
                            <option value="">-- Chọn bộ sưu tập --</option>
                            @foreach (var c in collections)
                            {
                                <option value="@c.MaBoSuuTap">@c.TenBoSuuTap</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-bookmark-plus me-1"></i>Thêm
                        </button>
                    }


                <div class="d-flex justify-content-end mt-3">
                    @using (Html.BeginForm("BoLuuForm", "YeuThich", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDiaDiem" value="@yt.MaDiaDiem" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <button class="btn btn-outline-danger btn-sm" type="submit">
                            <i class="bi bi-heartbreak me-1"></i>Bỏ lưu
                        </button>
                    }
                </div>

                </div>
            </div>
        </div>
    }
</div>
    }
</div>

<div class="modal fade" id="modalCreateCollection" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        @using (Html.BeginForm("TaoBoSuuTap", "YeuThich", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tạo bộ sưu tập</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Tên bộ sưu tập</label>
                    <input class="form-control" name="tenBoSuuTap" placeholder="VD: Đi biển, Đi núi..." />

                    <div class="mt-2">
                        <label class="form-label">Mô tả (tuỳ chọn)</label>
                        <textarea class="form-control" name="moTa" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal" type="button">Huỷ</button>
                    <button class="btn btn-primary" type="submit">Tạo</button>
                </div>
            </div>
        }
    </div>
</div>