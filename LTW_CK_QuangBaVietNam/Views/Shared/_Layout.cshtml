<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --deep-slate: #1e293b;
            --slate: #334155;
            --sky-blue: #0EA5E9;
            --sky-light: #38BDF8;
            --slate-light: #cbd5e1;
            --slate-200: #e2e8f0;
            --white: #ffffff;
            --spacing-2: 0.5rem;
            --spacing-3: 0.75rem;
            --spacing-4: 1rem;
            --spacing-6: 1.5rem;
            --spacing-8: 2rem;
            --spacing-12: 3rem;
            --spacing-16: 4rem;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
        }

        main {
            flex: 1;
        }

        /* TOPBAR */
        .topbar {
            background: var(--deep-slate);
            color: var(--white);
            padding: var(--spacing-3) 0;
            font-size: 0.875rem;
            text-align: center;
            z-index: 1040;
        }

        .topbar-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--spacing-6);
            flex-wrap: wrap;
        }

        .topbar-item {
            display: flex;
            align-items: center;
            gap: var(--spacing-2);
        }

        .topbar i {
            color: var(--sky-blue);
        }

        /* HEADER GLASSMORPHISM */
        .header-glass {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            box-shadow: 0 4px 32px rgba(0, 0, 0, 0.12);
            position: sticky;
            top: 0;
            z-index: 1030;
            border-bottom: 1px solid rgba(14, 165, 233, 0.2);
            padding: var(--spacing-2) 0;
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--white);
            display: flex;
            align-items: center;
            gap: var(--spacing-2);
            text-decoration: none;
            white-space: nowrap;
        }

            .navbar-brand:hover {
                color: var(--sky-blue);
            }

            .navbar-brand i {
                color: var(--sky-blue);
                font-size: 1.5rem;
            }

        .nav-link {
            font-weight: 600;
            color: var(--slate-light) !important;
            padding: var(--spacing-2) var(--spacing-3);
            margin: 0;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.875rem;
            white-space: nowrap;
        }

            .nav-link i {
                color: var(--sky-blue);
                margin-right: var(--spacing-2);
                font-size: 0.95rem;
            }

            .nav-link:hover {
                color: var(--white) !important;
                background: rgba(14, 165, 233, 0.1);
            }

        .header-search-box {
            position: relative;
            max-width: 280px;
            width: 100%;
        }

            .header-search-box input {
                padding: var(--spacing-2) var(--spacing-3) var(--spacing-2) 2.5rem;
                border: 2px solid rgba(14, 165, 233, 0.3);
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                border-radius: 999px;
                color: var(--white);
                font-size: 0.875rem;
            }

                .header-search-box input::placeholder {
                    color: var(--slate-light);
                }

                .header-search-box input:focus {
                    outline: none;
                    border-color: var(--sky-blue);
                    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
                }

            .header-search-box i {
                position: absolute;
                left: var(--spacing-3);
                top: 50%;
                transform: translateY(-50%);
                color: var(--sky-blue);
                font-size: 1rem;
            }

        .btn-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(14, 165, 233, 0.3);
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            transition: all 0.3s ease;
        }

            .btn-icon:hover {
                background: var(--sky-blue);
                border-color: var(--sky-blue);
                transform: scale(1.1);
            }

            .btn-icon i {
                color: var(--sky-blue);
                font-size: 1.1rem;
            }

            .btn-icon:hover i {
                color: var(--white);
            }

        .btn-create-trip {
            background: linear-gradient(135deg, var(--sky-blue), var(--sky-light));
            color: var(--white);
            border: none;
            padding: var(--spacing-2) var(--spacing-4);
            border-radius: 999px;
            font-weight: 600;
            box-shadow: 0 4px 20px rgba(14, 165, 233, 0.3);
            font-size: 0.875rem;
            white-space: nowrap;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-create-trip:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 28px rgba(14, 165, 233, 0.45);
                color: var(--white);
            }

            .btn-create-trip i {
                font-size: 0.95rem;
            }

        .avatar-dropdown img {
            width: 38px;
            height: 38px;
            border: 2px solid rgba(14, 165, 233, 0.4);
            cursor: pointer;
        }

            .avatar-dropdown img:hover {
                border-color: var(--sky-blue);
                box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
            }

        .navbar-nav {
            gap: 0;
        }

            .navbar-nav .nav-item {
                margin: 0;
            }

        .container {
            max-width: 1400px;
        }

        .d-flex.align-items-center {
            gap: 0.375rem !important;
        }

        .dropdown-menu {
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(14, 165, 233, 0.2);
            border-radius: 16px;
            padding: var(--spacing-2);
            box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2);
            min-width: 200px;
        }

        .dropdown-item {
            color: var(--slate-light);
            padding: var(--spacing-3) var(--spacing-4);
            border-radius: 10px;
            margin-bottom: var(--spacing-2);
        }

            .dropdown-item:hover {
                background: rgba(14, 165, 233, 0.15);
                color: var(--white);
            }

            .dropdown-item i {
                color: var(--sky-blue);
                width: 24px;
            }

        .dropdown-divider {
            border-color: rgba(14, 165, 233, 0.2);
        }

        /* BREADCRUMB */
        .breadcrumb-wrapper {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            padding: var(--spacing-4) 0;
            border-bottom: 1px solid var(--slate-200);
            position: sticky;
            top: 62px;
            z-index: 1020;
        }

        .breadcrumb {
            background: transparent;
            margin-bottom: 0;
        }

        .breadcrumb-item a {
            color: var(--sky-blue);
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: var(--deep-slate);
            font-weight: 600;
        }

        /* FOOTER */
        footer {
            background: linear-gradient(135deg, #0f172a, var(--deep-slate));
            color: var(--slate-light);
            padding: var(--spacing-16) 0 0;
            border-top: 3px solid var(--sky-blue);
            margin-top: auto;
        }

            footer h5 {
                color: var(--white);
                font-weight: 700;
                margin-bottom: var(--spacing-6);
                padding-bottom: var(--spacing-3);
                position: relative;
            }

                footer h5::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 40px;
                    height: 3px;
                    background: var(--sky-blue);
                }

            footer a {
                color: var(--slate-light);
                text-decoration: none;
                display: inline-block;
                margin-bottom: var(--spacing-3);
            }

                footer a:hover {
                    color: var(--sky-blue);
                    transform: translateX(5px);
                }

        .social-icons {
            display: flex;
            gap: var(--spacing-3);
            margin-top: var(--spacing-6);
        }

            .social-icons a {
                width: 48px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(14, 165, 233, 0.1);
                border: 2px solid rgba(14, 165, 233, 0.2);
                border-radius: 12px;
            }

                .social-icons a:hover {
                    background: var(--sky-blue);
                    transform: translateY(-4px);
                }

            .social-icons i {
                color: var(--sky-blue);
                font-size: 1.25rem;
            }

            .social-icons a:hover i {
                color: var(--white);
            }

        .footer-bottom {
            border-top: 1px solid rgba(14, 165, 233, 0.2);
            margin-top: var(--spacing-12);
            padding: var(--spacing-8) 0;
            text-align: center;
            color: #64748b;
        }

        /* MOBILE */
        .navbar-toggler {
            border: 2px solid rgba(14, 165, 233, 0.3);
        }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        .offcanvas {
            background: var(--deep-slate);
        }

        .offcanvas-title {
            color: var(--white);
            display: flex;
            align-items: center;
            gap: var(--spacing-2);
        }

            .offcanvas-title i {
                color: var(--sky-blue);
            }

        .btn-close {
            filter: invert(1);
        }

        @@media (max-width: 991px) {
            .header-search-box {
                max-width: 100%;
                margin: var(--spacing-4) 0;
            }

            .btn-create-trip {
                width: 100%;
                margin-top: var(--spacing-4);
            }
        }

        /* CUSTOM PREMIUM TOAST NOTIFICATION SYSTEM */
        .toast-wrapper {
            position: fixed;
            top: 85px;
            right: 20px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 380px;
            width: 90%;
            pointer-events: none;
        }

        .custom-toast {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            display: flex;
            gap: 12px;
            align-items: flex-start;
            position: relative;
            overflow: hidden;
            pointer-events: auto;
            animation: toastSlideIn 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
            transition: all 0.3s ease;
        }

        .custom-toast.toast-hide {
            animation: toastSlideOut 0.3s ease forwards;
        }

        @@keyframes toastSlideIn {
            from {
                transform: translateX(120%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes toastSlideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(120%);
                opacity: 0;
            }
        }

        .custom-toast.success { border-left: 5px solid #10b981; }
        .custom-toast.error { border-left: 5px solid #f43f5e; }
        .custom-toast.warning { border-left: 5px solid #f59e0b; }
        .custom-toast.info { border-left: 5px solid #0ea5e9; }

        .toast-icon {
            font-size: 1.4rem;
            flex-shrink: 0;
        }
        .custom-toast.success .toast-icon { color: #10b981; }
        .custom-toast.error .toast-icon { color: #f43f5e; }
        .custom-toast.warning .toast-icon { color: #f59e0b; }
        .custom-toast.info .toast-icon { color: #0ea5e9; }

        .toast-content {
            flex: 1;
            min-width: 0;
        }

        .toast-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .toast-message {
            font-size: 0.85rem;
            color: #cbd5e1;
            line-height: 1.4;
        }

        .toast-close {
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 1.25rem;
            padding: 0;
            line-height: 1;
            transition: color 0.2s;
        }
        .toast-close:hover {
            color: #ffffff;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 100%;
        }
        .custom-toast.success .toast-progress { background: #10b981; }
        .custom-toast.error .toast-progress { background: #f43f5e; }
        .custom-toast.warning .toast-progress { background: #f59e0b; }
        .custom-toast.info .toast-progress { background: #0ea5e9; }

        @@keyframes toastProgress {
            from { width: 100%; }
            to { width: 0%; }
        }

        /* CUSTOM MODERN CONFIRM MODAL SYSTEM */
        .custom-modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 100000;
            display: none;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .custom-modal-backdrop.open {
            display: flex;
            opacity: 1;
        }

        .custom-modal-box {
            background: #ffffff;
            border-radius: 24px;
            max-width: 480px;
            width: 90%;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            transform: scale(0.85);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-modal-backdrop.open .custom-modal-box {
            transform: scale(1);
            opacity: 1;
        }

        .custom-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            border-bottom: 1px solid #e2e8f0;
        }

        .custom-modal-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 800;
            color: #1e293b;
        }

        .custom-modal-close {
            background: transparent;
            border: none;
            color: #64748b;
            cursor: pointer;
            font-size: 1.5rem;
            padding: 0;
            line-height: 1;
            transition: color 0.2s;
        }
        .custom-modal-close:hover {
            color: #0f172a;
        }

        .custom-modal-body {
            padding: 24px;
            font-size: 0.95rem;
            color: #475569;
            line-height: 1.6;
        }

        .custom-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding: 16px 24px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
        }

        .modal-btn {
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }

        .modal-btn-cancel {
            background: #e2e8f0;
            color: #334155;
        }
        .modal-btn-cancel:hover {
            background: #cbd5e1;
        }

        .modal-btn-confirm {
            background: #0ea5e9;
            color: #ffffff;
        }
        .modal-btn-confirm:hover {
            background: #0284c7;
        }

        .modal-btn-confirm.danger {
            background: #f43f5e;
            color: #ffffff;
        }
        .modal-btn-confirm.danger:hover {
            background: #e11d48;
        }
    </style>
</head>
<body>
    <!-- TOPBAR -->
    <div class="topbar">
        <div class="container">
            <div class="topbar-content">
                <div class="topbar-item">
                    <i class="bi bi-fire"></i>
                    <span>Địa điểm hot: Sapa, Phú Quốc, Đà Lạt</span>
                </div>
                <div class="topbar-item">
                    <i class="bi bi-calendar-event"></i>
                    <span>Mùa xuân - Thời điểm lý tưởng khám phá miền Bắc</span>
                </div>
                <div class="topbar-item">
                    <i class="bi bi-star"></i>
                    <span>100+ địa danh mới được cập nhật</span>
                </div>
            </div>
        </div>
    </div>

    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg header-glass">
        <div class="container">
            <a class="navbar-brand" href="/Home/Index">
                <i class="bi bi-compass"></i>
                <span>VietScape</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">
                        <i class="bi bi-compass"></i>
                        <span>VietScape</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
                <div class="offcanvas-body">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownExplore" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-binoculars"></i>Khám phá
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownExplore">
                                <li><a class="dropdown-item" href="/Home/AllPlaces"><i class="bi bi-collection me-2"></i>Tất cả địa điểm</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Home/AllPlaces?region=Bắc"><i class="bi bi-geo-alt me-2"></i>Miền Bắc</a></li>
                                <li><a class="dropdown-item" href="/Home/AllPlaces?region=Trung"><i class="bi bi-geo-alt me-2"></i>Miền Trung</a></li>
                                <li><a class="dropdown-item" href="/Home/AllPlaces?region=Nam"><i class="bi bi-geo-alt me-2"></i>Miền Nam</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Map">
                                <i class="bi bi-map"></i>Bản đồ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Blog">
                                <i class="bi bi-journal-text"></i>Blog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Schedule">
                                <i class="bi bi-calendar-event"></i>Lịch trình
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-nowrap">
                        <div class="header-search-box d-none d-lg-block">
                            <input type="text" class="form-control" placeholder="Tìm địa điểm...">
                            <i class="bi bi-search"></i>
                        </div>



                        <a href="/Home/Createschedule" class="btn-create-trip d-none d-lg-flex" style="text-decoration: none; display: inline-flex !important; align-items: center;">
                            <i class="bi bi-plus-circle me-1"></i>Tạo lịch trình
                        </a>

                        @using LTW_CK_QuangBaVietNam.Models

                        @{
                            var user = Session["nguoiDung"] as NguoiDung;
                        }

                        @if (user != null && user.VaiTro == 1)
                        {
                            <a href="@Url.Action("Index","Admin")"
                               class="btn-create-trip d-none d-lg-flex align-items-center justify-content-center"
                               title="Về trang Admin">
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                            </a>
                        }
                        <div id="authSection">
                            @if (Session["nguoiDung"] != null)
                            {
                                var currentUser = (LTW_CK_QuangBaVietNam.Models.NguoiDung)Session["nguoiDung"];
                                var userName = !string.IsNullOrWhiteSpace(currentUser.HoTen) ? currentUser.HoTen : "User";
                                <div class="avatar-dropdown dropdown">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(userName)&background=0EA5E9&color=fff"
                                         class="rounded-circle"
                                         data-bs-toggle="dropdown"
                                         alt="Avatar"
                                         style="width: 38px; height: 38px; border: 2px solid rgba(14, 165, 233, 0.4); cursor: pointer;">
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Home/Profile"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/Login/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <a href="/Home/Login" class="btn-create-trip" style="text-decoration: none; display: inline-flex !important; align-items: center;">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                    </a>
                                    <a href="/Home/Register" class="btn-create-trip" style="text-decoration: none; display: inline-flex !important; align-items: center;">
                                        <i class="bi bi-person-plus me-1"></i>Đăng ký
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="header-search-box d-lg-none mt-3">
                        <input type="text" class="form-control" placeholder="Tìm địa điểm...">
                        <i class="bi bi-search"></i>
                    </div>

                    <a href="/Home/Createschedule" class="btn-create-trip d-lg-none" style="text-decoration: none; display: block;">
                        <i class="bi bi-plus-circle me-2"></i>Tạo lịch trình
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main>
        @if (ViewBag.Breadcrumbs != null)
        {
            <div class="breadcrumb-wrapper">
                <div class="container">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><i class="bi bi-house-door-fill me-1"></i></li>
                            @foreach (var crumb in ViewBag.Breadcrumbs)
                            {
                                string url = null;
                                try { url = crumb.Url != null ? crumb.Url.ToString() : null; } catch { }
                                string name = null;
                                try { name = crumb.Name != null ? crumb.Name.ToString() : null; } catch { }

                                if (string.IsNullOrEmpty(url))
                                {
                                    <li class="breadcrumb-item active" aria-current="page">@name</li>
                                }
                                else
                                {
                                    <li class="breadcrumb-item"><a href="@url">@name</a></li>
                                }
                            }
                        </ol>
                    </nav>
                </div>
            </div>
        }

        @RenderBody()
    </main>

