@{
    Layout = null;

    var pageTitle = ViewBag.Title ?? "Admin";
    var actionName = (ViewContext.RouteData.Values["action"] ?? "").ToString().ToLower();

    Func<string, string> Active = a =>
        actionName == (a ?? "").ToLower() ? "active" : "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    <title>@pageTitle</title>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f6f9ff;
            --bg2: #eef5ff;
            --card: #fff;
            --border: rgba(15,23,42,.10);
            --text: #0f172a;
            --muted: rgba(15,23,42,.62);
            --primary: #2563eb;
            --primary2: #0ea5e9;
            --shadow: 0 10px 30px rgba(2,6,23,.08);
            --radius: 16px;
        }

        body {
            font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
            color: var(--text);
            background: radial-gradient(900px 500px at 10% 0%, rgba(37,99,235,.12), transparent 60%), radial-gradient(900px 500px at 85% 10%, rgba(14,165,233,.12), transparent 55%), linear-gradient(180deg, var(--bg) 0%, var(--bg2) 60%, var(--bg) 100%);
            min-height: 100vh;
        }

        .adm-shell {
            min-height: 100vh;
        }

        /* ===== Sidebar ===== */
        .adm-sidebar {
            width: 290px;
            background: rgba(255,255,255,.94);
            border-right: 1px solid var(--border);
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            backdrop-filter: blur(10px);
        }

        .adm-brand {
            padding: 18px 16px;
            border-bottom: 1px solid var(--border);
        }

        .adm-logo {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            box-shadow: 0 14px 30px rgba(37,99,235,.25);
            color: #fff;
        }

        .brand-title {
            font-weight: 700;
            letter-spacing: .2px;
        }

        .brand-sub {
            color: var(--muted);
            font-size: .86rem;
        }

        .adm-nav {
            padding: 12px;
        }

        .adm-heading {
            font-size: .76rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(15,23,42,.55);
            padding: 14px 10px 8px;
        }

        .adm-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 14px;
            text-decoration: none;
            color: rgba(15,23,42,.78);
            border: 1px solid transparent;
            transition: all .15s ease;
            margin-bottom: 6px;
        }

            .adm-link i {
                width: 20px;
                text-align: center;
                color: rgba(37,99,235,.85);
            }

            .adm-link:hover {
                background: rgba(37,99,235,.06);
                border-color: rgba(37,99,235,.12);
                color: var(--text);
            }

            .adm-link.active {
                background: linear-gradient(135deg, rgba(37,99,235,.12), rgba(14,165,233,.10));
                border-color: rgba(37,99,235,.18);
                box-shadow: 0 10px 30px rgba(37,99,235,.10);
                color: var(--text);
            }

        .adm-badge {
            margin-left: auto;
            font-size: .72rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(34,197,94,.12);
            border: 1px solid rgba(34,197,94,.25);
            color: rgba(15,23,42,.85);
        }

        /* ===== Topbar (NEW - gọn, sạch) ===== */
        .adm-topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(255,255,255,.92);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
        }

        .text-soft {
            color: var(--muted);
        }

        .adm-pill {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, rgba(37,99,235,.14), rgba(14,165,233,.12));
            border: 1px solid rgba(37,99,235,.18);
            color: rgba(37,99,235,.95);
            flex: 0 0 auto;
        }

        .adm-search2 {
            display: flex;
            align-items: center;
            gap: 10px;
            height: 44px;
            padding: 0 12px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            box-shadow: 0 8px 24px rgba(2,6,23,.05);
        }

            .adm-search2 i {
                color: rgba(15,23,42,.45);
            }

            .adm-search2 input {
                height: 40px;
            }

        .adm-kbd {
            margin-left: auto;
            font-size: .78rem;
            padding: 3px 8px;
            border-radius: 10px;
            border: 1px solid rgba(15,23,42,.12);
            color: rgba(15,23,42,.55);
            background: rgba(15,23,42,.02);
        }

        .adm-iconbtn {
            height: 44px;
            width: 44px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            box-shadow: 0 8px 24px rgba(2,6,23,.05);
            display: grid;
            place-items: center;
        }

            .adm-iconbtn:hover {
                background: rgba(37,99,235,.06);
                border-color: rgba(37,99,235,.18);
            }

        .adm-btnprimary {
            height: 44px;
            border-radius: 14px;
            padding: 0 14px;
            border: none;
            color: #fff;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            box-shadow: 0 12px 30px rgba(37,99,235,.20);
        }

            .adm-btnprimary:hover {
                filter: brightness(.98);
                color: #fff;
            }

        .adm-dot {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: #ef4444;
            border: 2px solid #fff;
        }

        .adm-userbtn {
            height: 44px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            box-shadow: 0 8px 24px rgba(2,6,23,.05);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 12px;
        }

        .adm-avatar2 {
            width: 32px;
            height: 32px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            color: #fff;
            font-weight: 700;
        }

        .adm-menu {
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.10);
            overflow: hidden;
            min-width: 320px;
        }

        .adm-miniCircle {
            width: 34px;
            height: 34px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(15,23,42,.08);
            flex: 0 0 auto;
        }

        /* ===== Content ===== */
        .adm-content {
            padding: 20px;
        }

        .adm-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .adm-footer {
            margin-top: 18px;
            color: rgba(15,23,42,.55);
            font-size: .86rem;
        }

        /* Mobile: hide sidebar */
        @@media (max-width: 991.98px) {
            .adm-sidebar {
                display: none;
            }
        }

        /* CUSTOM PREMIUM TOAST NOTIFICATION SYSTEM */
        .toast-wrapper {
            position: fixed;
            top: 85px;
            right: 20px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 380px;
            width: 90%;
            pointer-events: none;
        }

        .custom-toast {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            display: flex;
            gap: 12px;
            align-items: flex-start;
            position: relative;
            overflow: hidden;
            pointer-events: auto;
            animation: toastSlideIn 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
            transition: all 0.3s ease;
        }

        .custom-toast.toast-hide {
            animation: toastSlideOut 0.3s ease forwards;
        }

        @@keyframes toastSlideIn {
            from {
                transform: translateX(120%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes toastSlideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(120%);
                opacity: 0;
            }
        }

        .custom-toast.success { border-left: 5px solid #10b981; }
        .custom-toast.error { border-left: 5px solid #f43f5e; }
        .custom-toast.warning { border-left: 5px solid #f59e0b; }
        .custom-toast.info { border-left: 5px solid #0ea5e9; }

        .toast-icon {
            font-size: 1.4rem;
            flex-shrink: 0;
        }
        .custom-toast.success .toast-icon { color: #10b981; }
        .custom-toast.error .toast-icon { color: #f43f5e; }
        .custom-toast.warning .toast-icon { color: #f59e0b; }
        .custom-toast.info .toast-icon { color: #0ea5e9; }

        .toast-content {
            flex: 1;
            min-width: 0;
        }

        .toast-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .toast-message {
            font-size: 0.85rem;
            color: #cbd5e1;
            line-height: 1.4;
        }

        .toast-close {
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 1.25rem;
            padding: 0;
            line-height: 1;
            transition: color 0.2s;
        }
        .toast-close:hover {
            color: #ffffff;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 100%;
        }
        .custom-toast.success .toast-progress { background: #10b981; }
        .custom-toast.error .toast-progress { background: #f43f5e; }
        .custom-toast.warning .toast-progress { background: #f59e0b; }
        .custom-toast.info .toast-progress { background: #0ea5e9; }

        @@keyframes toastProgress {
            from { width: 100%; }
            to { width: 0%; }
        }

        /* CUSTOM MODERN CONFIRM MODAL SYSTEM */
        .custom-modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 100000;
            display: none;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .custom-modal-backdrop.open {
            display: flex;
            opacity: 1;
        }

        .custom-modal-box {
            background: #ffffff;
            border-radius: 24px;
            max-width: 480px;
            width: 90%;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            transform: scale(0.85);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-modal-backdrop.open .custom-modal-box {
            transform: scale(1);
            opacity: 1;
        }

        .custom-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            border-bottom: 1px solid #e2e8f0;
        }

        .custom-modal-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 800;
            color: #1e293b;
        }

        .custom-modal-close {
            background: transparent;
            border: none;
            color: #64748b;
            cursor: pointer;
            font-size: 1.5rem;
            padding: 0;
            line-height: 1;
            transition: color 0.2s;
        }
        .custom-modal-close:hover {
            color: #0f172a;
        }

        .custom-modal-body {
            padding: 24px;
            font-size: 0.95rem;
            color: #475569;
            line-height: 1.6;
        }

        .custom-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding: 16px 24px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
        }

        .modal-btn {
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }

        .modal-btn-cancel {
            background: #e2e8f0;
            color: #334155;
        }
        .modal-btn-cancel:hover {
            background: #cbd5e1;
        }

        .modal-btn-confirm {
            background: #0ea5e9;
            color: #ffffff;
        }
        .modal-btn-confirm:hover {
            background: #0284c7;
        }

        .modal-btn-confirm.danger {
            background: #f43f5e;
            color: #ffffff;
        }
        .modal-btn-confirm.danger:hover {
            background: #e11d48;
        }
    </style>

    @RenderSection("styles", required: false)
</head>

<body>
    <div class="container-fluid adm-shell">
        <div class="row g-0">


            <aside class="col-auto adm-sidebar">
                <div class="adm-brand d-flex align-items-center gap-3">
                    <div class="adm-logo">
                        <i class="fa-solid fa-mountain-sun"></i>
                    </div>
                    <div>
                        <div class="brand-title">Admin Panel</div>
                        <div class="brand-sub">Quản trị Du lịch Việt Nam</div>
                    </div>
                </div>

                <nav class="adm-nav">
                    <div class="adm-heading">Tổng quan</div>

                    <a class="adm-link @(Active("index"))" href="@Url.Action("Index","Admin")">
                        <i class="fa-solid fa-gauge-high"></i> Dashboard
                    </a>

                    <a class="adm-link @(Active("thongkebaocao"))" href="@Url.Action("ThongKeBaoCao","Admin")">
                        <i class="fa-solid fa-chart-line"></i> Thống kê & Báo cáo
                        <span class="adm-badge">NEW</span>
                    </a>

                    <div class="adm-heading mt-2">Quản lý nội dung</div>

                    <a class="adm-link @(Active("diadiem"))" href="@Url.Action("DiaDiem","Admin")">
                        <i class="fa-solid fa-location-dot"></i> Danh lam thắng cảnh
                    </a>

                    <a class="adm-link @(Active("danhmuc"))" href="@Url.Action("DanhMuc","Admin")">
                        <i class="fa-solid fa-layer-group"></i> Danh mục địa điểm
                    </a>

                    <a class="adm-link @(Active("blog"))" href="@Url.Action("Blog","Admin")">
                        <i class="fa-solid fa-pen-nib"></i> Bài viết Blog
                    </a>

                    <a class="adm-link @(Active("comments"))" href="@Url.Action("Comments","Admin")">
                        <i class="fa-solid fa-comments"></i> Quản lý bình luận
                    </a>

                    <div class="adm-heading mt-2">Quản trị hệ thống</div>

                    <a class="adm-link @(Active("nguoidung"))" href="@Url.Action("NguoiDung","Admin")">
                        <i class="fa-solid fa-users"></i> Người dùng
                    </a>


                    <div class="mt-3 pt-3" style="border-top:1px solid rgba(15,23,42,.10)">
                        <a class="adm-link" href="@Url.Action("Index","Home")">
                            <i class="fa-solid fa-arrow-left"></i> Về website
                        </a>
                        <a class="adm-link"
                           href="@Url.Action("Logout", "Login")">
                            <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                        </a>
                    </div>
                </nav>
            </aside>

            <!-- MAIN -->
            <main class="col">

                <header class="adm-topbar">
                    <div class="container-fluid py-2 py-md-3">
                        <div class="d-flex align-items-center justify-content-between gap-3">


                            <div class="d-flex align-items-center gap-2 gap-md-3">
                                <button class="btn adm-iconbtn d-lg-none"
                                        type="button"
                                        data-bs-toggle="offcanvas"
                                        data-bs-target="#admOffcanvas"
                                        aria-controls="admOffcanvas">
                                    <i class="fa-solid fa-bars"></i>
                                </button>

                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="adm-pill">
                                            <i class="fa-solid fa-shield-halved"></i>
                                        </span>
                                        <div class="fw-semibold" style="font-size:1.05rem;">@pageTitle</div>
                                    </div>
                                    <div class="small text-soft">Hệ thống quảng bá danh lam thắng cảnh Việt Nam</div>
                                </div>
                            </div>


                            <!--<div class="d-none d-md-block flex-grow-1" style="max-width:560px;">
                                <div class="input-group bg-white rounded-pill shadow-sm border overflow-hidden">-->

                                    @*<input type="text"
                                           class="form-control border-0 shadow-none px-4 py-2"
                                           placeholder="Tìm địa điểm, danh mục, người dùng..." />

                                    <button class="btn border-0 px-4 bg-white">
                                        <i class="fa-solid fa-magnifying-glass text-primary"></i>
                                    </button>*@

                                <!--</div>
                            </div>-->

                            <!-- RIGHT -->
                            <div class="d-flex align-items-center gap-2">
                                <a class="btn adm-btnprimary d-none d-lg-inline-flex align-items-center gap-2"
                                   href="@Url.Action("DiaDiem","Admin")">
                                    <i class="fa-solid fa-plus"></i>
                                    <span>Địa điểm</span>
                                </a>


                                <div class="dropdown">
                                    <button class="btn adm-iconbtn position-relative" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-regular fa-bell"></i>
                                        <span class="adm-dot"></span>
                                    </button>

                                    <div class="dropdown-menu dropdown-menu-end p-0 adm-menu">
                                        <div class="px-3 py-2 border-bottom">
                                            <div class="fw-semibold">Thông báo</div>
                                            <div class="small text-soft">Mới nhất</div>
                                        </div>

                                      
                                        <div class="border-top">
                                            <a class="dropdown-item text-center py-2" href="@Url.Action("ThongKeBaoCao","Admin")">
                                                Xem báo cáo
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- User -->
                                <div id="authSection">
                                    @if (Session["nguoiDung"] != null)
                                    {
                                        var currentUser = (LTW_CK_QuangBaVietNam.Models.NguoiDung)Session["nguoiDung"];
                                        var userName = !string.IsNullOrWhiteSpace(currentUser.HoTen)
                                            ? currentUser.HoTen
                                            : "User";

                                        <div class="dropdown">
                                            <button class="btn adm-userbtn d-flex align-items-center gap-2"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">

                                                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(userName)&background=0EA5E9&color=fff" 
                                                     class="rounded-circle"
                                                     alt="Avatar"
                                                     style="width:38px; height:38px; border:2px solid rgba(14,165,233,.4);" />

                                                <span class="fw-medium d-none d-md-inline">@userName</span>

                                                <i class="fa-solid fa-chevron-down small text-soft d-none d-md-inline"></i>
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end adm-menu">
                                                

                                                <li><hr class="dropdown-divider"></li>

                                                <li>
                                                    <a class="dropdown-item text-danger" href="/Login/Logout">
                                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2">
                                            <a href="/Home/Login"
                                               class="btn-create-trip"
                                               style="text-decoration:none; display:inline-flex; align-items:center;">
                                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                                Đăng nhập
                                            </a>
                                        </div>
                                    }
                                </div>

                        </div>
                    </div>


                </header>
                <div class="adm-content">
                    @RenderBody()

                    <div class="adm-footer">
                        © @DateTime.Now.Year - Admin | Website Quảng bá Danh lam thắng cảnh Việt Nam
                    </div>
                </div>

            </main>

        </div>
    </div>
    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toast-wrapper" class="toast-wrapper"></div>

    <!-- CUSTOM CONFIRM MODAL CONTAINER -->
    <div id="custom-modal-backdrop" class="custom-modal-backdrop">
        <div class="custom-modal-box">
            <div class="custom-modal-header">
                <h4 id="custom-modal-title" class="custom-modal-title">Xác nhận</h4>
                <button class="custom-modal-close" onclick="closeConfirmModal()">&times;</button>
            </div>
            <div class="custom-modal-body">
                <p id="custom-modal-message">Nội dung thông báo...</p>
            </div>
            <div class="custom-modal-footer">
                <button id="custom-modal-cancel" class="modal-btn modal-btn-cancel" onclick="closeConfirmModal()">Hủy</button>
                <button id="custom-modal-confirm" class="modal-btn modal-btn-confirm">Đồng ý</button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function showToast(title, message, type = 'info', duration = 4000) {
            // Support legacy 2-argument signature: showToast(message, type)
            if (arguments.length === 2 && (message === 'success' || message === 'error' || message === 'warning' || message === 'info')) {
                type = message;
                message = title;
                title = type === 'success' ? 'Thành công' : (type === 'error' ? 'Thất bại' : (type === 'warning' ? 'Cảnh báo' : 'Thông báo'));
            }

            const container = document.getElementById('toast-wrapper');
            if (!container) return;

            const toastId = 'toast-' + Date.now();
            const icons = {
                success: 'bi-check-circle-fill',
                error: 'bi-x-circle-fill',
                warning: 'bi-exclamation-triangle-fill',
                info: 'bi-info-circle-fill'
            };

            const iconClass = icons[type] || icons.info;

            const toastHTML = `
                <div id="${toastId}" class="custom-toast ${type}">
                    <i class="bi ${iconClass} toast-icon"></i>
                    <div class="toast-content">
                        <div class="toast-title">${title}</div>
                        <div class="toast-message">${message}</div>
                    </div>
                    <button class="toast-close" onclick="removeToast('${toastId}')">&times;</button>
                    <div class="toast-progress" style="animation: toastProgress ${duration}ms linear forwards;"></div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', toastHTML);

            const toastElement = document.getElementById(toastId);
            
            const timeout = setTimeout(() => {
                removeToast(toastId);
            }, duration);

            toastElement.dataset.timeoutId = timeout;
        }

        function removeToast(toastId) {
            const el = document.getElementById(toastId);
            if (!el) return;

            if (el.dataset.timeoutId) {
                clearTimeout(parseInt(el.dataset.timeoutId));
            }

            el.classList.add('toast-hide');
            setTimeout(() => {
                el.remove();
            }, 300);
        }

        // --- CUSTOM CONFIRM MODAL SYSTEM ---
        let confirmModalCallback = null;

        function showConfirmModal(title, message, onConfirm, isDanger = false) {
            const backdrop = document.getElementById('custom-modal-backdrop');
            const titleEl = document.getElementById('custom-modal-title');
            const messageEl = document.getElementById('custom-modal-message');
            const confirmBtn = document.getElementById('custom-modal-confirm');

            if (!backdrop || !titleEl || !messageEl || !confirmBtn) return;

            titleEl.textContent = title;
            messageEl.innerHTML = message;
            
            if (isDanger) {
                confirmBtn.className = 'modal-btn modal-btn-confirm danger';
            } else {
                confirmBtn.className = 'modal-btn modal-btn-confirm';
            }

            confirmModalCallback = onConfirm;

            backdrop.style.display = 'flex';
            backdrop.offsetHeight; // Force reflow
            backdrop.classList.add('open');
        }

        function closeConfirmModal() {
            const backdrop = document.getElementById('custom-modal-backdrop');
            if (!backdrop) return;

            backdrop.classList.remove('open');
            setTimeout(() => {
                backdrop.style.display = 'none';
                confirmModalCallback = null;
            }, 300);
        }

        // Overwrite window.alert to direct to showToast
        window.alert = function(message) {
            showToast('Thông báo', message, 'info');
        };

        // DOM Loaded Listeners
        document.addEventListener('DOMContentLoaded', () => {
            const confirmBtn = document.getElementById('custom-modal-confirm');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', () => {
                    if (typeof confirmModalCallback === 'function') {
                        confirmModalCallback();
                    }
                    closeConfirmModal();
                });
            }

            const backdrop = document.getElementById('custom-modal-backdrop');
            if (backdrop) {
                backdrop.addEventListener('click', (e) => {
                    if (e.target === backdrop) {
                        closeConfirmModal();
                    }
                });
            }

            // Global interception of form onsubmit with confirm()
            if (typeof jQuery !== 'undefined') {
                jQuery(document).on('submit', 'form', function(e) {
                    const onsubmitAttr = jQuery(this).attr('onsubmit');
                    if (onsubmitAttr && onsubmitAttr.includes('confirm(')) {
                        e.preventDefault();
                        
                        const match = onsubmitAttr.match(/confirm\(['"](.*?)['"]\)/);
                        const msg = match ? match[1] : 'Bạn có chắc chắn muốn thực hiện hành động này?';
                        
                        const form = this;
                        showConfirmModal('Xác nhận', msg, () => {
                            const oldOnsubmit = jQuery(form).attr('onsubmit');
                            jQuery(form).removeAttr('onsubmit');
                            form.submit();
                            jQuery(form).attr('onsubmit', oldOnsubmit);
                        }, true);
                        
                        return false;
                    }
                });
            }
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>