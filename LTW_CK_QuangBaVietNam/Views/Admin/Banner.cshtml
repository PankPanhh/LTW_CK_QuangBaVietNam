@{
    ViewBag.Title = "Quản lý banner trang chủ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = ((ViewBag.Filter ?? "all").ToString()).ToLower(); 
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold"><i class="fa-regular fa-images text-primary me-2"></i>Quản lý banner</div>
                <div class="text-muted small">Banner quảng bá + sắp xếp thứ tự hiển thị</div>
            </div>

            <ul class="nav nav-pills">
                <li class="nav-item"><a class="nav-link @(filter=="all"?"active":"")" href="@Url.Action("Banner","Admin", new { filter="all" })">Tất cả</a></li>
                <li class="nav-item"><a class="nav-link @(filter=="showing"?"active":"")" href="@Url.Action("Banner","Admin", new { filter="showing" })">Hiển thị</a></li>
                <li class="nav-item"><a class="nav-link @(filter=="hidden"?"active":"")" href="@Url.Action("Banner","Admin", new { filter="hidden" })">Ẩn</a></li>
            </ul>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Banner</th>
                    <th>Liên kết</th>
                    <th>Thứ tự</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (filter == "all" || filter == "showing")
                {
                    <tr>
                        <td class="fw-semibold">Banner #1</td>
                        <td class="text-muted">/Home/ChiTiet/1</td>
                        <td>1</td>
                        <td><span class="badge bg-success">Hiển thị</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-regular fa-trash-can"></i></button>
                            </div>
                        </td>
                    </tr>
                }

                @if (filter == "all" || filter == "hidden")
                {
                    <tr>
                        <td class="fw-semibold">Banner #2</td>
                        <td class="text-muted">/Home/ChiTiet/2</td>
                        <td>2</td>
                        <td><span class="badge bg-secondary">Ẩn</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-regular fa-trash-can"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>