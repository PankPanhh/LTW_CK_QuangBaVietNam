@using System
@using System.Linq
@using LTW_CK_QuangBaVietNam.Models
@model DiaDiemRowVM

@{
    ViewBag.Title = "Thêm địa điểm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var dmList = ViewBag.DanhMucList as IEnumerable<DanhMuc>;
    if (dmList == null) { dmList = new DanhMuc[0]; }
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
        <div class="fw-semibold">
            <i class="fa-solid fa-plus text-primary me-2"></i>Thêm địa điểm
        </div>
        <a class="btn btn-outline-secondary" href="@Url.Action("DiaDiem","Admin")">
            <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card-body">

        @* Thông báo *@
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        }

        @using (Html.BeginForm("TaoDiaDiem", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3">

                <!-- TenDiaDiem + Slug (Slug NOT NULL) -->
                <div class="col-12 col-lg-6">
                    <label class="form-label">Tên địa điểm *</label>
                    @Html.TextBoxFor(m => m.TenDiaDiem, new { @class = "form-control", required = "required", id = "TenDiaDiem" })
                    @Html.ValidationMessageFor(m => m.TenDiaDiem, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Slug * (không dấu, không khoảng trắng)</label>
                    @Html.TextBoxFor(m => m.Slug, new { @class = "form-control", required = "required", id = "Slug", placeholder = "vd: pho-co-hoi-an" })
                    @Html.ValidationMessageFor(m => m.Slug, "", new { @class = "text-danger small" })

                </div>

                <!-- MaDanhMuc NOT NULL -->
                <div class="col-12 col-lg-4">
                    <label class="form-label">Danh mục *</label>
                    <select class="form-select" name="MaDanhMuc" required>
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var dm in dmList)
                        {
                            <option value="@dm.MaDanhMuc" @(Model != null && Model.MaDanhMuc == dm.MaDanhMuc ? "selected" : "")>
                                @dm.TenDanhMuc
                            </option>
                        }
                    </select>
                    @Html.ValidationMessage("MaDanhMuc", "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 col-lg-4">
                    <label class="form-label">Vùng miền</label>
                    <select class="form-select" name="VungMien">
                        <option value="">-- Chọn vùng --</option>
                        <option value="Miền Bắc">Miền Bắc</option>
                        <option value="Miền Trung">Miền Trung</option>
                        <option value="Miền Nam">Miền Nam</option>
                    </select>
                    @Html.ValidationMessage("VungMien", "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 col-lg-4">
                    <label class="form-label">Tỉnh/Thành</label>
                    @Html.TextBoxFor(m => m.TinhThanh, new { @class = "form-control", placeholder = "VD: Quảng Nam / Đà Nẵng..." })
                </div>

                <!-- GiaVe, GioMoCua -->
                <div class="col-12 col-lg-3">
                    <label class="form-label">Giá vé</label>
                    @Html.TextBoxFor(m => m.GiaVe, new { @class = "form-control", type = "number", min = "0", value = "0" })
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Giờ mở cửa</label>
                    @Html.TextBoxFor(m => m.GioMoCua, new { @class = "form-control", placeholder = "VD: 08:00 - 17:00" })
                </div>

                <!-- KinhDo / ViDo -->
                <div class="col-12 col-lg-3">
                    <label class="form-label">Kinh độ</label>
                    @Html.TextBoxFor(m => m.KinhDo, new { @class = "form-control", type = "number", step = "0.0000000001" })
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Vĩ độ</label>
                    @Html.TextBoxFor(m => m.ViDo, new { @class = "form-control", type = "number", step = "0.0000000001" })
                </div>

                <!-- DiaChiChiTiet -->
                <div class="col-12">
                    <label class="form-label">Địa chỉ chi tiết</label>
                    @Html.TextBoxFor(m => m.DiaChiChiTiet, new { @class = "form-control" })
                </div>

                <!-- SoDienThoai / Email / Website -->
                <div class="col-12 col-lg-4">
                    <label class="form-label">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                </div>

                <div class="col-12 col-lg-4">
                    <label class="form-label">Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                </div>

                <div class="col-12 col-lg-4">
                    <label class="form-label">Website</label>
                    @Html.TextBoxFor(m => m.Website, new { @class = "form-control", placeholder = "https://..." })
                </div>

                <!-- MoTaNgan / MoTaChiTiet -->
                <div class="col-12">
                    <label class="form-label">Mô tả ngắn</label>
                    @Html.TextAreaFor(m => m.MoTaNgan, new { @class = "form-control", rows = "2" })
                </div>

                <div class="col-12">
                    <label class="form-label">Mô tả chi tiết</label>
                    @Html.TextAreaFor(m => m.MoTaChiTiet, new { @class = "form-control", rows = "6" })
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label">Ảnh chính</label>
                    <input type="file" name="AnhChinhFile" id="AnhChinhFile" class="form-control" accept="image/*" />
                    

                    <div class="mt-2" id="previewMainWrap" style="display:none;">
                        <img id="previewMain" src="" alt="Preview ảnh chính"
                             style="width:100%;max-width:360px;height:200px;object-fit:cover;border-radius:12px;border:1px solid #e2e8f0;" />
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Ảnh phụ </label>
                    <input type="file" name="AnhPhuFiles" id="AnhPhuFiles" class="form-control" accept="image/*" multiple />
                    

                    <div class="mt-2 d-flex flex-wrap gap-2" id="previewSubs"></div>
                </div>

                <div class="col-12 d-flex gap-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.TrangThai, new { @class = "form-check-input" })
                        <label class="form-check-label">Hiển thị địa điểm</label>
                    </div>

                    @* Nếu DB bạn KHÔNG có LaDiemChinh thì bỏ block này *@
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.LaDiemChinh, new { @class = "form-check-input" })
                        <label class="form-check-label">Là điểm chính</label>
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Lưu
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section scripts{
    <script>
        (function () {
            function slugify(str) {
                str = (str || '').toString().toLowerCase().trim();
                if (str.normalize) str = str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                str = str.replace(/đ/g, 'd');
                str = str.replace(/[^a-z0-9\s-]/g, '');
                str = str.replace(/\s+/g, '-').replace(/-+/g, '-');
                return str;
            }

            var nameEl = document.getElementById('TenDiaDiem');
            var slugEl = document.getElementById('Slug');
            if (nameEl && slugEl) {
                nameEl.addEventListener('input', function () {
                    if (!slugEl.value) slugEl.value = slugify(nameEl.value);
                });
            }

            // Preview ảnh chính
            var mainInput = document.getElementById('AnhChinhFile');
            var previewMain = document.getElementById('previewMain');
            var previewMainWrap = document.getElementById('previewMainWrap');

            if (mainInput) {
                mainInput.addEventListener('change', function () {
                    var f = mainInput.files && mainInput.files.length ? mainInput.files[0] : null;
                    if (!f) { previewMainWrap.style.display = 'none'; return; }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        previewMain.src = e.target.result;
                        previewMainWrap.style.display = 'block';
                    };
                    reader.readAsDataURL(f);
                });
            }

            // Preview ảnh phụ
            var subsInput = document.getElementById('AnhPhuFiles');
            var previewSubs = document.getElementById('previewSubs');

            if (subsInput) {
                subsInput.addEventListener('change', function () {
                    previewSubs.innerHTML = '';
                    var files = subsInput.files || [];
                    for (var i = 0; i < files.length; i++) {
                        (function (file) {
                            var reader = new FileReader();
                            reader.onload = function (e) {
                                var img = document.createElement('img');
                                img.src = e.target.result;
                                img.style.width = '110px';
                                img.style.height = '80px';
                                img.style.objectFit = 'cover';
                                img.style.borderRadius = '10px';
                                img.style.border = '1px solid #e2e8f0';
                                previewSubs.appendChild(img);
                            };
                            reader.readAsDataURL(file);
                        })(files[i]);
                    }
                });
            }
        })();
    </script>
}