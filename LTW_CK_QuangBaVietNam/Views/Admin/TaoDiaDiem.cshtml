@using LTW_CK_QuangBaVietNam.Models
@{
    ViewBag.Title = "Thêm địa điểm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var dmList = ViewBag.DanhMucList as IEnumerable<DanhMuc>;
    if (dmList == null) { dmList = new DanhMuc[0]; }
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
        <div class="fw-semibold">
            <i class="fa-solid fa-plus text-primary me-2"></i>Thêm địa điểm
        </div>
        <a class="btn btn-outline-secondary" href="@Url.Action("DiaDiem","Admin")">
            <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @using (Html.BeginForm("TaoDiaDiem", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label class="form-label">Tên địa điểm *</label>
                    <input name="tenDiaDiem" class="form-control" required />
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Danh mục</label>
                    <select name="maDanhMuc" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var dm in dmList)
                        {
                            <option value="@dm.MaDanhMuc">@dm.TenDanhMuc</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Vùng miền</label>
                    <select name="vungMien" class="form-select">
                        <option value="">-- Chọn vùng --</option>
                        <option value="Miền Bắc">Miền Bắc</option>
                        <option value="Miền Trung">Miền Trung</option>
                        <option value="Miền Nam">Miền Nam</option>
                    </select>
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Giá vé</label>
                    <input name="giaVe" type="number" class="form-control" value="0" min="0" />
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Giờ mở cửa</label>
                    <input name="gioMoCua" class="form-control" placeholder="VD: 08:00 - 17:00" />
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Kinh độ</label>
                    <input name="kinhDo" type="number" step="0.0000000001" class="form-control" />
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">Vĩ độ</label>
                    <input name="viDo" type="number" step="0.0000000001" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Địa chỉ chi tiết</label>
                    <input name="diaChiChiTiet" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Mô tả ngắn</label>
                    <textarea name="moTaNgan" class="form-control" rows="2"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">Mô tả chi tiết</label>
                    <textarea name="moTaChiTiet" class="form-control" rows="5"></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="trangThai" value="true" checked />
                        <label class="form-check-label">Hiển thị địa điểm</label>
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Lưu
                    </button>
                </div>
            </div>
        }
    </div>
</div>