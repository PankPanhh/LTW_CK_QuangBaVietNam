@{
    ViewBag.Title = "Thống kê & báo cáo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row g-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Địa điểm xem nhiều</div>
                <div class="h5 fw-bold mb-0">Bà Nà Hills</div>
                <div class="text-muted small mt-1">120,540 lượt xem</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Địa điểm yêu thích</div>
                <div class="h5 fw-bold mb-0">Phú Quốc</div>
                <div class="text-muted small mt-1">9,120 lượt lưu</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">User hoạt động nhiều</div>
                <div class="h5 fw-bold mb-0">Nguyễn Văn A</div>
                <div class="text-muted small mt-1">45 lượt đánh giá</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Số lượng đánh giá</div>
                <div class="h5 fw-bold mb-0">1,290</div>
                <div class="text-muted small mt-1">Trong 30 ngày</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12 col-xl-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <div class="fw-semibold"><i class="fa-solid fa-chart-line text-primary me-2"></i>Top địa điểm theo lượt xem</div>
                <div class="text-muted small">Demo bảng (sau nối DB)</div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Địa điểm</th>
                            <th>Vùng</th>
                            <th class="text-end">Lượt xem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td class="fw-semibold">Bà Nà Hills</td><td>Trung</td><td class="text-end">120,540</td></tr>
                        <tr><td class="fw-semibold">Vịnh Hạ Long</td><td>Bắc</td><td class="text-end">98,221</td></tr>
                        <tr><td class="fw-semibold">Phú Quốc</td><td>Nam</td><td class="text-end">87,110</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <div class="fw-semibold"><i class="fa-solid fa-map text-success me-2"></i>Heatmap du lịch (placeholder)</div>
                <div class="text-muted small">Sau này dùng dữ liệu LuotXemDiaDiem + tọa độ</div>
            </div>
            <div class="card-body">
                <div class="ratio ratio-16x9">
                    <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=102.0%2C8.0%2C110.0%2C23.5&layer=mapnik"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>