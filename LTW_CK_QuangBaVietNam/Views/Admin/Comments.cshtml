@{
    ViewBag.Title = "Quản lý bình luận";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ── Comment Management Page ── */
    .cm-page {
        padding: 1.75rem 0.25rem;
    }

    /* Page header */
    .cm-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .cm-page-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0;
    }

        .cm-page-title i {
            color: #0ea5e9;
            font-size: 1.2rem;
        }

    .cm-page-subtitle {
        font-size: 0.82rem;
        color: #94a3b8;
        font-weight: 400;
        margin-left: 1.75rem;
        margin-top: 0.15rem;
    }

    /* Stats row */
    .cm-stats {
        display: flex;
        gap: 0.85rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .cm-stat {
        flex: 1;
        min-width: 130px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.9rem 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }

    .cm-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

        .cm-stat-icon.all {
            background: #eff6ff;
            color: #3b82f6;
        }

        .cm-stat-icon.vis {
            background: #f0fdf4;
            color: #16a34a;
        }

        .cm-stat-icon.hid {
            background: #fffbeb;
            color: #d97706;
        }

        .cm-stat-icon.del {
            background: #fef2f2;
            color: #dc2626;
        }

    .cm-stat-num {
        font-size: 1.3rem;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
    }

    .cm-stat-label {
        font-size: 0.72rem;
        color: #94a3b8;
        margin-top: 0.1rem;
    }

    /* Filter bar */
    .cm-filter-bar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.2rem;
        flex-wrap: wrap;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }

        .cm-filter-bar .cm-search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

            .cm-filter-bar .cm-search-wrap i {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 0.9rem;
                pointer-events: none;
            }

        .cm-filter-bar input,
        .cm-filter-bar select {
            height: 38px;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.85rem;
            color: #334155;
            background: #f8fafc;
            transition: border-color 0.2s, box-shadow 0.2s;
            width: 100%;
        }

        .cm-filter-bar input {
            padding: 0 0.85rem 0 2.3rem;
        }

        .cm-filter-bar select {
            padding: 0 0.85rem;
            min-width: 170px;
            flex-shrink: 0;
        }

            .cm-filter-bar input:focus,
            .cm-filter-bar select:focus {
                outline: none;
                border-color: #0ea5e9;
                box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
                background: #fff;
            }

    .cm-result-count {
        font-size: 0.8rem;
        color: #94a3b8;
        white-space: nowrap;
        margin-left: auto;
    }

    /* Card wrap */
    .cm-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    /* Table */
    .comment-table {
        margin: 0;
        font-size: 0.875rem;
        width: 100%;
        border-collapse: collapse;
    }

        .comment-table thead tr {
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
        }

        .comment-table th {
            white-space: nowrap;
            padding: 0.75rem 1rem;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            border: none;
        }

        .comment-table td {
            padding: 0.85rem 1rem;
            border: none;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: #334155;
        }

        .comment-table tbody tr:last-child td {
            border-bottom: none;
        }

        .comment-table tbody tr {
            transition: background 0.15s;
        }

            .comment-table tbody tr:hover {
                background: #f8fafc;
            }

    /* User cell */
    .cm-user {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 130px;
    }

        .cm-user img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            flex-shrink: 0;
        }

    .cm-user-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    /* Blog link */
    .cm-blog-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: #0ea5e9;
        font-weight: 500;
        text-decoration: none;
        font-size: 0.83rem;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        border: 1px solid rgba(14,165,233,0.25);
        background: rgba(14,165,233,0.05);
        transition: background 0.2s, border-color 0.2s;
        white-space: nowrap;
    }

        .cm-blog-link:hover {
            background: rgba(14,165,233,0.12);
            border-color: #0ea5e9;
            color: #0284c7;
        }

    /* Content cell */
    .cm-content-text {
        max-width: 280px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        color: #475569;
        line-height: 1.55;
    }

    .cm-reason {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.35rem;
        font-size: 0.75rem;
        color: #d97706;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 5px;
        padding: 0.15rem 0.5rem;
    }

    /* Date */
    .cm-date {
        white-space: nowrap;
        color: #64748b;
        font-size: 0.82rem;
    }

    /* Status badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.75rem;
        white-space: nowrap;
        letter-spacing: 0.02em;
    }

        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

    .status-visible {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

        .status-visible::before {
            background: #22c55e;
        }

    .status-hidden {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

        .status-hidden::before {
            background: #f59e0b;
        }

    .status-deleted {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

        .status-deleted::before {
            background: #ef4444;
        }

    /* Action buttons */
    .cm-actions {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        flex-wrap: nowrap;
    }

    .cm-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.32rem 0.7rem;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1.5px solid transparent;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.18s ease;
        text-decoration: none;
    }

    .cm-btn-warn {
        background: #fffbeb;
        color: #b45309;
        border-color: #fde68a;
    }

        .cm-btn-warn:hover {
            background: #fef3c7;
            border-color: #f59e0b;
        }

    .cm-btn-ok {
        background: #f0fdf4;
        color: #15803d;
        border-color: #bbf7d0;
    }

        .cm-btn-ok:hover {
            background: #dcfce7;
            border-color: #4ade80;
        }

    .cm-btn-del {
        background: #fef2f2;
        color: #b91c1c;
        border-color: #fecaca;
    }

        .cm-btn-del:hover {
            background: #fee2e2;
            border-color: #f87171;
        }

    /* Empty state */
    .cm-empty {
        text-align: center;
        padding: 3.5rem 1rem;
        color: #94a3b8;
    }

        .cm-empty i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 0.75rem;
            opacity: 0.4;
        }

        .cm-empty p {
            font-size: 0.9rem;
            margin: 0;
        }

    /* Modal */
    #hideCommentModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    #hideCommentModal .modal-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.1rem 1.4rem;
    }

    #hideCommentModal .modal-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        #hideCommentModal .modal-title i {
            color: #f59e0b;
        }

    #hideCommentModal .close {
        background: none;
        border: none;
        font-size: 1.25rem;
        color: #94a3b8;
        cursor: pointer;
        padding: 0;
        line-height: 1;
    }

        #hideCommentModal .close:hover {
            color: #334155;
        }

    #hideCommentModal .modal-body {
        padding: 1.4rem;
    }

        #hideCommentModal .modal-body p {
            font-size: 0.875rem;
            color: #475569;
            margin-bottom: 0.85rem;
        }

    #hideCommentModal #hideReason {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.875rem;
        color: #334155;
        background: #f8fafc;
        resize: vertical;
        padding: 0.65rem 0.85rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        width: 100%;
    }

        #hideCommentModal #hideReason:focus {
            outline: none;
            border-color: #0ea5e9;
            box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
            background: #fff;
        }

    #hideCommentModal .modal-footer {
        border-top: 1px solid #e2e8f0;
        padding: 0.9rem 1.4rem;
        gap: 0.5rem;
        display: flex;
        justify-content: flex-end;
    }

    .cm-modal-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.5rem 1.15rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: all 0.18s;
    }

        .cm-modal-btn.cancel {
            background: #f1f5f9;
            color: #475569;
            border-color: #e2e8f0;
        }

            .cm-modal-btn.cancel:hover {
                background: #e2e8f0;
            }

        .cm-modal-btn.confirm {
            background: #f59e0b;
            color: #fff;
            border-color: #f59e0b;
            box-shadow: 0 2px 8px rgba(245,158,11,0.3);
        }

            .cm-modal-btn.confirm:hover {
                background: #d97706;
                border-color: #d97706;
            }

    @@media (max-width: 768px) {
        .cm-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }

        .cm-result-count {
            display: none;
        }
    }
</style>

<div class="container-fluid cm-page">

    <!-- Page Header -->
    <div class="cm-page-header">
        <div>
            <h1 class="cm-page-title">
                <i class="bi bi-chat-left-text-fill"></i>
                Quản lý Bình luận
            </h1>
            <div class="cm-page-subtitle">Kiểm duyệt và quản lý nội dung bình luận của người dùng</div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="cm-stats" id="cmStats">
        <div class="cm-stat">
            <div class="cm-stat-icon all"><i class="bi bi-chat-dots-fill"></i></div>
            <div>
                <div class="cm-stat-num" id="statTotal">–</div>
                <div class="cm-stat-label">Tổng bình luận</div>
            </div>
        </div>
        <div class="cm-stat">
            <div class="cm-stat-icon vis"><i class="bi bi-eye-fill"></i></div>
            <div>
                <div class="cm-stat-num" id="statVisible">–</div>
                <div class="cm-stat-label">Đang hiển thị</div>
            </div>
        </div>
        <div class="cm-stat">
            <div class="cm-stat-icon hid"><i class="bi bi-eye-slash-fill"></i></div>
            <div>
                <div class="cm-stat-num" id="statHidden">–</div>
                <div class="cm-stat-label">Đã ẩn</div>
            </div>
        </div>
        <div class="cm-stat">
            <div class="cm-stat-icon del"><i class="bi bi-trash3-fill"></i></div>
            <div>
                <div class="cm-stat-num" id="statDeleted">–</div>
                <div class="cm-stat-label">Đã xoá</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="cm-filter-bar">
        <div class="cm-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="filterKeyword" placeholder="Tìm kiếm nội dung, bài viết, người dùng...">
        </div>
        <select id="filterStatus">
            <option value="all">Tất cả trạng thái</option>
            <option value="visible">Hiển thị</option>
            <option value="hidden">Đã ẩn</option>
            <option value="deleted">Đã xoá</option>
        </select>
        <span class="cm-result-count" id="resultCount"></span>
    </div>

    <!-- Table Card -->
    <div class="cm-card">
        <div class="table-responsive">
            <table class="table comment-table" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Bài viết</th>
                        <th>Nội dung</th>
                        <th>Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="commentList">
                    <!-- Render via JS -->
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal Ẩn Bình Luận -->
<div class="modal fade" id="hideCommentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-eye-slash-fill"></i>
                    Ẩn bình luận
                </h5>

            </div>
            <div class="modal-body">
                <p>Nhập lý do ẩn bình luận này (sẽ hiển thị cho tác giả):</p>
                <textarea id="hideReason" rows="3" placeholder="Ví dụ: Vi phạm tiêu chuẩn cộng đồng..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="cm-modal-btn cancel" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Đóng
                </button>
                <button type="button" class="cm-modal-btn confirm" id="btnConfirmHide">
                    <i class="bi bi-eye-slash"></i> Xác nhận Ẩn
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let comments = [];
        let currentActionId = null;

        $(document).ready(function () {
            loadComments();

            $('#btnConfirmHide').click(function () {
                const reason = $('#hideReason').val().trim();
                if (!reason) { showToast("Cảnh báo", "Vui lòng nhập lý do!", "warning"); return; }

                $.post('/Admin/HideComment', { id: currentActionId, reason: reason }, function (res) {
                    if (res.success) {
                        $('#hideCommentModal').modal('hide');
                        loadComments();
                        showToast("Thành công", "Đã ẩn bình luận.", "success");
                    } else {
                        showToast("Thất bại", res.message, "error");
                    }
                });
            });

            $('#filterKeyword, #filterStatus').on('change keyup', function () {
                renderTable();
            });
        });

        function loadComments() {
            $.get('/Admin/GetCommentsAdmin', function (res) {
                if (res.success) {
                    comments = res.data;
                    updateStats();
                    renderTable();
                } else {
                    showToast("Thất bại", res.message, "error");
                }
            });
        }

        function updateStats() {
            $('#statTotal').text(comments.length);
            $('#statVisible').text(comments.filter(c => c.status === 'visible').length);
            $('#statHidden').text(comments.filter(c => c.status === 'hidden').length);
            $('#statDeleted').text(comments.filter(c => c.status === 'deleted').length);
        }

        function renderTable() {
            let html = '';
            const keyword = $('#filterKeyword').val().toLowerCase();
            const status = $('#filterStatus').val();

            const filtered = comments.filter(c => {
                const matchKeyword = !keyword ||
                    (c.content && c.content.toLowerCase().includes(keyword)) ||
                    (c.author && c.author.toLowerCase().includes(keyword)) ||
                    (c.blogTitle && c.blogTitle.toLowerCase().includes(keyword));
                const matchStatus = status === 'all' || c.status === status;
                return matchKeyword && matchStatus;
            });

            $('#resultCount').text(filtered.length + ' kết quả');

            if (filtered.length === 0) {
                html = `<tr><td colspan="6">
                        <div class="cm-empty">
                            <i class="bi bi-chat-left-x"></i>
                            <p>Không tìm thấy bình luận nào phù hợp</p>
                        </div>
                    </td></tr>`;
                $('#commentList').html(html);
                return;
            }

            filtered.forEach(c => {
                let statusClass = c.status === 'visible' ? 'status-visible' : (c.status === 'hidden' ? 'status-hidden' : 'status-deleted');
                let statusText = c.status === 'visible' ? 'Hiển thị' : (c.status === 'hidden' ? 'Đã ẩn' : 'Đã xoá');

                let actionHtml = '<div class="cm-actions">';
                if (c.status === 'visible') {
                    actionHtml += `<button class="cm-btn cm-btn-warn" onclick="openHideModal(${c.id})"><i class="bi bi-eye-slash"></i> Ẩn</button>`;
                }
                if (c.status !== 'deleted') {
                    actionHtml += `<button class="cm-btn cm-btn-del" onclick="deleteComment(${c.id})"><i class="bi bi-trash3"></i> Xoá</button>`;
                }
                actionHtml += '</div>';

                const reasonHtml = c.reason
                    ? `<div class="cm-reason"><i class="bi bi-info-circle"></i>${c.reason}</div>`
                    : '';

                html += `
                        <tr>
                            <td>
                                <div class="cm-user">
                                    <img src="${c.authorAvatar}" alt="${c.author}" />
                                    <span class="cm-user-name">${c.author}</span>
                                </div>
                            </td>
                            <td>
                                <a class="cm-blog-link" href="/Home/DetailBlog?id=${c.blogId}" target="_blank">
                                    <i class="bi bi-file-earmark-text"></i>Bài #${c.blogId}
                                </a>
                            </td>
                            <td>
                                <div class="cm-content-text">${c.content}</div>
                                ${reasonHtml}
                            </td>
                            <td><span class="cm-date"><i class="bi bi-clock me-1"></i>${c.date}</span></td>
                            <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                            <td>${actionHtml}</td>
                        </tr>
                    `;
            });
            $('#commentList').html(html);
        }

        function openHideModal(id) {
            currentActionId = id;
            $('#hideReason').val('');
            $('#hideCommentModal').modal('show');
        }



        function deleteComment(id) {
            showConfirmModal("Xoá bình luận", "Bạn có chắc muốn xoá bình luận này?", function() {
                $.post('/Admin/DeleteCommentAdmin', { id: id }, function (res) {
                    if (res.success) {
                        loadComments();
                        showToast("Thành công", "Đã xoá bình luận.", "success");
                    } else {
                        showToast("Thất bại", res.message, "error");
                    }
                });
            }, true);
        }
    </script>
}
