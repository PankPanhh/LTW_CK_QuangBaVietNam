@using System.Linq
@using LTW_CK_QuangBaVietNam.Models
@model IEnumerable<LTW_CK_QuangBaVietNam.Models.DiaDiemRowVM>

@{
    ViewBag.Title = "Quản lý danh lam thắng cảnh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var filter = ((ViewBag.Filter ?? "all").ToString()).ToLower();
    var q = (ViewBag.Q ?? "").ToString();
    var vung = (ViewBag.Vung ?? "all").ToString();
    int? danhMuc = ViewBag.DanhMuc as int?;

    var dmList = ViewBag.DanhMucList as IEnumerable<DanhMuc>;
    if (dmList == null) { dmList = new DanhMuc[0]; }
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-3">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-3">@TempData["Success"]</div>
        }

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold">
                    <i class="fa-solid fa-location-dot text-primary me-2"></i>Quản lý danh lam thắng cảnh
                </div>
                <div class="text-muted small">Thêm/Sửa/Xoá, giá vé, giờ mở cửa, vùng miền, danh mục</div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-primary" href="@Url.Action("TaoDiaDiem","Admin")">
                    <i class="fa-solid fa-plus me-2"></i>Thêm địa điểm
                </a>
            </div>
        </div>

        <div class="mt-3 d-flex justify-content-between align-items-center">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @(filter=="all" ? "active" : "")"
                       href="@Url.Action("DiaDiem","Admin", new { filter="all", q=q, vung=vung, danhMuc=danhMuc })">Tất cả</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(filter=="showing" ? "active" : "")"
                       href="@Url.Action("DiaDiem","Admin", new { filter="showing", q=q, vung=vung, danhMuc=danhMuc })">Đang hiển thị</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(filter=="hidden" ? "active" : "")"
                       href="@Url.Action("DiaDiem","Admin", new { filter="hidden", q=q, vung=vung, danhMuc=danhMuc })">Đang ẩn</a>
                </li>
            </ul>

            <div class="d-none d-md-block">
                <small class="text-muted">Tổng: <b>@(Model == null ? 0 : Model.Count())</b> địa điểm</small>
            </div>
        </div>
    </div>

    <div class="card-body">
        @* Không có nút Lọc. Chọn select là submit ngay *@
        <form method="get" action="@Url.Action("DiaDiem","Admin")" class="row g-2">
            <input type="hidden" name="filter" value="@filter" />

            <div class="col-12 col-lg-5">
                
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input name="q" value="@q" class="form-control" placeholder="VD: Vịnh Hạ Long..." />
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <label class="form-label small text-muted">Vùng miền</label>
                <select class="form-select" name="vung" onchange="this.form.submit()">
                    <option value="all" @(vung == "all" ? "selected" : "")>Tất cả</option>
                    <option value="Bắc" @(vung == "Bắc" ? "selected" : "")>Bắc</option>
                    <option value="Trung" @(vung == "Trung" ? "selected" : "")>Trung</option>
                    <option value="Nam" @(vung == "Nam" ? "selected" : "")>Nam</option>
                </select>
            </div>

            <div class="col-6 col-lg-4">
                <label class="form-label small text-muted">Danh mục</label>
                <select class="form-select" name="danhMuc" onchange="this.form.submit()">
                    <option value="" @(danhMuc.HasValue ? "" : "selected")>Tất cả</option>
                    @foreach (var dm in dmList)
                    {
                        var selected = (danhMuc.HasValue && danhMuc.Value == dm.MaDanhMuc) ? "selected" : "";
                        <option value="@dm.MaDanhMuc" @selected>@dm.TenDanhMuc</option>
                    }
                </select>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px;">Mã</th>
                    <th>Địa điểm</th>
                    <th>Danh mục</th>
                    <th>Vùng</th>
                    <th class="text-end">Giá vé</th>
                    <th class="text-end">Trạng thái</th>
                    <th class="text-end" style="width:260px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu.</td>
                    </tr>
                }
                else
                {
                    foreach (var dd in Model)
                    {
                        <tr>
                            <td>@dd.MaDiaDiem</td>
                            <td>
                                <div class="fw-semibold">@dd.TenDiaDiem</div>
                                <div class="text-muted small">
                                    Giờ mở cửa: @(string.IsNullOrWhiteSpace(dd.GioMoCua) ? "N/A" : dd.GioMoCua)
                                </div>
                            </td>
                            <td>@dd.TenDanhMuc</td>
                            <td>@(string.IsNullOrWhiteSpace(dd.VungMien) ? "N/A" : dd.VungMien)</td>
                            <td class="text-end">@String.Format("{0:N0}", (dd.GiaVe ?? 0))</td>
                            <td class="text-end">
                                @if (dd.TrangThai)
                                {<span class="badge bg-success">Hiển thị</span> }
                                else
                                { <span class="badge bg-secondary">Ẩn</span>}
                            </td>

                            <td class="text-end">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@Url.Action("SuaDiaDiem","Admin", new { id = dd.MaDiaDiem })" title="Sửa">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@Url.Action("BanDo","Admin", new { id = dd.MaDiaDiem })" title="Bản đồ">
                                        <i class="fa-solid fa-map-location-dot"></i>
                                    </a>

                                    @using (Html.BeginForm("DoiTrangThaiDiaDiem", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@dd.MaDiaDiem" />
                                        <input type="hidden" name="filter" value="@filter" />
                                        <input type="hidden" name="q" value="@q" />
                                        <input type="hidden" name="vung" value="@vung" />
                                        <input type="hidden" name="danhMuc" value="@(danhMuc.HasValue ? danhMuc.Value.ToString() : "")" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Ẩn/Hiện">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    }

                                    @using (Html.BeginForm("XoaDiaDiem", "Admin", FormMethod.Post,
                                        new { style = "display:inline;", onsubmit = "return confirm('Xoá (ẩn) địa điểm này?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@dd.MaDiaDiem" />
                                        <input type="hidden" name="filter" value="@filter" />
                                        <input type="hidden" name="q" value="@q" />
                                        <input type="hidden" name="vung" value="@vung" />
                                        <input type="hidden" name="danhMuc" value="@(danhMuc.HasValue ? danhMuc.Value.ToString() : "")" />

                                        <button class="btn btn-sm btn-outline-danger" title="Xoá" type="submit">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


                               