@using System.Linq
@model IEnumerable<LTW_CK_QuangBaVietNam.Models.DanhGia>

@{
    ViewBag.Title = "Kiểm duyệt đánh giá";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var filter = ((ViewBag.Filter ?? "all").ToString()).ToLower();
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold">
                    <i class="fa-solid fa-star text-warning me-2"></i>Kiểm duyệt đánh giá
                </div>
                <div class="text-muted small">
                    Quản lý nhận xét từ người dùng, xoá vi phạm & khoá spammer
                </div>
            </div>

            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @(filter=="all" ? "active" : "")"
                       href="@Url.Action("DanhGia","Admin", new { filter="all" })">
                        Tất cả
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(filter=="pending" ? "active" : "")"
                       href="@Url.Action("DanhGia","Admin", new { filter="pending" })">
                        Chờ duyệt
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Người dùng</th>
                    <th>Địa điểm</th>
                    <th>Nội dung</th>
                    <th>Đánh giá</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width:220px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Chưa có đánh giá nào.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var dg in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@dg.NguoiDung.HoTen</div>
                                <div class="text-muted small">@dg.NguoiDung.Email</div>
                            </td>

                            <td>@dg.DiaDiem.TenDiaDiem</td>

                            <td style="max-width:300px;">
                                <div class="text-truncate">
                                    @dg.NoiDung
                                </div>
                            </td>

                            <td>
                                <span class="text-warning">
                                    <i class="fa-solid fa-star"></i> @dg.SoSao
                                </span>
                            </td>

                            <td>
                                @if (dg.TrangThaiKiemDuyet)
                                {
                                    <span class="badge bg-success-subtle text-success border">
                                        Đã duyệt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border">
                                        Chờ duyệt
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="btn-group">

                                    @* nút duyệt nếu chưa duyệt *@
                                    @if (!dg.TrangThaiKiemDuyet)
                                    {
                                        using (Html.BeginForm("DuyetDanhGia", "Admin", FormMethod.Post, new { style = "display:inline-block" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@dg.MaDanhGia" />
                                            <input type="hidden" name="filter" value="@filter" />

                                            <button class="btn btn-sm btn-outline-success" title="Duyệt">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        }
                                    }

                                    @* nút xoá *@
                                    @using (Html.BeginForm("XoaDanhGia", "Admin", FormMethod.Post,
                                        new
                                        {
                                            style = "display:inline-block",
                                            onsubmit = "return confirm('Xoá đánh giá này?');"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@dg.MaDanhGia" />
                                        <input type="hidden" name="filter" value="@filter" />

                                        <button class="btn btn-sm btn-outline-danger" title="Xoá">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    }

                                    @* khoá user *@
                                    @using (Html.BeginForm("KhoaNguoiDung", "Admin", FormMethod.Post,
                                        new
                                        {
                                            style = "display:inline-block",
                                            onsubmit = "return confirm('Khoá tài khoản này?');"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("userId", dg.MaNguoiDung)

                                        <button class="btn btn-sm btn-outline-dark" title="Khoá User">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>