@{
    ViewBag.Title = "Quản lý bài viết blog";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = ((ViewBag.Filter ?? "all").ToString()).ToLower(); // all | pending | published | featured
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold"><i class="fa-solid fa-pen-nib text-info me-2"></i>Quản lý bài viết blog</div>
                <div class="text-muted small">Duyệt bài trước khi đăng, xoá vi phạm, gắn nhãn nổi bật</div>
            </div>

            <ul class="nav nav-pills">
                <li class="nav-item"><a class="nav-link @(filter=="all"?"active":"")" href="@Url.Action("Blog","Admin", new { filter="all" })">Tất cả</a></li>
                <li class="nav-item"><a class="nav-link @(filter=="pending"?"active":"")" href="@Url.Action("Blog","Admin", new { filter="pending" })">Chờ duyệt</a></li>
                <li class="nav-item"><a class="nav-link @(filter=="published"?"active":"")" href="@Url.Action("Blog","Admin", new { filter="published" })">Đã đăng</a></li>
                <li class="nav-item"><a class="nav-link @(filter=="featured"?"active":"")" href="@Url.Action("Blog","Admin", new { filter="featured" })">Nổi bật</a></li>
            </ul>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tác giả</th>
                    <th>Tiêu đề</th>
                    <th>Ngày</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (filter == "all" || filter == "published")
                {
                    <tr>
                        <td><div class="fw-semibold">Nguyễn Văn A</div><div class="text-muted small">a@gmail.com</div></td>
                        <td class="fw-semibold">Hành trình Đà Nẵng 3 ngày</td>
                        <td class="text-muted">2026-05-01</td>
                        <td><span class="badge bg-success">Đã đăng</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-secondary" title="Gắn nổi bật"><i class="fa-solid fa-tag"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="fa-regular fa-trash-can"></i></button>
                            </div>
                        </td>
                    </tr>
                }

                @if (filter == "all" || filter == "pending")
                {
                    <tr>
                        <td><div class="fw-semibold">User B</div><div class="text-muted small">b@gmail.com</div></td>
                        <td class="fw-semibold">Review Phú Quốc ăn gì?</td>
                        <td class="text-muted">2026-05-01</td>
                        <td><span class="badge bg-warning">Chờ duyệt</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-success" title="Duyệt"><i class="fa-solid fa-check"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="fa-regular fa-trash-can"></i></button>
                            </div>
                        </td>
                    </tr>
                }

                @if (filter == "featured")
                {
                    <tr>
                        <td><div class="fw-semibold">Nguyễn Văn A</div><div class="text-muted small">a@gmail.com</div></td>
                        <td class="fw-semibold">Bài nổi bật tuần này</td>
                        <td class="text-muted">2026-05-01</td>
                        <td><span class="badge bg-primary">Nổi bật</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-tag"></i> Bỏ nổi bật</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>